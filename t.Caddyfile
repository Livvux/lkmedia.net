# TLS terminiert der Reverse-Proxy (Traefik/Dokploy). Caddy liefert nur statisch aus.
:8089 {
	root * /tmp/cx/site
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://lkmedia.net; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Kunden-SVGs: sandboxed ausliefern (Defense in Depth gegen Script in hochgeladenen SVGs)
	@svg path *.svg *.svgz
	header @svg >Content-Security-Policy "sandbox; default-src 'none'; style-src 'unsafe-inline'"

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# /leistungen → /leistungen.html
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
