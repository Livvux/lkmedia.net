---
import Base from './Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { blogPostUrl, blogTopics } from '../lib/blog-topics';
import { breadcrumbs, blogPosting } from '../lib/schema';
import type { SeoProps } from '../lib/seo';

interface Props { entry: CollectionEntry<'posts'>; lang: 'de' }
const { entry, lang } = Astro.props as Props;
const url = blogPostUrl(entry);
const topicId = entry.data.topic;
const topic = topicId ? blogTopics[topicId] : null;
const relatedPosts = topicId
  ? (await getCollection('posts', (p) =>
      p.data.lang === 'de' && p.data.topic === topicId && !p.data.draft && !p.data.noindex && p.id !== entry.id,
    )).sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  : [];
const blogIndex = '/blog';
const seo: SeoProps = {
  title: entry.data.title,
  description: entry.data.description,
  canonical: url,
  lang,
  ogImage: entry.data.ogImage,
  noindex: entry.data.noindex,
  type: 'article',
  publishedTime: entry.data.pubDate.toISOString(),
  modifiedTime: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  author: entry.data.author,
};
const bc = breadcrumbs([
  { name: 'Home', url: 'https://lkmedia.net/' },
  { name: 'Blog', url: `https://lkmedia.net${blogIndex}` },
  { name: entry.data.title, url: `https://lkmedia.net${url}` },
]);
const bp = blogPosting({
  title: entry.data.title,
  description: entry.data.description,
  pubDate: entry.data.pubDate,
  updatedDate: entry.data.updatedDate,
  author: entry.data.author,
  image: entry.data.ogImage,
  url: `https://lkmedia.net${url}`,
});
---
<Base seo={seo} jsonLd={[bc, bp]}>
  <article class="max-w-3xl mx-auto px-6 py-20 md:py-28 prose dark:prose-invert prose-lg prose-headings:tracking-tight prose-p:leading-[1.8] prose-a:underline-offset-4">
    <nav class="text-sm text-black/50 dark:text-white/50 mb-8 not-prose">
      <a href={blogIndex}>← Blog</a>
    </nav>
    <h1 class="text-4xl md:text-6xl font-semibold leading-[1.08] tracking-tight">{entry.data.title}</h1>
    <div class="text-sm text-black/50 dark:text-white/50 mt-4 not-prose">
      Veröffentlicht: <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toISOString().slice(0, 10)}</time>
      {entry.data.updatedDate && <>
        {' · Aktualisiert: '}<time datetime={entry.data.updatedDate.toISOString()}>{entry.data.updatedDate.toISOString().slice(0, 10)}</time>
      </>}
      {' · '}{entry.data.author}
    </div>
    <div class="mt-10 prose-tables-scroll"><slot /></div>
    <footer class="mt-20 border-t border-black/10 dark:border-white/10 pt-8 text-sm text-black/50 dark:text-white/50 not-prose">
      Geschrieben von <a href="/ueber" class="underline">{entry.data.author}</a>.
    </footer>
    {topic && (
      <aside class="not-prose mt-12 border-t border-white/15 pt-9" aria-label="Weitere Beiträge zu diesem Thema">
        <p class="eyebrow">Themenreihe</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight">{topic.title}</h2>
        <p class="mt-3 leading-relaxed text-white/60">{topic.description}</p>
        {relatedPosts.length > 0 && (
          <ul class="mt-6 space-y-3">
            {relatedPosts.map((post) => (
              <li>
                <a href={blogPostUrl(post)} class="font-medium underline decoration-white/30 underline-offset-4 hover:decoration-white">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        )}
        {topic.offer && (
          <p class="mt-6 text-sm">
            <a href={topic.offer.href} class="font-medium underline decoration-white/30 underline-offset-4 hover:decoration-white">
              {topic.offer.label} →
            </a>
          </p>
        )}
      </aside>
    )}
  </article>
</Base>
