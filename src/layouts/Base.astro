---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { organization } from '../lib/schema';
import type { SeoProps } from '../lib/seo';
import Umami from '../components/Umami.astro';
import { publicUmamiPath } from '../lib/umami';

// analytics={false} auf Seiten mit session_id in der URL (Zugangsschlüssel): kein Plausible,
// Referrer nur same-origin – sonst landet der Link bei Dritten. Nicht no-referrer: dann schickt der
// Browser bei Formular-POSTs „Origin: null“ und die CSRF-Prüfung (src/lib/csrf.ts) blockt.
// nav={false}: Startseite bringt ihre Navigation als Kacheln im Hero mit.
interface Props { seo: SeoProps; jsonLd?: unknown[]; analytics?: boolean; nav?: boolean; }
const { seo, jsonLd = [], analytics = true, nav = true } = Astro.props as Props;
const allLd = [organization(), ...jsonLd];
// Only a known indexable page with its own canonical may load Umami. Preserve analytics=false.
const publicPath = analytics && !seo.noindex ? publicUmamiPath(seo.canonical) : null;
---
<!doctype html>
<html lang={seo.lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {...seo} />
    <script type="application/ld+json" set:html={JSON.stringify(allLd)} />
    {analytics ? (
      <script defer data-domain="lkmedia.net" src="https://vx-m.vertexmods.com/js/script.js"></script>
    ) : (
      <meta name="referrer" content="same-origin" />
    )}
    {publicPath !== null && <Umami path={publicPath} />}
  </head>
  <body class="min-h-screen flex flex-col">
    {nav && <Nav lang={seo.lang} />}
    <main class="flex-1"><slot /></main>
    <Footer lang={seo.lang} />
    <script>
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
