---
import type { HomeContent } from '../../lib/home-content';
interface Props { niches: HomeContent['niches'] }
const { niches } = Astro.props;
---
<section class="niches" aria-labelledby="niches-title">
  <div class="tile list">
    <h2 id="niches-title" class="giant" data-reveal>{niches.title}</h2>
    <div class="bars">
      {niches.items.map((n, i) => (
        <details class="bar" open={i === 0} data-reveal style={`--d:${80 + i * 60}ms`}>
          <summary>
            <span>{n.title}</span>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </summary>
          <div class="panel">
            <p>{n.body}</p>
            <p class="row">
              <a class="link" href={n.href}>Mehr zu {n.title.split(' mit ')[0]}</a>
              {n.price && <span class="price">{n.price}</span>}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <a class="tile pic demo d-1" href="/docweb" data-reveal style="--d:120ms">
    <img src="/images/docweb-demo.webp" width="1440" height="900" alt="Demo-Website aus dem Paket docweb für Arztpraxen" loading="lazy" decoding="async" />
    <span class="demo-cap t-s">docweb – Websites für Arztpraxen</span>
  </a>
  <a class="tile pic demo d-2" href="/handwerk" data-reveal style="--d:200ms">
    <img src="/images/handwerkweb-demo.webp" width="1440" height="900" alt="Demo-Website aus dem Paket handwerkweb für Handwerksbetriebe" loading="lazy" decoding="async" />
    <span class="demo-cap t-s">handwerkweb – Websites fürs Handwerk</span>
  </a>
</section>

<style>
  .niches {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr 1fr;
    gap: var(--gap);
  }
  .list {
    grid-column: 1 / 7;
    grid-row: 1 / 3;
    container-type: inline-size;
    padding: 28px;
  }
  .giant {
    font-size: 17cqw;
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.8;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .bars {
    display: grid;
    gap: 6px;
  }
  .bar {
    border-radius: 6px;
    background: var(--tile-2);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 18px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    transition: background 0.18s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--tile-3);
    border-radius: 6px;
  }
  summary svg {
    transition: transform 0.2s var(--ease-out);
  }
  .bar[open] summary svg {
    transform: rotate(45deg);
  }
  .panel {
    display: grid;
    gap: 14px;
    padding: 4px 18px 20px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .price {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .demo {
    position: relative;
    grid-column: 7 / 13;
    padding: 0;
    min-height: 300px;
  }
  .d-1 {
    grid-row: 1;
  }
  .d-2 {
    grid-row: 2;
  }
  .demo img {
    object-position: top left;
  }
  .demo-cap {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 12px 18px;
    border-top-right-radius: var(--r);
    background: var(--ground);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .niches {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
    .list {
      grid-column: 1 / -1;
      grid-row: auto;
      padding: 18px;
    }
    .demo {
      grid-column: auto;
      grid-row: auto;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .demo-cap {
      position: static;
      display: block;
      border-radius: 0;
      background: var(--tile);
    }
    .demo {
      display: flex;
      flex-direction: column;
      aspect-ratio: auto;
    }
    .demo img {
      aspect-ratio: 16 / 10;
      height: auto;
    }
  }
  @media (max-width: 520px) {
    .niches {
      grid-template-columns: 1fr;
    }
  }
</style>
