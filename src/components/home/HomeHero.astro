---
import type { HomeContent } from '../../lib/home-content';
import type { Lang } from '../../lib/i18n';
interface Props { hero: HomeContent['hero']; lang: Lang }
const { hero, lang } = Astro.props;
const en = lang === 'en';
---
<header class="hero" data-project-scene>
  <div class="stage">
    <div class="wrap copy">
      <div class="pitch">
        <a class="specialty" href="#leistungen">{hero.label} <span aria-hidden="true">›</span></a>
        <h1>{hero.title} <span>{hero.quiet}</span></h1>
        <p class="intro">{hero.lede}</p>
        <div class="actions">
          <a class="primary" href={hero.primary.href}>{hero.primary.label} <span aria-hidden="true">↗</span></a>
          <a class="secondary" href={hero.secondary.href}>{hero.secondary.label} ↓</a>
        </div>
      </div>
    </div>
    <div class="horizon" aria-hidden="true"></div>
    <div class="laptop">
      <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>streamerloft.com</span></div>
      <div class="screen"><img src="/cases/streamerloft.webp" width="1200" height="750" alt={en ? 'StreamerLoft website with a preview of the WordPress creator kit' : 'StreamerLoft mit Vorschau des WordPress-Kits für Creator'} fetchpriority="high" /></div>
    </div>
  </div>
</header>
<section id="arbeit" class="case">
  <div class="wrap case-inner">
    <div><h2>StreamerLoft</h2><p>{en ? 'What will my creator website look like? An interactive preview lets visitors explore the WordPress kit before downloading it.' : 'Wie sieht meine eigene Creator-Website aus? Eine klickbare Vorschau zeigt das WordPress-Kit schon vor dem Download.'}</p></div>
    <a class="secondary" href="/cases/streamerloft" hreflang="de">{en ? 'View case study (in German)' : 'Projekt im Detail'} ↗</a>
  </div>
</section>
<script>
  const scene = document.querySelector<HTMLElement>('[data-project-scene]');
  if (scene) {
    const motion = matchMedia('(prefers-reduced-motion: no-preference) and (min-height: 520px) and (min-width: 801px)');
    const stage = scene.querySelector<HTMLElement>('.stage')!;
    let frame = 0;
    function update() {
      frame = 0;
      if (!scene || !motion.matches) return;
      const distance = scene.offsetHeight - stage.offsetHeight;
      const offset = stage.getBoundingClientRect().top - scene.getBoundingClientRect().top;
      const progress = distance > 0 ? Math.min(1, Math.max(0, offset / distance)) : 0;
      const value = progress.toFixed(3);
      if (scene.style.getPropertyValue('--p') === value) return;
      scene.style.setProperty('--p', value);
      scene.toggleAttribute('data-copy-hidden', progress >= 0.99);
    }
    function schedule() { if (!frame) frame = requestAnimationFrame(update); }
    function sync() {
      scene?.toggleAttribute('data-motion', motion.matches);
      if (!motion.matches) {
        window.removeEventListener('scroll', schedule);
        scene?.removeAttribute('data-copy-hidden');
        scene?.style.removeProperty('--p');
      }
      else window.addEventListener('scroll', schedule, { passive: true });
      schedule();
    }
    motion.addEventListener('change', sync);
    window.addEventListener('resize', schedule);
    sync();
  }
</script>
<style>
  .hero { --p:0; background:var(--bg); color:var(--fg); }
  .stage {
    position:relative; isolation:isolate; overflow:clip; perspective:1300px;
    padding-block:clamp(52px,6vw,96px) 0;
    background:radial-gradient(ellipse at 50% 82%, #273650 0%, #131a27 40%, #090a0b 76%);
  }
  .horizon {
    position:absolute; z-index:-1; pointer-events:none;
    width:160%; left:-30%; top:clamp(390px,39vw,585px); height:70%; border-radius:50% 50% 0 0;
    background:linear-gradient(180deg,#1e283a,#090a0b 42%);
    border-top:1px solid #d6e7ffb0;
    box-shadow:0 -3px 12px #a7c7ff88,0 -14px 48px #759deb66,0 -48px 100px #6c86bc38;
  }
  .copy { text-align:center; position:relative; z-index:1; }
  .specialty { display:inline-flex; align-items:center; gap:9px; color:#c2c9d5; font:500 12px/1.6 var(--font-mono); }
  .specialty::before { content:""; width:6px; height:6px; border-radius:50%; background:#bbd5ff; box-shadow:0 0 12px #96bbff77; }
  h1 { margin:22px auto; font-size:clamp(40px,6.6vw,100px); font-weight:560; line-height:1.01; letter-spacing:-.058em; }
  h1 span { display:block; color:#b8c5da; }
  .intro { max-width:52ch; margin-inline:auto; color:#c2c6cf; font-size:clamp(16px,1.4vw,21px); line-height:1.55; text-wrap:pretty; }
  .actions { display:flex; justify-content:center; flex-wrap:wrap; align-items:center; gap:10px 20px; margin-top:28px; }
  .actions a,.case a { display:inline-flex; gap:12px; align-items:center; min-height:46px; font-size:15px; font-weight:550; }
  .primary { padding:10px 21px; border-radius:99px; background:#f5f7fb; color:#151920; }
  .secondary { color:#dee6f5; }
  a:hover { text-decoration:underline; text-underline-offset:4px; }
  .laptop { position:relative; width:min(calc(100% - 40px),980px); margin:clamp(42px,5vw,78px) auto 0; border:1px solid #abb9d280; border-radius:16px 16px 0 0; overflow:hidden; background:#191d24; transform-origin:50% 0; box-shadow:0 0 0 5px #202635,0 0 0 6px #a3b4ce40,0 24px 70px #0007; }
  .window-bar { height:34px; display:flex; gap:6px; align-items:center; padding:0 14px; border-bottom:1px solid #ffffff18; }
  .window-bar i { width:9px; height:9px; border-radius:50%; background:#fa6159; }
  .window-bar i:nth-child(2) { background:#f6be4f; } .window-bar i:nth-child(3) { background:#30c654; }
  .window-bar span { margin-left:16px; font-size:12px; color:#c5c6c8; }
  .screen img { display:block; width:100%; height:auto; }
  .case { background:var(--bg); border-block:1px solid var(--border); padding-block:clamp(32px,4vw,64px); }
  .case-inner { display:flex; justify-content:space-between; align-items:center; gap:20px; }
  .case h2 { font-size:21px; font-weight:510; } .case p { max-width:55ch; margin-top:5px; color:var(--fg-muted); }
  .case a { font-size:14px; }
  @media(prefers-reduced-motion:no-preference) and (min-height:520px) and (min-width:801px) {
    .hero[data-motion] { height:calc(max(690px,100svh - 65px) + clamp(200px,35vh,350px)); }
    [data-motion] .stage { position:sticky; top:65px; height:max(690px,100svh - 65px); }
    [data-motion] .copy:not(:focus-within) { transform:translateY(calc(-60px * var(--p))); opacity:calc(1 - var(--p)); }
    [data-motion][data-copy-hidden] .copy { pointer-events:none; }
    [data-motion] .copy:focus-within { pointer-events:auto; }
    [data-motion] .laptop { transform:translateY(calc(-1 * clamp(270px,26vw,420px) * var(--p))) rotateX(calc(9deg - 9deg * var(--p))) scale(calc(1 + .035 * var(--p))); }
  }
  @media(max-width:800px) {
    .case-inner { flex-direction:column; align-items:flex-start; gap:8px; }
    .horizon { top:72%; }
    .laptop { border-radius:10px 10px 0 0; }
  }
</style>
