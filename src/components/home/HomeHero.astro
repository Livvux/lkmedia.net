---
import type { HomeContent } from '../../lib/home-content';
interface Props { hero: HomeContent['hero']; photoAlt: string }
const { hero, photoAlt } = Astro.props;
---
<header class="hero paper" aria-labelledby="hero-title">
  <div class="wrap cover">
    <div class="copy">
      <p class="studio-label">{hero.label}</p>
      <h1 id="hero-title">{hero.title} <em>{hero.quiet}</em></h1>
      <p class="intro">{hero.lede}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={hero.primary.href}>{hero.primary.label}<span aria-hidden="true">↗</span></a>
        <a class="work-link" href={hero.secondary.href}>{hero.secondary.label}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <figure>
      <div class="print"><img src="/home/lucas-1600.webp" width="1600" height="1381" alt={photoAlt} fetchpriority="high" /></div>
      <figcaption><span>lk media</span><span>{hero.caption}</span></figcaption>
    </figure>
  </div>
</header>

<style>
  .hero { background: #f3f1e7; }
  .cover { display:grid; grid-template-columns:minmax(0,1.18fr) minmax(0,1fr); align-items:center; gap:clamp(30px,5vw,80px); padding-block:clamp(42px,6vw,96px); }
  .studio-label, figcaption { font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.075em; font-size:11px; }
  .studio-label { display:flex; align-items:center; gap:12px; }
  .studio-label::before { content:''; width:26px; height:2px; background:var(--signal); }
  h1 { margin-block:clamp(26px,3.4vw,52px) 22px; font-size:clamp(48px,6.2vw,98px); font-weight:540; line-height:.97; letter-spacing:-.065em; }
  h1 em { display:block; max-width:11ch; color:#17604e; font-family:Georgia,serif; font-weight:400; letter-spacing:-.06em; line-height:1.04; }
  .intro { max-width:43ch; color:var(--fg-muted); font-size:clamp(17px,1.4vw,21px); line-height:1.55; }
  .actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 26px; margin-top:30px; }
  .actions .btn { border-radius:4px; gap:18px; }
  .work-link { display:inline-flex; align-items:center; gap:10px; min-height:44px; text-decoration:underline; text-underline-offset:5px; }
  figure { margin:0; }
  .print { background:#b8d5c4; overflow:hidden; border-radius:48% 48% 2px 2px; }
  img { display:block; width:100%; aspect-ratio:1/1.02; object-fit:cover; object-position:54% 38%; filter:grayscale(1) contrast(1.08); mix-blend-mode:multiply; }
  figcaption { display:flex; justify-content:space-between; align-items:center; gap:12px; padding-block:12px; border-bottom:1px solid var(--border-strong); }
  figcaption span:first-child { font-family:var(--font-sans); font-weight:650; font-size:20px; letter-spacing:-.075em; text-transform:none; }
  @media (max-width:760px) {
    .cover { grid-template-columns:1fr; gap:28px; }
    h1 { font-size:clamp(44px,10vw,72px); }
    h1 em { max-width:none; }
    .print { border-radius:110px 2px 2px 2px; }
    img { aspect-ratio:1.85; object-position:50% 25%; }
  }
</style>
