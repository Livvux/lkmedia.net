---
import type { HomeContent } from '../../lib/home-content';
import SoftAurora from './SoftAurora.astro';
import TiltedCard from '../reactbits/TiltedCard.tsx';
import Magnet from '../reactbits/Magnet.tsx';
import Spotlight from '../reactbits/Spotlight.tsx';
import TechText from '../reactbits/TechText.tsx';

interface Props { hero: HomeContent['hero'] }
const { hero } = Astro.props;
// Kein data-reveal und keine Opacity-Animation im Hero: er muss ohne JavaScript sofort stehen.
const claimWords = hero.claim.split(' ');
const claimAccent = claimWords.pop() ?? '';
const claimPlain = claimWords.join(' ');
// Chips neben der Vorschau: nachprüfbare Eigenschaften aus dem Leistungsversprechen.
const chips = ['Kein Cookie-Banner', 'Statisch & schnell', 'SEO von Anfang an'];
---

<header class="hero">
  <SoftAurora />
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <Spotlight client:idle className="hero-copy" size={560} intensity={0.12}>
      {hero.eyebrow && (
        <p class="hero-eyebrow"><span class="hero-pulse" aria-hidden="true"></span>{hero.eyebrow}</p>
      )}
      <h1 class="hero-title">
        <span class="hero-brand">
          <span class="hero-brand__text rb-tech-fallback">{hero.title}</span>
          <TechText
            client:idle
            className="rb-tech-text--overlay"
            text={hero.title}
            align="left"
            edgeMargin={0}
            fontSize={150}
            fontWeight={600}
            letterSpacing={-0.007}
            color="currentColor"
            accentColor="var(--accent)"
            decorative
          />
        </span>
        <span class="hero-claim">
          {claimPlain && <span class="hero-claim-plain">{claimPlain}</span>}
          {claimPlain && ' '}
          <span class="hero-claim-accent">{claimAccent}</span>
        </span>
      </h1>
      <p class="hero-sub">{hero.subtitle} · Website, SEO und Betreuung aus einer Hand</p>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-actions">
        <Magnet client:idle strength={0.26} radius={80}>
          <a class="btn btn-primary btn-lg" href={hero.primary.href}>
            {hero.primary.label}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </Magnet>
        <a class="btn btn-ghost btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </Spotlight>
  </div>

  <div class="wrap hero-stage-wrap">
    <figure class="stage">
      <TiltedCard client:idle maxTilt={4}>
        <div class="shot">
          <div class="chrome" aria-hidden="true">
            <span class="lights"><i></i><i></i><i></i></span>
            <span class="url">klavierbau-milde.de</span>
            <span></span>
          </div>
          <img
            src="/landing/shots/klavierbau-milde-1440.webp"
            srcset="/landing/shots/klavierbau-milde-1440.webp 1440w, /landing/shots/klavierbau-milde-2880.webp 2880w"
            sizes="(max-width: 1240px) 100vw, 1176px"
            width="1440"
            height="900"
            alt="Startseite von klavierbau-milde.de, gebaut von lkmedia"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </TiltedCard>

      <span class="chip chip-a" aria-hidden="true">{chips[0]}</span>
      <span class="chip chip-b" aria-hidden="true">{chips[1]}</span>
      <span class="chip chip-c" aria-hidden="true">{chips[2]}</span>

      <figcaption class="project-caption">
        <span>Klavierbau Hans Milde · Webdesign & Local SEO</span>
        <a class="mono-link" href="/cases/klavierbau-milde">Projekt ansehen →</a>
      </figcaption>
    </figure>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-top: clamp(64px, 10vw, 124px);
    overflow: hidden;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(70% 48% at 18% 8%, oklch(0.68 0.17 250 / 0.12), transparent 70%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }
  /* Die Spotlight-Wurzel wird von React gerendert und trägt keine Astro-Scope-Attribute. */
  :global(.hero-copy) {
    display: grid;
    justify-items: start;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    animation: hero-line 0.8s var(--ease-out) both;
  }
  .hero-pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 oklch(0.68 0.17 250 / 0.6);
    animation: hero-pulse 2.6s var(--ease-out) infinite;
  }
  .hero-title {
    --brand-size: clamp(44px, 8.6vw, 132px);
    /* Das Canvas leitet die Schriftgröße aus 66 % der Boxhöhe und der Tintenhöhe
       der Schrift (0,7369) ab. Der Faktor 1,116 hält die Wortmarke auf --brand-size. */
    --brand-box: calc(var(--brand-size) * 1.116);
    justify-self: stretch;
    max-width: 100%;
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-wrap: balance;
  }
  .hero-brand {
    position: relative;
    display: block;
    width: 100%;
    height: var(--brand-box);
    /* Die Box ist 19,6 % höher als die alte Zeilenhöhe – das holt der negative
       Abstand wieder heraus, damit der Claim stehen bleibt wie vorher. */
    margin-bottom: calc(var(--brand-size) * -0.196);
    color: var(--fg);
    animation: hero-line 0.95s 0.05s var(--ease-out) both;
  }
  /* Klartext bleibt im Markup: ohne JavaScript sichtbar, mit Canvas nur für Screenreader. */
  .hero-brand__text {
    display: flex;
    align-items: center;
    height: 100%;
    /* Das Canvas setzt die Glyphen bündig an den Boxrand, der Klartext hat dort
       noch den linken Rand des „l“ – der negative Versatz gleicht das aus. */
    margin-left: -0.065em;
    font-size: var(--brand-size);
    letter-spacing: -0.007em;
    line-height: 1;
    white-space: nowrap;
    transform: translateY(calc(var(--brand-size) * -0.1));
  }
  /* Sobald das Canvas gezeichnet hat, blendet die globale Regel
     (.rb-tech-fallback) den Klartext aus – er bleibt nur für Screenreader.
     Das Canvas sitzt 10 % über der Box, damit die Glyphen auf der Höhe des
     Klartexts landen. */
  :global(.hero-brand .rb-tech-text--overlay) {
    top: calc(var(--brand-size) * -0.1);
    bottom: auto;
    height: var(--brand-box);
  }
  .hero-claim {
    display: block;
    max-width: 30ch;
    margin-top: 14px;
    font-size: clamp(24px, 3.4vw, 50px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    animation: hero-line 0.95s 0.16s var(--ease-out) both;
  }
  .hero-claim-accent {
    color: var(--accent);
  }
  .hero-sub {
    margin-top: 20px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.01em;
    animation: hero-line 0.95s 0.26s var(--ease-out) both;
  }
  .hero-lead {
    max-width: 56ch;
    margin-top: 24px;
    color: var(--fg-muted);
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.65;
    text-wrap: pretty;
    animation: hero-line 0.95s 0.34s var(--ease-out) both;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
    animation: hero-line 0.95s 0.42s var(--ease-out) both;
  }

  .hero-stage-wrap {
    position: relative;
    z-index: 1;
  }
  .stage {
    position: relative;
    margin-top: clamp(48px, 7vw, 88px);
    animation: hero-line 1.1s 0.2s var(--ease-out) both;
  }
  .shot {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    background: var(--bg-card);
    box-shadow:
      0 0 0 1px #00000080,
      0 -30px 120px -40px oklch(0.68 0.17 250 / 0.35);
  }
  .shot::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
    background: #0d0d10;
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #ffffff1f;
  }
  .url {
    padding: 4px 14px;
    border-radius: 6px;
    background: #ffffff0a;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 760;
    object-fit: cover;
    object-position: top center;
  }

  .chip {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: #0c0c0ef2;
    box-shadow: 0 18px 40px -22px #000;
    backdrop-filter: blur(10px);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    white-space: nowrap;
    animation: chip-float 7s ease-in-out infinite;
  }
  .chip::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .chip-a {
    top: 14%;
    left: -22px;
  }
  .chip-b {
    top: 46%;
    right: -26px;
    animation-delay: -2.4s;
  }
  .chip-c {
    bottom: 22%;
    left: -14px;
    animation-delay: -4.6s;
  }

  .project-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  @keyframes hero-line {
    from {
      transform: translateY(22px);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-pulse {
    0% {
      box-shadow: 0 0 0 0 oklch(0.68 0.17 250 / 0.55);
    }
    70% {
      box-shadow: 0 0 0 9px oklch(0.68 0.17 250 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 oklch(0.68 0.17 250 / 0);
    }
  }
  @keyframes chip-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }
  @media (max-width: 1100px) {
    .chip {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .hero-actions .btn {
      flex: 1 1 auto;
    }
    .shot img {
      aspect-ratio: 16 / 11;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-brand,
    .hero-claim,
    .hero-sub,
    .hero-lead,
    .hero-actions,
    .stage,
    .chip {
      animation: none;
    }
    .hero-pulse {
      animation: none;
    }
  }
</style>
