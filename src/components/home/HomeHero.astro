---
import type { HomeContent } from '../../lib/home-content';
interface Props { hero: HomeContent['hero'] }
const { hero } = Astro.props;
const scores = ['Performance', 'Barrierefreiheit', 'Best Practices', 'SEO'];
// Kein data-reveal und keine Opacity-Animation im Hero: er muss ohne JavaScript sofort stehen.
---
<header class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow"><span class="dot" aria-hidden="true"></span>{hero.eyebrow}</p>
    <h1 class="hero-title">
      <span class="line">{hero.title}</span>
      <span class="line dim">{hero.subtitle}</span>
    </h1>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href={hero.primary.href}>
        {hero.primary.label}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="btn btn-ghost btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
    <ul class="hero-facts">
      {hero.facts.map((f) => <li>{f}</li>)}
    </ul>
  </div>

  <div class="wrap">
    <figure class="stage">
      <div class="shot">
        <div class="chrome" aria-hidden="true">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="url">klavierbau-milde.de</span>
          <span></span>
        </div>
        <img
          src="/landing/shots/klavierbau-milde-1440.webp"
          srcset="/landing/shots/klavierbau-milde-1440.webp 1440w, /landing/shots/klavierbau-milde-2880.webp 2880w"
          sizes="(max-width: 1240px) 100vw, 1176px"
          width="1440"
          height="900"
          alt="Startseite von klavierbau-milde.de, gebaut von lkmedia"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="float serp-card" aria-hidden="true">
        <p class="float-label">Google · Klavierstimmer Karlsruhe</p>
        <p class="serp-rank"><span>Position</span> 1–2</p>
        <p class="float-sub">Klickrate über 16 %</p>
      </div>

      <div class="float lh-card" aria-hidden="true">
        <p class="float-label">Lighthouse · mobil</p>
        <ul class="rings">
          {scores.map((s) => (
            <li>
              <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" /><circle class="arc" cx="18" cy="18" r="15.5" pathLength="100" /></svg>
              <span class="score">100</span>
              <span class="ring-name">{s}</span>
            </li>
          ))}
        </ul>
      </div>
      <figcaption class="sr-only">Lokale Sichtbarkeit von Klavierbau Hans Milde: Position 1–2 bei Google und Lighthouse 100 in allen vier Kategorien.</figcaption>
    </figure>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-top: clamp(72px, 11vw, 136px);
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0 0 30% 0;
    background-image:
      linear-gradient(90deg, #ffffff0a 1px, transparent 1px),
      linear-gradient(#ffffff0a 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
    mask-image: radial-gradient(70% 70% at 50% 0%, #000 30%, transparent 100%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    justify-items: start;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #ffffff05;
    color: var(--fg-muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .hero-title {
    margin-top: 28px;
    max-width: 20ch;
    font-size: clamp(42px, 6.2vw, 84px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }
  .line {
    display: block;
    animation: lift 0.9s var(--ease-out) both;
  }
  .line.dim {
    color: var(--fg-dim);
    animation-delay: 80ms;
  }
  .hero-lead {
    max-width: 56ch;
    margin-top: 28px;
    color: var(--fg-muted);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 40px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-facts li::before {
    content: '';
    width: 10px;
    height: 1px;
    background: currentColor;
  }

  .stage {
    position: relative;
    margin-top: clamp(56px, 8vw, 96px);
    animation: lift 1.1s 0.15s var(--ease-out) both;
  }
  .shot {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    background: var(--bg-card);
    box-shadow:
      0 0 0 1px #00000080,
      0 -30px 120px -40px oklch(0.68 0.17 250 / 0.35);
  }
  .shot::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
    background: #0d0d10;
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #ffffff1f;
  }
  .url {
    padding: 4px 14px;
    border-radius: 6px;
    background: #ffffff0a;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 760;
    object-fit: cover;
    object-position: top center;
  }

  .float {
    position: absolute;
    z-index: 1;
    padding: 16px 18px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: #111113e6;
    backdrop-filter: blur(12px);
    box-shadow: 0 24px 60px -20px #000;
    animation: lift 1s var(--ease-out) both;
  }
  .float-label {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .float-sub {
    margin-top: 2px;
    color: var(--fg-muted);
    font-size: 13px;
  }
  .serp-card {
    top: 18%;
    left: -28px;
    animation-delay: 0.45s;
  }
  .serp-rank {
    margin-top: 8px;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .serp-rank span {
    color: var(--fg-dim);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .lh-card {
    right: -28px;
    bottom: 22%;
    animation-delay: 0.6s;
  }
  .rings {
    display: grid;
    grid-template-columns: repeat(4, 56px);
    gap: 10px;
    margin-top: 12px;
  }
  .rings li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .rings svg {
    width: 44px;
    height: 44px;
    transform: rotate(-90deg);
    fill: none;
    stroke-width: 3;
  }
  .rings circle {
    stroke: #ffffff14;
  }
  .rings .arc {
    stroke: var(--ok);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    stroke-linecap: round;
    animation: fill 1.4s 0.9s var(--ease-out) forwards;
  }
  .score {
    position: absolute;
    top: 13px;
    color: var(--ok);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .ring-name {
    color: var(--fg-dim);
    font-size: 10px;
    line-height: 1.2;
    text-align: center;
  }

  @keyframes lift {
    from {
      transform: translateY(16px);
    }
    to {
      transform: none;
    }
  }
  @keyframes fill {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 1320px) {
    .serp-card {
      left: 16px;
    }
    .lh-card {
      right: 16px;
    }
  }
  @media (max-width: 760px) {
    .hero-actions .btn {
      flex: 1 1 auto;
    }
    .shot img {
      aspect-ratio: 16 / 11;
    }
    .serp-card {
      top: auto;
      bottom: 12px;
      left: 12px;
      padding: 12px 14px;
    }
    .serp-rank {
      font-size: 24px;
    }
    .lh-card {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line,
    .stage,
    .float {
      animation: none;
    }
    .rings .arc {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
