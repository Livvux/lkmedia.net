---
import type { HomeContent } from '../../lib/home-content';
interface Props { hero: HomeContent['hero'] }
const { hero } = Astro.props;
---
<header class="hero" aria-labelledby="hero-title">
  <img class="hero-image" src="/home/goldener-mann.webp" width="1200" height="1200" alt="" fetchpriority="high" decoding="async" />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-copy wrap">
    <p class="hero-kicker">{hero.eyebrow}</p>
    <h1 id="hero-title">{hero.title}<br /> <span>{hero.claim}</span></h1>
    <div class="hero-actions">
      <a href={hero.secondary.href} class="hero-contact">{hero.secondary.label} <span aria-hidden="true">↗</span></a>
      <a href={hero.primary.href} class="hero-packages">{hero.primary.label} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="hero-bottom wrap">
    <p>Webdesign <span aria-hidden="true">/</span> Entwicklung <span aria-hidden="true">/</span> SEO</p>
    <a href="#entdecken">Weiter entdecken <span aria-hidden="true">↓</span></a>
  </div>
</header>
<style>
  .hero { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: center; min-height: min(100svh, 1100px); padding-top: 110px; overflow: hidden; background: #101010; }
  .hero-image { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 48%; filter: grayscale(1) brightness(.38); }
  .hero-shade { position: absolute; z-index: 1; inset: 0; background: #09090938; }
  .hero-copy { position: relative; z-index: 2; padding-block: 110px 150px; text-align: center; }
  .hero-kicker { margin-bottom: 34px; color: #deded9; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(52px, 7.5vw, 116px); font-weight: 450; line-height: 1.05; letter-spacing: -.065em; color: #f4f3ef; }
  h1 span { color: #e2e1dc; }
  .hero-actions { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 16px 40px; margin-top: 38px; }
  .hero-packages { display: inline-flex; align-items: center; gap: 16px; min-height: 48px; font-size: 14px; color: #deded9; text-underline-offset: 6px; }
  .hero-packages:hover { text-decoration: underline; }
  .hero-contact { display: inline-flex; gap: 32px; align-items: center; min-height: 48px; padding-bottom: 6px; border-bottom: 1px solid #ffffff70; font-size: 15px; }
  .hero-contact span { font-size: 24px; transition: transform 250ms; }
  .hero-contact:hover span { transform: translate(3px,-3px); }
  .hero-bottom { position: absolute; z-index: 2; bottom: 28px; display: flex; justify-content: space-between; align-items: center; gap: 24px; left: 0; right: 0; color: #e1e0db; font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: .04em; }
  .hero-bottom p { display: flex; gap: 18px; }
  .hero-bottom a { display: inline-flex; align-items: center; min-height: 44px; gap: 20px; }
  .hero-bottom a span { font-size: 22px; }
  @media(min-width: 1600px) { .hero-copy { max-width: 1600px; } }
  @media(max-width: 600px) {
    .hero { min-height: 780px; min-height: max(720px, 100svh); padding-top: 88px; }
    .hero-copy { position: relative; z-index: 2; padding-block: 100px 170px; text-align: left; }
    .hero-actions { justify-content: flex-start; gap: 12px; }
    .hero-kicker { max-width: 24ch; margin-bottom: 30px; line-height: 1.8; }
    h1 { font-size: clamp(44px, 9.7vw, 60px); line-height: 1.12; letter-spacing: -.06em; }
    .hero-bottom { flex-wrap: wrap; gap: 4px; bottom: 22px; }
    .hero-bottom p { width: 100%; gap: 12px; font-size: 9px; }
    .hero-image { object-position: 51% center; }
  }
</style>
