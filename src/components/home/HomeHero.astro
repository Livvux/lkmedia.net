---
import type { HomeContent } from '../../lib/home-content';
import SoftAurora from './SoftAurora.astro';
interface Props { hero: HomeContent['hero'] }
const { hero } = Astro.props;
// Kein data-reveal und keine Opacity-Animation im Hero: er muss ohne JavaScript sofort stehen.
---
<header class="hero">
  <SoftAurora />
  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow"><span class="dot" aria-hidden="true"></span>{hero.eyebrow}</p>
    <h1 class="hero-title">
      <span class="line">{hero.title}</span>
    </h1>
    <p class="line dim hero-tagline">{hero.subtitle}</p>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href={hero.primary.href}>
        {hero.primary.label}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="btn btn-ghost btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
    <ul class="hero-facts">
      {hero.facts.map((f) => <li>{f}</li>)}
    </ul>
  </div>

  <div class="wrap">
    <figure class="stage">
      <div class="shot">
        <div class="chrome" aria-hidden="true">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="url">klavierbau-milde.de</span>
          <span></span>
        </div>
        <img
          src="/landing/shots/klavierbau-milde-1440.webp"
          srcset="/landing/shots/klavierbau-milde-1440.webp 1440w, /landing/shots/klavierbau-milde-2880.webp 2880w"
          sizes="(max-width: 1240px) 100vw, 1176px"
          width="1440"
          height="900"
          alt="Startseite von klavierbau-milde.de, gebaut von lkmedia"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <figcaption class="project-caption">
        <span>Klavierbau Hans Milde · Webdesign & Local SEO</span>
        <a class="mono-link" href="/cases/klavierbau-milde">Projekt ansehen →</a>
      </figcaption>
    </figure>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-top: clamp(72px, 11vw, 136px);
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #ffffff05;
    color: var(--fg-muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .hero-title {
    margin-top: 28px;
    max-width: 20ch;
    font-size: clamp(42px, 6.2vw, 84px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }
  .line {
    display: block;
    animation: lift 0.9s var(--ease-out) both;
  }
  .line.dim {
    color: var(--fg-dim);
    animation-delay: 80ms;
  }
  .hero-tagline {
    margin-top: 20px;
    max-width: 22ch;
    font-size: clamp(21px, 2.9vw, 38px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .hero-lead {
    max-width: 56ch;
    margin-top: 28px;
    color: var(--fg-muted);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 40px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-facts li::before {
    content: '';
    width: 10px;
    height: 1px;
    background: currentColor;
  }

  .stage {
    position: relative;
    z-index: 1;
    margin-top: clamp(56px, 8vw, 96px);
    animation: lift 1.1s 0.15s var(--ease-out) both;
  }
  .shot {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    background: var(--bg-card);
    box-shadow:
      0 0 0 1px #00000080,
      0 -30px 120px -40px oklch(0.68 0.17 250 / 0.35);
  }
  .shot::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
    background: #0d0d10;
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #ffffff1f;
  }
  .url {
    padding: 4px 14px;
    border-radius: 6px;
    background: #ffffff0a;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 760;
    object-fit: cover;
    object-position: top center;
  }

  .project-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: 14px;
  }
  @keyframes lift {
    from {
      transform: translateY(16px);
    }
    to {
      transform: none;
    }
  }
  @media (max-width: 760px) {
    .hero-actions .btn { flex: 1 1 auto; }
    .shot img { aspect-ratio: 16 / 11; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line,
    .stage {
      animation: none;
    }
  }
</style>
