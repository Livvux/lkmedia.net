---
import type { HomeContent } from '../../lib/home-content';
import type { Lang } from '../../lib/i18n';

interface Props { hero: HomeContent['hero']; lang: Lang }
const { hero, lang } = Astro.props;
const en = lang === 'en';
---

<header class="hero wrap">
  <div class="masthead">
    <h1>{hero.title} <span>{hero.quiet}</span></h1>
    <div class="intro">
      <p>{hero.lede}</p>
      <div class="actions">
        <a class="btn btn-primary" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="text-link" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
  </div>
  <section id="arbeit" class="project" aria-labelledby="featured-project">
    <div class="caption">
      <h2 id="featured-project">StreamerLoft</h2>
      <p>{en ? 'A WordPress kit for creators. Visitors can explore the design and schedule before downloading it.' : 'Ein WordPress-Kit für Creator. Design und Sendeplan lassen sich schon vor dem Download in der Vorschau erkunden.'}</p>
      <a class="text-link" href="/cases/streamerloft" hreflang="de">{en ? 'View case study (in German)' : 'Zur Fallstudie'}</a>
    </div>
    <div class="print">
      <img src="/cases/streamerloft.webp" width="1200" height="750" alt={en ? 'StreamerLoft homepage with a preview of the creator website' : 'StreamerLoft mit Vorschau einer Creator-Website'} fetchpriority="high" />
    </div>
  </section>
</header>

<style>
  .hero { padding-block: clamp(48px, 7.5vw, 112px) clamp(56px, 7vw, 104px); }
  .masthead, .project { display: grid; align-items: end; gap: clamp(28px, 4vw, 64px); }
  .masthead { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
  h1 { font-size: clamp(44px, 5.8vw, 88px); line-height: 1.02; letter-spacing: -.04em; font-weight: 530; }
  h1 span { display: block; color: var(--fg-muted); }
  .intro { max-width: 41ch; }
  .intro p { color: var(--fg-muted); font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55; }
  .actions { margin-top: 24px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px 22px; }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--fg-dim); }
  .text-link:hover { text-decoration-color: currentColor; }
  .project { grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); align-items: center; margin-top: clamp(48px, 6vw, 88px); padding-top: clamp(24px, 3vw, 44px); border-top: 1px solid var(--border-strong); scroll-margin-top: 78px; }
  h2 { font-size: clamp(25px, 3vw, 43px); letter-spacing: -.035em; font-weight: 510; }
  .caption p { margin: 12px 0; max-width: 34ch; line-height: 1.6; color: var(--fg-muted); }
  .print { overflow: clip; background: var(--bg-elev); }
  .print img { display: block; width: 100%; height: auto; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .print img { animation: settle linear both; animation-timeline: view(); animation-range: entry 0% cover 55%; }
      @keyframes settle { from { transform: scale(1.055); } to { transform: scale(1); } }
    }
  }
  @media (max-width: 800px) {
    .masthead { grid-template-columns: 1fr; gap: 22px; }
    .project { grid-template-columns: 1fr; gap: 18px; }
    .print { grid-row: 1; }
    .caption p { max-width: 48ch; }
  }
</style>
