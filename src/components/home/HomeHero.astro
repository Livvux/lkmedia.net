---
import type { HomeContent } from '../../lib/home-content';
interface Props { hero: HomeContent['hero'] }
const { hero } = Astro.props;
---
<header class="hero">
  <div class="wrap hero-copy">
    <p class="eyebrow">Webdesign & SEO · Rastatt · {hero.subtitle}</p>
    <h1 class="hero-title"><span class="hero-brand">{hero.title}</span><span class="hero-claim">{hero.claim}</span></h1>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href={hero.primary.href}>{hero.primary.label}<span aria-hidden="true">↗</span></a>
      <a class="hero-secondary" href={hero.secondary.href}>{hero.secondary.label}<span aria-hidden="true">→</span></a>
    </div>
  </div>
  <figure class="wrap stage">
    <a class="shot" href="/cases/klavierbau-milde">
      <div class="chrome" aria-hidden="true"><span class="lights"><i></i><i></i><i></i></span><span>klavierbau-milde.de</span><span></span></div>
      <img src="/landing/shots/klavierbau-milde-1440.webp" srcset="/landing/shots/klavierbau-milde-1440.webp 1440w, /landing/shots/klavierbau-milde-2880.webp 2880w" sizes="(max-width: 1240px) 92vw, 1176px" width="1440" height="900" alt="Startseite von Klavierbau Hans Milde mit Klavier und klar gegliederten Leistungen" fetchpriority="high" decoding="async" />
    </a>
    <figcaption><span>Klavierbau Hans Milde <span class="caption-detail">· Webdesign & Local SEO</span></span><a class="mono-link" href="/cases/klavierbau-milde">Projekt ansehen <span aria-hidden="true">→</span></a></figcaption>
  </figure>
</header>
<style>
  .hero { padding-top: clamp(64px, 8vw, 112px); }
  .hero-copy { text-align: center; }
  .hero-copy .eyebrow { color: var(--fg-muted); }
  .hero-title { margin-top: 26px; font-weight: 600; letter-spacing: -0.065em; line-height: 1; }
  .hero-brand { display: block; font-size: clamp(72px, 10vw, 144px); }
  .hero-claim { display: block; margin-top: 18px; color: var(--fg-muted); font-size: clamp(28px, 4.2vw, 60px); letter-spacing: -0.045em; line-height: 1.1; }
  .hero-lead { max-width: 64ch; margin: 28px auto 0; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.7; color: var(--fg-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px 28px; margin-top: 32px; }
  .hero-secondary { display: inline-flex; min-height: 48px; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; text-underline-offset: 5px; }
  .hero-secondary:hover { text-decoration: underline; }
  .stage { margin-top: clamp(44px, 6vw, 76px); }
  .shot { display: block; overflow: hidden; border: 1px solid var(--border-strong); border-radius: 20px; background: var(--bg-card); box-shadow: 0 28px 80px -44px #0009; }
  .chrome { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 38px; padding: 0 16px; color: var(--fg-muted); font-size: 11px; }
  .lights { display: flex; gap: 5px; }
  .lights i { width: 7px; height: 7px; border-radius: 50%; background: var(--fg-faint); }
  .shot img { width: 100%; height: auto; aspect-ratio: 1440 / 760; object-fit: cover; object-position: top; }
  figcaption { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 20px; margin-top: 14px; color: var(--fg-muted); font-size: 13px; }
  @media (max-width: 600px) { .hero-copy { text-align: left; } .hero-actions { align-items: stretch; flex-direction: column; gap: 6px; } .hero-secondary { justify-content: center; } .hero-title { margin-top: 24px; } .hero-claim { max-width: 14ch; } .shot { border-radius: 12px; } .shot img { aspect-ratio: 4 / 3; } .caption-detail { display: none; } .chrome { font-size: 10px; } }
</style>
