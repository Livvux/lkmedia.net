---
interface Props { question: string; answer: string; sources: string[]; lang: 'de' | 'en' }
const { question, answer, sources, lang } = Astro.props;
const sourcesLabel = lang === 'de' ? 'Quellen' : 'Sources';
---
<div class="chat card" aria-hidden="true">
  <div class="chat-bar">
    <span class="chat-dot"></span>
    <span class="font-mono text-[11px] text-[var(--fg-dim)]">ai search</span>
    <span class="ml-auto font-mono text-[11px] text-[var(--fg-faint)]">{lang === 'de' ? 'Beispiel' : 'Example'}</span>
  </div>
  <div class="chat-body">
    <div class="msg-user">{question}</div>
    <div class="msg-ai">
      <div class="ai-avatar">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 1.5l1.6 4.9L14.5 8l-4.9 1.6L8 14.5l-1.6-4.9L1.5 8l4.9-1.6L8 1.5z" fill="currentColor"/></svg>
      </div>
      <div>
        <p class="ai-text">{answer}<span class="caret"></span></p>
        <div class="sources">
          <span class="font-mono text-[11px] text-[var(--fg-faint)]">{sourcesLabel}</span>
          {sources.map((s, i) => (
            <span class={`source ${i === 0 ? 'is-primary' : ''}`}>
              <span class="source-n">{i + 1}</span>{s}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .chat {
    overflow: hidden;
    box-shadow: 0 40px 80px -40px #000;
  }
  .chat-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
  }
  .chat-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .chat-body {
    display: grid;
    gap: 24px;
    padding: 28px 22px 30px;
  }
  .msg-user {
    justify-self: end;
    max-width: 85%;
    padding: 12px 16px;
    border-radius: 16px 16px 4px 16px;
    background: #ffffff0f;
    font-size: 15px;
    line-height: 1.5;
  }
  .msg-ai {
    display: flex;
    gap: 14px;
  }
  .ai-avatar {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
  }
  .ai-text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-muted);
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 15px;
    margin-left: 3px;
    vertical-align: -2px;
    background: var(--fg-muted);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .source {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px 0 4px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
  }
  .source.is-primary {
    border-color: color-mix(in oklch, var(--accent) 45%, transparent);
    background: var(--accent-dim);
    color: var(--fg);
  }
  .source-n {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #ffffff14;
    font-size: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
