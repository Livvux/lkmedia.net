---
import type { HomeContent } from '../../lib/home-content';
interface Props { process: HomeContent['process'] }
const { process } = Astro.props;
---
<section id="ablauf" class="process" aria-labelledby="process-title">
  <div class="wrap">
    <div class="process-heading" data-reveal>
      <h2 id="process-title" class="section-title">{process.title}</h2>
      <p class="section-sub mt-5">{process.sub}</p>
    </div>
    <ol class="steps" data-steps style={`--n:${process.steps.length}`}>
      {process.steps.map((s, i) => (
        <li class="step" data-reveal style={`--d:${i * 90}ms;--i:${i}`}>
          <div class="step-head">
            <span class="step-n">{s.n}</span>
            <span class="step-line" aria-hidden="true"></span>
          </div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-heading { max-width: 620px; }
  .process-heading h2 { font-weight: 450; }
  .process {
    padding: clamp(48px, 6vw, 80px) 0;

  }
  .steps {
    display: grid;
    gap: 40px;
    margin-top: 64px;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  .step-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
  }
  /* --p (0–1) setzt home-motion.ts beim Scrollen; ohne JS bleibt alles sichtbar. */
  .steps { --p: 1; }
  .step { --on: clamp(0, calc(var(--p) * var(--n) - var(--i)), 1); }
  .step-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    background-image: linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-size: calc(var(--on) * 100%) 100%;
  }
  .step-n {
    --lit: min(1, calc(var(--on) * 4));
    background: color-mix(in srgb, var(--fg) calc(var(--lit) * 100%), var(--bg-card));
    color: color-mix(in srgb, var(--bg) calc(var(--lit) * 100%), var(--fg-muted));
  }
  .step-title, .step-body { opacity: clamp(.3, calc(var(--on) * 3), 1); }
  .step:last-child .step-line {
    display: none;
  }
  .step-title {
    margin-top: 20px;
    font-size: 20px;
    font-weight: 450;
    letter-spacing: -0.025em;
  }
  .step-body {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>
