---
import type { HomeContent } from '../../lib/home-content';
interface Props { process: HomeContent['process'] }
const { process } = Astro.props;
---
<section class="process">
  <div class="wrap">
    <div class="text-center max-w-2xl mx-auto" data-reveal>
      <h2 class="section-title">{process.title}</h2>
      <p class="section-sub mt-5">{process.sub}</p>
    </div>
    <ol class="steps">
      {process.steps.map((s, i) => (
        <li class="step" data-reveal style={`--d:${i * 90}ms`}>
          <div class="step-head">
            <span class="step-n">{s.n}</span>
            <span class="step-line" aria-hidden="true"></span>
          </div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    padding: 112px 0;
    border-top: 1px solid var(--border);
  }
  .steps {
    display: grid;
    gap: 40px;
    margin-top: 64px;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  .step-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
  }
  .step-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }
  .step:last-child .step-line {
    display: none;
  }
  .step-title {
    margin-top: 20px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .step-body {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>
