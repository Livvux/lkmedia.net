---
import type { HomeContent } from '../../lib/home-content';
import SectionHead from './SectionHead.astro';
interface Props { about: HomeContent['about'] }
const { about } = Astro.props;
// Kartenpunkte grob nach Längen-/Breitengrad: x = (lon − 7.95) · 600, y = (49.1 − lat) · 800
const towns = [
  { name: 'Karlsruhe', x: 270, y: 72, end: true },
  { name: 'Durmersheim', x: 192, y: 128 },
  { name: 'Baden-Baden', x: 174, y: 272 },
];
---
<section class="wrap" aria-labelledby="about-title">
  <SectionHead n="06" id="about-title" title={about.title} />
  <div class="about">
    <figure class="photo" data-reveal>
      <img src="/home/lucas-1600.webp" width="1600" height="1380" alt="Lucas Kleipoedszus lächelt am Schreibtisch, im Hintergrund ein zweiter Bildschirm mit Code" loading="lazy" decoding="async" />
    </figure>
    <div class="text" data-reveal style="--d:100ms">
      <p class="lead">{about.lead}</p>
      <p class="craft">{about.craft}</p>
      <dl class="facts">
        {about.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="map">
        <svg viewBox="0 0 320 320" role="img" aria-label="Karte: Rastatt zwischen Karlsruhe und Baden-Baden, westlich davon der Rhein">
          <path d="M40 320 C70 260 90 230 100 200 S140 130 150 110 S200 60 215 40 S228 10 232 0" fill="none" stroke="#3b82f61f" stroke-width="22" stroke-linecap="round" />
          <path d="M40 320 C70 260 90 230 100 200 S140 130 150 110 S200 60 215 40 S228 10 232 0" fill="none" stroke="#fafafa26" stroke-width="5" stroke-linecap="round" />
          <text x="62" y="250" class="river">Rhein</text>
          {towns.map((t) => (
            <g>
              <circle cx={t.x} cy={t.y} r="4" fill="#71717a" />
              <text x={t.end ? t.x : t.x + 10} y={t.end ? t.y + 22 : t.y + 4} text-anchor={t.end ? 'middle' : 'start'}>{t.name}</text>
            </g>
          ))}
          <circle class="ping" cx="156" cy="192" r="10" />
          <circle cx="156" cy="192" r="7" fill="oklch(0.68 0.17 250)" />
          <text x="172" y="197" class="here">Rastatt</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    margin-top: 48px;
    align-items: start;
  }
  .photo {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    object-position: 55% 20%;
  }
  .lead {
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .craft {
    max-width: 56ch;
    margin-top: 20px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 36px;
    border-top: 1px solid var(--border);
  }
  .facts div {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  dd {
    margin-top: 4px;
    font-weight: 500;
  }
  .map {
    max-width: 280px;
    margin-top: 32px;
  }
  .map text {
    fill: #a1a1aa;
    font-size: 13px;
  }
  .map .river {
    fill: #52525b;
    font-style: italic;
  }
  .map .here {
    fill: #fafafa;
    font-size: 15px;
    font-weight: 600;
  }
  .ping {
    fill: oklch(0.68 0.17 250 / 0.35);
    transform-origin: 156px 192px;
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.8);
      opacity: 1;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ping {
      animation: none;
    }
  }
</style>
