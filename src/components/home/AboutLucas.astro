---
import type { HomeContent } from '../../lib/home-content';
import SectionHead from './SectionHead.astro';
interface Props { about: HomeContent['about'] }
const { about } = Astro.props;
---
<section class="wrap" aria-labelledby="about-title">
  <SectionHead n="07" id="about-title" title={about.title} />
  <div class="about">
    <figure class="photo" data-reveal>
      <img src="/home/lucas-1600.webp" width="1600" height="1380" alt="Lucas Kleipoedszus lächelt am Schreibtisch, im Hintergrund ein zweiter Bildschirm mit Code" loading="lazy" decoding="async" />
      <figcaption class="photo-tag"><span class="photo-dot" aria-hidden="true"></span>Rastatt · vor Ort & remote</figcaption>
    </figure>
    <div class="text" data-reveal style="--d:100ms">
      <p class="lead">{about.lead}</p>
      <p class="craft">{about.craft}</p>
      <dl class="facts">
        {about.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <a class="mono-link about-link" href="/ueber">Mehr über Lucas <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    margin-top: 48px;
    align-items: start;
  }
  .photo {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--bg-card);
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 55% 20%;
  }
  .photo-tag {
    position: absolute;
    z-index: 2;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: #0c0c0ef2;
    backdrop-filter: blur(10px);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .photo-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .lead {
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .craft {
    max-width: 56ch;
    margin-top: 20px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 36px;
    border-top: 1px solid var(--border);
  }
  .facts div {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  dd {
    margin-top: 4px;
    font-weight: 500;
  }
  .about-link { margin-top: 28px; }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
