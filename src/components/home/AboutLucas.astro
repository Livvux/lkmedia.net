---
import type { HomeContent } from '../../lib/home-content';
interface Props { about: HomeContent['about'] }
const { about } = Astro.props;
---
<section class="about wrap" aria-labelledby="about-title">
  <figure class="photo" data-reveal>
    <img src="/home/lucas-1600.webp" width="1600" height="1380" alt={about.photoAlt} loading="lazy" decoding="async" />
  </figure>
  <div class="text" data-reveal style="--d:60ms">
    <p class="label">{about.label}</p>
    <h2 id="about-title" class="section-title">{about.title} <span class="quiet">{about.quiet}</span></h2>
    <p class="lead">{about.lead}</p>
    <p class="body">{about.body}</p>
    <dl class="facts">
      {about.facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
    <a class="mono-link about-link" href={about.link.href} hreflang={about.link.hreflang}>{about.link.label} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-block: var(--section-space);
  }
  .photo { overflow: hidden; margin: 0; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-card); }
  .photo img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 55% 20%; filter: grayscale(1); }
  .section-title { margin-top: 20px; }
  .lead { margin-top: 28px; max-width: 40ch; font-size: clamp(20px, 1.9vw, 26px); line-height: 1.45; letter-spacing: -0.02em; }
  .body { margin-top: 16px; max-width: 56ch; color: var(--fg-muted); line-height: 1.65; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 32px; border-top: 1px solid var(--border); }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--border); }
  dt { color: var(--fg-dim); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
  dd { margin-top: 4px; font-weight: 500; }
  .about-link { margin-top: 24px; min-height: 44px; }
  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; }
    .photo { max-width: 420px; }
  }
</style>
