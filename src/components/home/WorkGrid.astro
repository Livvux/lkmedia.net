---
import { getCollection } from 'astro:content';
import type { HomeContent } from '../../lib/home-content';
import { routeFor } from '../../lib/i18n';
import SectionHead from './SectionHead.astro';
interface Props { proof: HomeContent['proof'] }
const { proof } = Astro.props;

// Neueste Cases zuerst; bei gleichem Datum gilt die Reihenfolge aus home-content (sort ist stabil).
const dates = new Map((await getCollection('cases')).map((c) => [c.id, c.data.pubDate]));
const shots = proof.shots
  .filter((s) => dates.has(s.slug))
  .sort((a, b) => +(dates.get(b.slug) ?? 0) - +(dates.get(a.slug) ?? 0));
const featured = ['streamerloft', 'eichhoernchenberger']
  .flatMap((slug) => shots.filter((shot) => shot.slug === slug));
const more = shots.filter((shot) => !featured.includes(shot));
const src = (s: (typeof shots)[number]) => s.image ?? `/landing/shots/${s.slug}-1440.webp`;
// Case-Seiten gibt es nur auf Deutsch; englische Links sind markiert.
const hreflang = proof.langNote ? 'de' : undefined;
---
<section id="arbeiten" class="work paper" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead id="work-title" label={proof.label} title={proof.title} quiet={proof.quiet} link={{ ...proof.all, hreflang }} />
    <ul class="grid">
      {featured.map((shot, i) => (
        <li class="cell big" data-reveal style={`--d:${(i % 3) * 60}ms`}>
          <a class="tile" href={`${routeFor('cases', 'de')}/${shot.slug}`} hreflang={hreflang}>
            <span class="frame">
              <img src={src(shot)} width="1440" height="900" alt="" loading="lazy" decoding="async" />
            </span>
            <span class="meta">
              <span class="client">{shot.client}{proof.langNote && <span class="lang-note"> {proof.langNote}</span>}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </span>
            <span class="scope">{shot.scope}</span>
          </a>
          <dl class="story">
            {[shot.problem, shot.solution, shot.deliverable].map((text, j) => (
              <div class:list={{ done: j === 2 }}>
                <dt>{proof.steps[j]}</dt>
                <dd>{text}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
    <details class="archive">
      <summary>{proof.langNote ? 'More projects' : 'Weitere Projekte'} ({more.length})</summary>
      <ul>{more.map((shot) => <li><a href={`/cases/${shot.slug}`} hreflang={hreflang}><strong>{shot.client}</strong><span>{shot.scope} {proof.langNote}</span><b aria-hidden="true">↗</b></a></li>)}</ul>
    </details>
  </div>
</section>

<style>
  .archive { margin-top:32px; border-block:1px solid var(--border-strong); }
  summary { width:100%; padding-block:16px; cursor:pointer; font-weight:550; }
  .archive a { display:grid; grid-template-columns:1fr 2fr auto; gap:12px; align-items:baseline; padding-block:12px; border-top:1px solid var(--border); }
  .archive a:hover strong { text-decoration:underline; }
  .archive a span { color:var(--fg-muted); }
  @media(max-width:600px) { .archive a { grid-template-columns:1fr auto; } .archive a span { grid-column:1; } .archive a b { grid-column:2; grid-row:1 / 3; } }
  .work { background:var(--bg); padding-block:clamp(48px,6vw,92px); }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 28px;
    margin-top: clamp(48px, 6vw, 72px);
  }
  .tile { display: grid; gap: 6px; }
  .frame {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin-bottom: 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: clamp(10px, 1.8vw, 26px);
    background: var(--bg-card);
    transition: border-color 150ms ease-out;
  }
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    box-shadow:0 8px 18px #213c2924;
    transition: transform 400ms var(--ease-out);
  }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .client { font-size: 19px; font-weight: 500; letter-spacing: -0.02em; }
  .big .client { font-size: clamp(24px, 2.6vw, 36px); letter-spacing: -0.035em; }
  .lang-note { color: var(--fg-dim); font-size: 13px; font-weight: 400; letter-spacing: 0; }
  .arrow { color: var(--fg-dim); transition: transform 150ms var(--ease-out), color 150ms ease-out; }
  .scope { color: var(--fg-dim); font-family: var(--font-mono); font-size: 12px; }
  .story {
    display: grid;
    margin-top: 16px;
    border-top: 1px solid var(--border);
  }
  .story div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
  }
  dt { color: var(--fg-dim); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; padding-top: 3px; }
  dd { color: var(--fg-muted); font-size: 14px; line-height: 1.5; }
  .done dt { color: var(--signal); }
  .done dd { color: var(--fg); }
  .big .story dd { font-size: 15px; }
  .tile:hover .frame, .tile:focus-visible .frame { border-color: var(--border-strong); }
  .tile:hover .arrow { color: var(--signal); transform: translate(2px, -2px); }
  @media (hover: hover) {
    .tile:hover img { transform: scale(1.02); }
  }
  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 20px; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .story div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
