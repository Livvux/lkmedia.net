---
// Abschnittskopf der Startseite: Mono-Label, zweistufige Überschrift, optional Text und Link.
interface Props {
  id: string;
  label: string;
  title: string;
  quiet?: string;
  sub?: string;
  link?: { label: string; href: string; hreflang?: string };
}
const { id, label, title, quiet, sub, link } = Astro.props;
---
<div class="head" data-reveal>
  <p class="label">{label}</p>
  <h2 id={id} class="section-title">{title}{quiet && <> <span class="quiet">{quiet}</span></>}</h2>
  {sub && <p class="sub">{sub}</p>}
  {link && <a class="mono-link more" href={link.href} hreflang={link.hreflang}>{link.label} <span aria-hidden="true">→</span></a>}
</div>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 20px 48px;
  }
  .label { grid-column: 1 / -1; }
  h2 { max-width: 20ch; }
  .sub {
    grid-column: 1;
    max-width: 56ch;
    color: var(--fg-muted);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.65;
  }
  .more {
    grid-column: 2;
    grid-row: 2;
    min-height: 44px;
    white-space: nowrap;
  }
  .more span { transition: transform 150ms var(--ease-out); }
  .more:hover span { transform: translateX(3px); }
  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; }
    .more { grid-column: 1; grid-row: auto; }
  }
</style>
