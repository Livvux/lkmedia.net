---
import type { Lang } from '../../lib/i18n';
import { homeContent } from '../../lib/home-content';
import BoardHero from './BoardHero.astro';
import WorkWall from './WorkWall.astro';
import StatTiles from './StatTiles.astro';
import SearchPreview from './SearchPreview.astro';
import NicheBars from './NicheBars.astro';
import ProcessFields from './ProcessFields.astro';
import AboutLucas from './AboutLucas.astro';
import BoardClose from './BoardClose.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeContent[lang];
---
<div class="board">
  <BoardHero hero={c.hero} />
  <WorkWall proof={c.proof} />
  <StatTiles stats={c.stats} />
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => <span>{c.marquee}&nbsp;{c.marquee}&nbsp;</span>)}
    </div>
  </div>
  <SearchPreview search={c.search} />
  <section class="tile" aria-labelledby="offer-models">
    <h2 id="offer-models" class="t-l">Zwei Wege zu Ihrer Website.</h2>
    <div class="grid md:grid-cols-2 gap-8 mt-6">
      <div><h3 class="text-xl">Branchenpaket zum Festpreis</h3><p class="mt-3">Für Arztpraxen, Fahrschulen und SHK- oder Elektrobetriebe. Bewährte Seitenstruktur, definierte Funktionen und laufende Betreuung. Einrichtung ab 1.490 € plus Monatspreis, inkl. USt., 12 Monate Mindestlaufzeit und zusätzliche Domainkosten laut Angebot.</p><a class="link inline-block mt-4" href="/leistungen">Pakete und Gesamtkosten vergleichen →</a></div>
      <div><h3 class="text-xl">Individuelle Website ab 25.000 €</h3><p class="mt-3">Für umfangreiche Kanzlei-, Klinik- und Immobilienprojekte. Konzept, Design und Entwicklung richten sich nach Ihren Anforderungen. Schnittstellen, Inhalte und Betreuung werden im Angebot festgelegt.</p><a class="link inline-block mt-4" href="/kontakt">Individuelles Projekt besprechen →</a></div>
    </div>
  </section>
  <NicheBars niches={c.niches} />
  <ProcessFields process={c.process} />
  <AboutLucas about={c.about} />
  <BoardClose cta={c.cta} />
</div>

<style is:global>
  /* Startseite: ein Kachelbrett. Fünf Schriftstufen, ein Radius, 8px-Fugen. */
  .board {
    --ground: #09090b;
    --tile: #141417;
    --tile-2: #222226;
    --tile-3: #34343a;
    --paper: #fafafa;
    --ink: #fafafa;
    --ink-dark: #09090b;
    --soft: #a1a1aa;
    --soft-dark: #52525b;
    --accent: oklch(0.68 0.17 250);
    --gap: 8px;
    --edge: 10px;
    --r: 8px;
    --t-xxl: clamp(84px, 14.4vw, 220px);
    --t-xl: clamp(56px, 6vw, 96px);
    --t-l: clamp(26px, 2.5vw, 36px);
    --t-m: 17px;
    --t-s: 15px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding: var(--edge);
    background: var(--ground);
    font-size: var(--t-m);
    line-height: 1.5;
  }
  .board h2,
  .board h3 {
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }
  :where(.board) .tile {
    border-radius: var(--r);
    background: var(--tile);
    padding: 22px;
    overflow: hidden;
  }
  :where(.board) .t-l {
    font-size: var(--t-l);
  }
  :where(.board) .t-s {
    font-size: var(--t-s);
  }
  :where(.board) .soft {
    color: var(--soft);
  }
  .board .link {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    transition: color 0.18s ease;
  }
  .board .link:hover {
    color: var(--accent);
  }
  .board .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--ink-dark);
    color: var(--paper);
    font-size: var(--t-s);
    font-weight: 600;
    white-space: nowrap;
    transition:
      transform 0.14s var(--ease-out),
      background 0.18s ease;
  }
  .board .pill:hover {
    background: #26262b;
  }
  .board .pill:active {
    transform: scale(0.97);
  }
  .board img,
  .board video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .board .pic {
    overflow: hidden;
  }
  .board .pic img,
  .board .pic video {
    transition: transform 0.7s var(--ease-out);
  }
  .board .pic:hover img,
  .board .pic:hover video {
    transform: scale(1.04);
  }
  .marquee {
    overflow: hidden;
    border-radius: var(--r);
    background: var(--accent);
    color: var(--ink-dark);
    padding: 18px 0 26px;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-run 40s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee-track span {
    font-size: var(--t-xxl);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    white-space: nowrap;
  }
  @keyframes marquee-run {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 760px) {
    .board {
      --gap: 6px;
      --edge: 6px;
    }
    :where(.board) .tile {
      padding: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .board .pic img,
    .board .pic video {
      transition: none;
    }
  }
</style>
