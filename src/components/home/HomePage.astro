---
import { getCollection } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import { homeContent } from '../../lib/home-content';
import HomeHero from './HomeHero.astro';
import TrustMarquee from './TrustMarquee.astro';
import MetricBand from './MetricBand.astro';
import SectionHead from './SectionHead.astro';
import OfferTabs from './OfferTabs';
import WorkGrid from './WorkGrid.astro';
import ExpectGrid from './ExpectGrid.astro';
import SearchPreview from './SearchPreview.astro';
import ProcessFlow from '../reactbits/ProcessFlow.tsx';
import LatestPosts from './LatestPosts.astro';
import AboutLucas from './AboutLucas.astro';
import FinalCta from './FinalCta.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeContent[lang];

// Kennzahlen aus den echten Inhalten, nicht aus Marketingzahlen.
const cases = await getCollection('cases');
const articles = await getCollection(
  'posts',
  (p) => p.data.lang === 'de' && !p.data.draft && !p.data.noindex,
);
const metrics = [
  { value: new Date().getFullYear() - 2015, caption: c.metrics.items[0].caption },
  { value: cases.length, caption: c.metrics.items[1].caption },
  { value: articles.length, caption: c.metrics.items[2].caption },
];
---

<div class="home">
  <HomeHero hero={c.hero} />

  <TrustMarquee label={c.marquee.label} items={c.marquee.items} />

  <MetricBand title={c.metrics.title} figures={metrics} />

  <section class="wrap" aria-labelledby="offer-models">
    <SectionHead n="01" id="offer-models" title={c.offers.title} sub={c.offers.sub} />
    <OfferTabs tabs={c.offers.tabs} client:visible />
  </section>

  <WorkGrid proof={c.proof} />

  <ExpectGrid stats={c.stats} />

  <SearchPreview search={c.search} />

  <section class="wrap" aria-labelledby="seo-rastatt">
    <div class="seo" data-reveal>
      <span class="seo-n" aria-hidden="true">05</span>
      <h2 id="seo-rastatt" class="seo-title">Suchmaschinenoptimierung aus Rastatt.</h2>
      <div class="seo-body">
        <p>Ihre Website bekommt kaum passende Besucher oder Anfragen? Ich prüfe Suchdaten, Leistungsseiten und technische Hindernisse und setze die vereinbarten Verbesserungen direkt um. Das ist auch für bestehende Websites anderer Anbieter möglich.</p>
        <p>Im kostenlosen Erstgespräch klären wir Ihre wichtigsten Leistungen und Ihr Einzugsgebiet. Analyse, Umsetzung und eine mögliche weitere Betreuung werden anschließend separat angeboten.</p>
        <a class="mono-link" href="/seo-rastatt">SEO für Ihre bestehende Website ansehen →</a>
      </div>
    </div>
  </section>

  <ProcessFlow
    client:visible
    id="ablauf"
    title={c.process.title}
    sub={c.process.sub}
    steps={c.process.steps}
  />

  <LatestPosts journal={c.journal} />
  <AboutLucas about={c.about} />
  <FinalCta cta={c.cta} />
</div>

<style>
  /* Startseite: ein Raster, Haarlinien statt Flächen, Farbe nur als Akzent. */
  .home {
    display: flex;
    flex-direction: column;
    gap: clamp(96px, 12vw, 160px);
  }
  .seo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px 48px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elev);
    overflow: hidden;
  }
  .seo::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(60% 90% at 12% 0%, oklch(0.68 0.17 250 / 0.1), transparent 70%);
  }
  .seo-n {
    position: absolute;
    top: clamp(28px, 4vw, 48px);
    right: clamp(28px, 4vw, 48px);
    display: inline-grid;
    place-items: center;
    min-width: 30px;
    height: 22px;
    padding: 0 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .seo-title {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .seo-body {
    display: grid;
    gap: 16px;
    justify-items: start;
    color: var(--fg-muted);
    line-height: 1.65;
  }
  @media (max-width: 900px) {
    .seo {
      grid-template-columns: 1fr;
    }

    .seo-n {
      display: none;
    }
  }
</style>
