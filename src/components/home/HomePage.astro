---
import type { Lang } from '../../lib/i18n';
import { homeContent } from '../../lib/home-content';
import HomeHero from './HomeHero.astro';
import WorkGrid from './WorkGrid.astro';
import SectionHead from './SectionHead.astro';
import OfferTabs from './OfferTabs';
import SearchPreview from './SearchPreview.astro';
import LatestPosts from './LatestPosts.astro';
import AboutLucas from './AboutLucas.astro';
import FinalCta from './FinalCta.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeContent[lang];
---
<div class="home">
  <HomeHero hero={c.hero} />

  <section class="wrap" aria-label={c.stats.title}>
    <dl class="stats">
      {c.stats.figures.map((f, i) => (
        <div data-reveal style={`--d:${i * 70}ms`}>
          <dt class="stat-caption">{f.caption}</dt>
          <dd class="stat-value">{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <WorkGrid proof={c.proof} />

  <section class="wrap" aria-labelledby="offer-models">
    <SectionHead n="02" id="offer-models" title={c.offers.title} sub={c.offers.sub} />
    <OfferTabs tabs={c.offers.tabs} client:visible />
  </section>

  <SearchPreview search={c.search} />

  <section class="wrap" aria-labelledby="seo-rastatt">
    <div class="seo" data-reveal>
      <h2 id="seo-rastatt" class="seo-title">Suchmaschinenoptimierung aus Rastatt.</h2>
      <div class="seo-body">
        <p>Sie möchten wissen, warum Ihre bestehende Website kaum passende Anfragen erhält? Im Erstgespräch klären wir Zielgruppe, Angebot und die verfügbaren Suchdaten. Daraus lässt sich entscheiden, ob technische SEO, bessere Leistungsseiten oder eine klarere Nutzerführung zuerst sinnvoll sind.</p>
        <p>Für eine Einschätzung helfen Ihre Website-Adresse, die wichtigsten Leistungen, Ihr Einzugsgebiet und bisherige Anfragen. Umfang und Kosten einer möglichen Zusammenarbeit vereinbaren wir im Angebot. Bestimmte Rankings, KI-Erwähnungen oder Umsätze können wir nicht zusagen.</p>
        <a class="mono-link" href="/kontakt#termin">SEO-Erstgespräch vereinbaren →</a>
      </div>
    </div>
  </section>

  <section id="ablauf" class="wrap" aria-labelledby="process-title">
    <SectionHead n="04" id="process-title" title={c.process.title} sub={c.process.sub} />
    <ol class="steps">
      {c.process.steps.map((s, i) => (
        <li data-reveal style={`--d:${i * 80}ms`}>
          <span class="step-n">{s.n}</span>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <LatestPosts journal={c.journal} />
  <AboutLucas about={c.about} />
  <FinalCta cta={c.cta} />
</div>

<style>
  /* Startseite: ein Raster, Haarlinien statt Flächen, Farbe nur als Akzent. */
  .home {
    display: flex;
    flex-direction: column;
    gap: clamp(96px, 12vw, 160px);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 28px 28px 0 0;
  }
  .stats > div + div {
    padding-left: 28px;
    border-left: 1px solid var(--border);
  }
  .stat-value {
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-caption {
    max-width: 30ch;
    color: var(--fg-dim);
    font-size: 14px;
    line-height: 1.5;
  }
  .seo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px 48px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elev);
  }
  .seo-title {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .seo-body {
    display: grid;
    gap: 16px;
    justify-items: start;
    color: var(--fg-muted);
    line-height: 1.65;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }
  .steps li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--border-strong);
  }
  .step-n {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .step-title {
    font-size: 19px;
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .step-body {
    color: var(--fg-muted);
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stats > div,
    .stats > div + div {
      padding: 24px 0;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .seo {
      grid-template-columns: 1fr;
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
