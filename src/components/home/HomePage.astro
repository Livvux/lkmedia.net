---
import { getCollection } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import { homeContent } from '../../lib/home-content';
import BriefToDraft from '../showcase/BriefToDraft';
import HomeHero from './HomeHero.astro';
import ServiceIndex from './ServiceIndex.astro';
import SectionHead from './SectionHead.astro';
import WorkGrid from './WorkGrid.astro';
import WhyList from './WhyList.astro';
import ProcessSteps from './ProcessSteps.astro';
import LatestPosts from './LatestPosts.astro';
import AboutLucas from './AboutLucas.astro';
import HomeClose from './HomeClose.astro';
import '../../styles/home-motion.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeContent[lang];

// Kennzahlen aus den echten Inhalten: Jahre seit 2015, veröffentlichte Cases, Artikel.
const cases = await getCollection('cases');
const articles = await getCollection(
  'posts',
  (p) => p.data.lang === 'de' && !p.data.draft && !p.data.noindex,
);
const figures = [new Date().getFullYear() - 2015, cases.length, articles.length];
---

<div class="home">
  <HomeHero hero={c.hero} />
  <ServiceIndex services={c.services} />

  <section class="paper showcase" aria-labelledby="showcase-title">
    <div class="wrap">
      <div class="showcase-head">
        <SectionHead id="showcase-title" label={c.showcase.label} title={c.showcase.title} quiet={c.showcase.quiet} />
        <div class="showcase-text" data-reveal>
          {c.showcase.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="showcase-stage">
        <BriefToDraft lang={lang} client:visible />
      </div>
      <p class="showcase-evidence"><span class="label">{lang === 'en' ? 'Evidence' : 'Beleg'}</span>{c.showcase.evidence}</p>
    </div>
  </section>

  <WorkGrid proof={c.proof} />

  <div class="paper">
    <WhyList why={c.why} figures={figures} figuresLabel={lang === 'en' ? 'Facts from this website' : 'Zahlen aus dieser Website'} />
  </div>

  <div class="process-band">
    <ProcessSteps process={c.process} />
  </div>

  <div class="paper">
    {c.journal && <LatestPosts journal={c.journal} />}
    <AboutLucas about={c.about} />
  </div>

  <HomeClose cta={c.cta} />
</div>

<script>
  import '../../scripts/home-motion';
</script>

<style>
  .showcase { padding-block: var(--section-space); }
  .showcase-head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 32px clamp(40px, 6vw, 96px);
  }
  .showcase-text { display: grid; gap: 14px; max-width: 48ch; color: var(--fg-muted); font-size: 17px; line-height: 1.6; }
  .showcase-stage { margin-top: clamp(40px, 5vw, 64px); }
  .showcase-evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 15px;
  }
  .process-band { padding-block: calc(var(--section-space) - 48px); }
  @media (max-width: 900px) {
    .showcase-head { grid-template-columns: 1fr; }
  }
</style>
