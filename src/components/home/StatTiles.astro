---
import type { HomeContent } from '../../lib/home-content';
interface Props { stats: HomeContent['stats'] }
const { stats } = Astro.props;
const [a, b, c] = stats.figures;
---
<section class="stats" aria-labelledby="stats-title">
  <div class="tile fig f-a" data-reveal>
    <p class="value">{a.value}</p>
    <p class="cap">{a.caption}</p>
  </div>
  <h2 id="stats-title" class="t-l stats-title" data-reveal style="--d:80ms">{stats.title}</h2>
  <div class="tile fig f-b" data-reveal style="--d:160ms">
    <p class="value">{b.value}</p>
    <p class="cap">{b.caption}</p>
  </div>
  <div class="tile fig f-c" data-reveal style="--d:240ms">
    <p class="value">{c.value}</p>
    <p class="cap">{c.caption}</p>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 14vh 12vh 32vh 12vh;
    gap: var(--gap);
    min-height: 560px;
  }
  .fig {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
  }
  .value {
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .cap {
    max-width: 34ch;
    font-size: var(--t-m);
    line-height: 1.4;
  }
  .f-a {
    grid-column: 1 / 7;
    grid-row: 1 / 5;
    background: var(--accent);
    color: var(--ink-dark);
  }
  .stats-title {
    grid-column: 7 / 13;
    grid-row: 1;
    align-self: center;
    padding-left: 8px;
  }
  .f-b {
    grid-column: 7 / 10;
    grid-row: 2 / 4;
    background: var(--paper);
    color: var(--ink-dark);
  }
  .f-c {
    grid-column: 10 / 13;
    grid-row: 3 / 4;
    background: var(--tile-3);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      min-height: 0;
    }
    .stats-title {
      grid-column: 1 / -1;
      grid-row: 1;
      padding: 18px 4px 6px;
    }
    .f-a {
      grid-column: 1 / -1;
      grid-row: 2;
      min-height: 56vw;
    }
    .value {
      font-size: 11vw;
    }
    .f-a .value {
      font-size: 15vw;
    }
    .f-b,
    .f-c {
      grid-row: 3;
      grid-column: auto;
      padding: 18px;
    }
    .f-c {
      margin-top: 32px;
    }
    .cap {
      font-size: var(--t-s);
    }
  }
</style>
