---
import type { HomeContent } from '../../lib/home-content';
import SectionHead from './SectionHead.astro';
interface Props { search: HomeContent['search'] }
const { search } = Astro.props;
const d = search.defaults;
// Ohne JavaScript bleibt das echte Beispiel stehen: Klavierbau Hans Milde, Karlsruhe.
---
<section class="wrap" aria-labelledby="search-title" data-search>
  <SectionHead n="04" id="search-title" title={search.title} sub={search.sub} />
  <div class="search">
  <form class="panel ask" data-reveal>
    <label>
      <span class="lbl">Ihre Leistung</span>
      <input name="service" value={d.service} autocomplete="off" maxlength="40" />
    </label>
    <label>
      <span class="lbl">Ihr Ort</span>
      <input name="place" value={d.place} autocomplete="address-level2" maxlength="40" />
    </label>
    <label>
      <span class="lbl">Ihr Betrieb</span>
      <input name="business" value={d.business} autocomplete="organization" maxlength="50" />
    </label>
    <p class="note">{search.note}</p>
  </form>

  <div class="panel result-tile" data-reveal style="--d:120ms">
    <p class="where">Google – Layoutbeispiel</p>
    <article class="serp" data-ui aria-live="polite">
      <p class="q">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <span><span data-out="service">{d.service}</span> <span data-out="place">{d.place}</span></span>
      </p>
      <div class="hit">
        <span class="fav" data-out="initials" aria-hidden="true">KH</span>
        <span>
          <span class="biz" data-out="business">{d.business}</span>
          <span class="url">https://<span data-out="domain">{d.domain}</span></span>
        </span>
      </div>
      <p class="title"><span data-out="service">{d.service}</span> in <span data-out="place">{d.place}</span> | <span data-out="business">{d.business}</span></p>
      <p class="snip"><span data-out="service">{d.service}</span> in <span data-out="place">{d.place}</span> und Umgebung. Termin direkt online anfragen oder anrufen.</p>
    </article>
  </div>

  <div class="panel ai-tile" data-reveal style="--d:200ms">
    <p class="where">KI-Antwort – Textbeispiel</p>
    <div class="ai" data-ui>
      <p class="bubble">Wer ist ein guter <span data-out="service">{d.service}</span> in <span data-out="place">{d.place}</span>?</p>
      <p class="answer"><strong data-out="business">{d.business}</strong> kann auf der eigenen Website erklären, welche Leistungen als <span data-out="service">{d.service}</span> in <span data-out="place">{d.place}</span> angeboten werden und wie Interessenten Kontakt aufnehmen.</p>
      <p class="sources"><span data-out="domain">{d.domain}</span></p>
      <p class="note">Illustration, keine Live-Suche oder nachgewiesene KI-Empfehlung.</p>
    </div>
  </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-search]');
  const defaults = { business: root?.querySelector<HTMLInputElement>('[name=business]')?.defaultValue, domain: root?.querySelector('[data-out=domain]')?.textContent };
  const form = root?.querySelector('form');
  if (root && form) {
    const slug = (s: string) =>
      s
        .toLowerCase()
        .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 40);
    const initials = (s: string) =>
      s.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('') || '?';
    const update = () => {
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const business = get('business') || 'Ihr Betrieb';
      const out: Record<string, string> = {
        service: get('service') || 'Ihre Leistung',
        place: get('place') || 'Ihr Ort',
        business,
        // Das echte Beispiel behält seine echte Domain.
        domain: business === defaults.business && defaults.domain ? defaults.domain : `${slug(business) || 'ihr-betrieb'}.de`,
        initials: initials(business),
      };
      root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
        el.textContent = out[el.dataset.out ?? ''] ?? '';
      });
    };
    form.addEventListener('input', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>

<style>
  .search {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin-top: 48px;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-card);
  }
  .ask {
    grid-column: 1 / 5;
  }
  label {
    display: grid;
    gap: 8px;
  }
  .lbl,
  .where {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  input {
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 15px;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  input:hover {
    border-color: #ffffff3d;
  }
  input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .note {
    color: var(--fg-dim);
    font-size: 13px;
    line-height: 1.55;
  }
  .result-tile {
    grid-column: 5 / 9;
    background: #fafafa;
    color: #09090b;
  }
  .result-tile .where {
    color: #71717a;
  }
  .ai-tile {
    grid-column: 9 / 13;
  }
  .serp {
    display: grid;
    gap: 12px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .q {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid #dadce0;
    border-radius: 999px;
    color: #202124;
    font-size: 16px;
  }
  .hit {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    color: #202124;
    font-size: 14px;
    line-height: 1.3;
  }
  .hit > span:last-child {
    display: grid;
  }
  .fav {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #e8eaed;
    font-size: 11px;
    font-weight: 700;
  }
  .url {
    color: #4d5156;
    overflow-wrap: anywhere;
  }
  .title {
    color: #1558d6;
    font-size: 20px;
    line-height: 1.3;
  }
  .snip {
    color: #4d5156;
    font-size: 14px;
    line-height: 1.55;
  }
  .ai {
    display: grid;
    gap: 14px;
    font-size: 15px;
    line-height: 1.55;
  }
  .bubble {
    justify-self: end;
    max-width: 85%;
    padding: 10px 16px;
    border-radius: 16px;
    background: #ffffff12;
  }
  .answer {
    color: var(--fg-muted);
  }
  .answer strong {
    color: var(--fg);
    font-weight: 600;
  }
  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sources span {
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  @media (max-width: 1100px) {
    .ask {
      grid-column: 1 / -1;
    }
    .result-tile {
      grid-column: 1 / 7;
    }
    .ai-tile {
      grid-column: 7 / 13;
    }
  }
  @media (max-width: 760px) {
    .search {
      grid-template-columns: 1fr;
    }
    .ask,
    .result-tile,
    .ai-tile {
      grid-column: auto;
      padding: 20px;
    }
  }
</style>
