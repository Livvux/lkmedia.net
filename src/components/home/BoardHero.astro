---
import type { HomeContent } from '../../lib/home-content';
interface Props { hero: HomeContent['hero'] }
const { hero } = Astro.props;
// Kachelfarben der rechten Schiene, hell nach dunkel; die letzte trägt die Aktion.
const rail = ['r-1', 'r-2', 'r-3', 'r-4'];
---
<header class="hero">
  <div class="tile band" data-reveal>
    <h1 class="name">
      lkmedia<span class="sr-only"> – Webdesign & SEO aus Rastatt</span>
    </h1>
    <svg class="mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 836.36 873.35" fill="currentColor" aria-hidden="true">
      <path d="M712.53,695.46l122.93,170.26c.99,1.38,1.2,4.24.44,5.12s-3.14,2.24-4.67,2.24l-179.68.26c-21.41.03-39.95-8.79-52.65-26.03l-187.57-257.86h-3.74s-.07,277.39-.07,277.39c0,3.08-2.27,5.48-5.17,5.48l-146.83-.08c-3.32,0-5.1-2-5.1-5.47V4.47c0-2.42,4.19-4.42,6.05-4.42l94.76.1c29.85,2.3,53.4,24.25,56.17,54.03l.3,454.32,154.92-197.1,77-99.1c10.11-14.56,25.73-25.63,44.15-25.66l144.2-.24c1.21,0,3.55.95,4.04,1.81.59,1.03.09,3.29-.68,5.06l-216.59,267.94-37.9,46.25,135.69,188Z"/>
      <path d="M113.77,871.76c-57.29-3.66-112.89-53.22-112.97-109.88L.19,337.09,0,6.34C0,2.75,1.93-.02,5.56,0l117.36.72c31.22,1.37,55.48,27.65,55.48,58.51l.02,807.52c0,3.63-2.91,5.57-5.96,5.54l-58.68-.53Z"/>
    </svg>
  </div>

  <nav class="links" aria-label="Startseite">
    {hero.links.map((l, i) => (
      <a class="tile link-tile" href={l.href} data-reveal style={`--d:${60 + i * 60}ms`}>{l.label}</a>
    ))}
  </nav>

  <div class="left">
    <ul class="tile facts t-s" data-reveal style="--d:260ms">
      {hero.facts.map((f) => <li>{f}</li>)}
    </ul>
    <div class="tile pic portrait" data-reveal style="--d:200ms">
      <img src="/home/lucas-1600.webp" width="1600" height="1380" alt="Lucas Kleipoedszus am Schreibtisch vor seinem Laptop" fetchpriority="high" decoding="async" />
    </div>
  </div>

  <div class="tile pic shot" data-reveal style="--d:140ms">
    <img
      src="/landing/shots/klavierbau-milde-1440.webp"
      srcset="/landing/shots/klavierbau-milde-1440.webp 1440w, /landing/shots/klavierbau-milde-2880.webp 2880w"
      sizes="(max-width: 760px) 100vw, 66vw"
      width="1440"
      height="900"
      alt="Startseite von klavierbau-milde.de, gebaut von lkmedia"
      fetchpriority="high"
      decoding="async"
    />
    <p class="statement t-l">{hero.statement}</p>
  </div>

  <ul class="rail">
    {hero.rail.map((f, i) => (
      <li class={`tile t-s ${rail[i]}`} data-reveal style={`--d:${220 + i * 70}ms`}>{f}</li>
    ))}
    <li class="tile r-action" data-reveal style="--d:520ms">
      <a class="pill" href={hero.action.href}>
        {hero.action.label}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </li>
  </ul>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 170px 64px minmax(0, 1fr);
    gap: var(--gap);
    height: max(720px, calc(100svh - 2 * var(--edge)));
  }
  .band {
    grid-column: 1 / -1;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 22px;
  }
  .name {
    font-size: var(--t-xxl);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.74;
    white-space: nowrap;
    transform: translateY(0.06em);
  }
  .mark {
    width: auto;
    height: 112px;
    margin-bottom: 22px;
    color: var(--accent);
  }
  .links {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .link-tile {
    padding: 18px 22px;
    font-size: var(--t-m);
    font-weight: 550;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }
  .link-tile:hover {
    background: var(--tile-2);
    color: var(--accent);
  }
  .left {
    grid-column: 1 / 3;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--gap);
    min-height: 0;
  }
  .portrait {
    padding: 0;
  }
  .portrait img {
    object-position: 55% 20%;
  }
  .facts {
    display: grid;
    gap: 6px;
  }
  .shot {
    grid-column: 3 / 11;
    position: relative;
    padding: 0;
    min-height: 0;
  }
  .shot img {
    object-position: top center;
  }
  .statement {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 24px 28px 28px 24px;
    background: var(--ground);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .rail {
    grid-column: 11 / 13;
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr)) minmax(0, 1.2fr);
    gap: var(--gap);
    min-height: 0;
  }
  .rail .tile {
    line-height: 1.35;
    font-weight: 550;
  }
  .r-1 {
    background: var(--paper);
    color: var(--ink-dark);
  }
  .r-2 {
    background: #d4d4d8;
    color: var(--ink-dark);
  }
  .r-3 {
    background: var(--tile-3);
  }
  .r-4 {
    background: var(--tile-2);
  }
  .rail .r-action {
    display: flex;
    align-items: flex-end;
    padding: 14px;
    background: var(--accent);
  }
  .r-action .pill {
    width: 100%;
  }
  .r-action .pill svg {
    transition: transform 0.18s var(--ease-out);
  }
  .r-action .pill:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: auto;
      height: auto;
    }
    .band {
      min-height: 140px;
    }
    .mark {
      height: 80px;
    }
    .shot {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
    }
    .statement {
      position: static;
      width: 100%;
      border-radius: 0;
      background: var(--tile);
    }
    .shot {
      display: flex;
      flex-direction: column;
      aspect-ratio: auto;
    }
    .shot img {
      aspect-ratio: 16 / 10;
      height: auto;
    }
    .left {
      grid-column: 1 / -1;
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
    }
    .portrait {
      aspect-ratio: 4 / 5;
    }
    .left {
      order: 4;
    }
    .rail {
      order: 3;
      grid-column: 1 / -1;
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rail .tile {
      min-height: 96px;
    }
    .rail .r-action {
      grid-column: 1 / -1;
      min-height: 0;
    }
  }
  @media (max-width: 760px) {
    .band {
      min-height: 110px;
      padding: 0 16px;
    }
    .name {
      font-size: 26vw;
    }
    .mark {
      display: none;
    }
    .statement {
      font-size: 22px;
    }
    .links {
      grid-template-columns: 1fr 1fr;
    }
    .link-tile {
      padding: 16px 18px;
    }
  }
</style>
