---
import type { HomeContent } from '../../lib/home-content';
interface Props { cta: HomeContent['cta'] }
const { cta } = Astro.props;
// Die Wortmarke aus Blöcken: Höhe in % des Bandes, Farbe aus der Palette.
const blocks = [
  ['l', 100, 'b-paper'],
  ['k', 78, 'b-accent'],
  ['m', 64, 'b-grey'],
  ['e', 88, 'b-tile'],
  ['d', 100, 'b-paper'],
  ['i', 70, 'b-grey'],
  ['a', 84, 'b-accent'],
] as const;
---
<section class="close" aria-labelledby="close-title">
  <div class="flank pic left" data-reveal>
    <img src="/home/goldener-mann.webp" width="1200" height="1200" alt="Der Goldene Mann, die vergoldete Figur vom Dach des Rastatter Schlosses" loading="lazy" decoding="async" />
  </div>
  <div class="tile action" data-reveal style="--d:90ms">
    <h2 id="close-title" class="close-title">{cta.lines[0]} {cta.lines[1]}</h2>
    <p class="close-sub">{cta.sub}</p>
    <p class="actions">
      <a class="pill" href={cta.primary.href}>
        {cta.primary.label}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="link plain" href={cta.secondary.href}>{cta.secondary.label}</a>
    </p>
  </div>
  <div class="flank right" data-reveal style="--d:180ms"></div>
</section>

<div class="markband" aria-label="lkmedia" role="img">
  {blocks.map(([ch, h, c], i) => (
    <span class={`block ${c}`} style={`--h:${h}%;--d:${i * 70}ms`} data-reveal aria-hidden="true">{ch}</span>
  ))}
</div>
<p class="credit t-s soft">
  Foto Goldener Mann: <a class="link" href="https://commons.wikimedia.org/wiki/File:Schloss_Rastatt-Goldener_Mann.jpg">„Schloss Rastatt-Goldener Mann“</a> von Martin Kraft, <a class="link" href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a>, via Wikimedia Commons.
</p>

<style>
  .close {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    height: 360px;
    margin-inline: calc(-1 * var(--edge));
  }
  .flank {
    border-radius: var(--r);
  }
  .left {
    grid-column: 1 / 3;
    border-radius: 0 var(--r) var(--r) 0;
  }
  .left img {
    object-position: 50% 30%;
  }
  .right {
    grid-column: 11 / 13;
    border-radius: var(--r) 0 0 var(--r);
    background: var(--tile-3);
  }
  .action {
    grid-column: 3 / 11;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 40px;
    background: var(--accent);
    color: var(--ink-dark);
  }
  .close-title {
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .close-sub {
    max-width: 52ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 8px;
  }
  .plain:hover {
    color: var(--paper);
  }
  .markband {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 34svh;
    min-height: 220px;
    margin-top: 48px;
  }
  .block {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: var(--h);
    overflow: hidden;
    border-radius: 4px;
    color: var(--ground);
    font-size: var(--t-xxl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.72;
  }
  .b-paper {
    background: var(--paper);
  }
  .b-accent {
    background: var(--accent);
  }
  .b-grey {
    background: #d4d4d8;
  }
  .b-tile {
    background: var(--tile-3);
  }
  .credit {
    padding: 12px 4px 0;
  }
  @media (max-width: 760px) {
    .close {
      grid-template-columns: 1fr 1fr;
      height: auto;
      margin-inline: 0;
    }
    .action {
      grid-column: 1 / -1;
      grid-row: 1;
      padding: 24px;
    }
    .close-title {
      font-size: 28px;
    }
    .actions .pill {
      width: 100%;
    }
    .left,
    .right {
      grid-column: auto;
      grid-row: 2;
      height: 120px;
      border-radius: var(--r);
    }
    .markband {
      height: 22svh;
      min-height: 140px;
      margin-top: 24px;
    }
  }
</style>
