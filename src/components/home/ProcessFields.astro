---
import type { HomeContent } from '../../lib/home-content';
interface Props { process: HomeContent['process'] }
const { process } = Astro.props;
// Dieselbe Auftragskarte in jedem Feld, jedes Mal einen Schritt weiter.
const checks = [
  [],
  [['Ziele und Zielgruppe', true], ['Konzept', false], ['Texte', false]],
  [['Konzept und Texte', true], ['Seiten gebaut', true], ['Lighthouse geprüft', false]],
  [['Konzept und Texte', true], ['Seiten gebaut', true], ['Lighthouse 100', true]],
] as const;
const status = ['Neu', 'In Arbeit', 'In Arbeit', 'Live'];
---
<section id="ablauf" class="process" aria-labelledby="process-title">
  <ol class="fields">
    {process.steps.map((s, i) => (
      <li class={`field f-${i + 1}`}>
        {i === 0 && <h2 id="process-title" class="t-l heading">{process.title}</h2>}
        <div class="card" data-ui data-reveal style={`--d:${i * 90}ms`}>
          <p class="card-top">
            <span>Website Ihres Betriebs</span>
            <span class="status">{status[i]}</span>
          </p>
          <p class="card-body">{s.body}</p>
          {checks[i].length > 0 && (
            <ul class="checks">
              {checks[i].map(([label, done]) => (
                <li class={done ? 'done' : ''}>
                  <span class="box" aria-hidden="true"></span>
                  {label}<span class="sr-only">{done ? ' (erledigt)' : ' (offen)'}</span>
                </li>
              ))}
            </ul>
          )}
          {i > 0 && <p class="who">Lucas Kleipoedszus</p>}
        </div>
        <p class="clause t-l" data-reveal style={`--d:${i * 90 + 60}ms`}>{s.title}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: var(--r);
    overflow: hidden;
  }
  .field {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 84svh;
    padding: 28px;
  }
  .f-1 {
    background: var(--tile);
  }
  .f-2 {
    background: var(--tile-3);
  }
  .f-3 {
    background: #d4d4d8;
    color: var(--ink-dark);
  }
  .f-4 {
    background: var(--paper);
    color: var(--ink-dark);
  }
  .heading {
    grid-row: 1;
    font-weight: 750;
  }
  .card {
    grid-row: 2;
    align-self: center;
    justify-self: center;
    width: min(260px, 100%);
    padding: 16px;
    border-radius: 10px;
    background: var(--ground);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.4;
    transition: transform 0.15s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-6px);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-weight: 600;
  }
  .status {
    white-space: nowrap;
    align-self: start;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--tile-3);
    font-size: 13px;
    font-weight: 500;
  }
  .f-4 .status {
    background: var(--accent);
    color: var(--ink-dark);
  }
  .card-body {
    margin-top: 10px;
    color: var(--soft);
  }
  .checks {
    display: grid;
    gap: 6px;
    margin-top: 12px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .box {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1.5px solid #ffffff4d;
    border-radius: 4px;
    font-size: 11px;
  }
  .done .box {
    border-color: var(--accent);
    background: var(--accent);
  }
  .done .box::after {
    content: '';
    width: 4px;
    height: 8px;
    margin-top: -2px;
    border: solid var(--ink-dark);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .who {
    margin-top: 12px;
    color: var(--soft);
    font-size: 13px;
  }
  .clause {
    grid-row: 3;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }
  @media (max-width: 900px) {
    .fields {
      grid-template-columns: 1fr;
    }
    .field {
      min-height: 64svh;
      grid-template-rows: auto auto 1fr;
      padding: 20px;
    }
    .clause {
      grid-row: 2;
      margin-bottom: 32px;
    }
    .card {
      grid-row: 3;
      align-self: start;
      justify-self: start;
    }
    .heading {
      margin-bottom: 12px;
    }
  }
</style>
