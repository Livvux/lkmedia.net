---
import type { HomeContent } from '../../lib/home-content';
import SectionHead from './SectionHead.astro';
interface Props { why: HomeContent['why']; figures: number[]; figuresLabel: string }
const { why, figures, figuresLabel } = Astro.props;
---
<section class="why wrap" aria-labelledby="why-title">
  <SectionHead id="why-title" label={why.label} title={why.title} quiet={why.quiet} />
  <ol class="points">
    {why.items.map((item, i) => (
      <li data-reveal style={`--d:${(i % 2) * 60}ms`}>
        <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </li>
    ))}
  </ol>
  <!-- Zahlen aus den echten Inhalten, nicht aus Marketingzahlen. -->
  <ul class="figures" aria-label={figuresLabel}>
    {figures.map((value, i) => (
      <li data-reveal style={`--d:${i * 60}ms`}>
        <span class="value">{value}</span>
        <span class="caption">{why.metrics[i]}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .why { padding-block: var(--section-space); }
  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--border-strong);
  }
  .points li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 8px 16px;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--border);
  }
  .n { grid-row: span 2; padding-top: 6px; color: var(--signal); font-family: var(--font-mono); font-size: 12px; }
  h3 { font-size: 22px; font-weight: 500; letter-spacing: -0.025em; line-height: 1.25; }
  .points p { max-width: 52ch; color: var(--fg-muted); font-size: 15px; line-height: 1.6; }
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--border-strong);
  }
  .figures li { display: grid; gap: 10px; padding: 28px 24px 0 0; }
  .figures li + li { padding-left: 28px; border-left: 1px solid var(--border); }
  .value {
    font-size: clamp(48px, 6vw, 88px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .caption { color: var(--fg-muted); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
  @media (max-width: 800px) {
    .points { grid-template-columns: 1fr; }
    .points li { grid-template-columns: 36px minmax(0, 1fr); }
    .figures { grid-template-columns: 1fr; }
    .figures li, .figures li + li { padding: 22px 0; border-left: 0; border-bottom: 1px solid var(--border); }
  }
</style>
