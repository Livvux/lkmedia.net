---
import type { HomeContent } from '../../lib/home-content';
interface Props { cta: HomeContent['cta'] }
const { cta } = Astro.props;
---
<section class="close" aria-labelledby="close-title">
  <div class="wrap close-inner">
    <div data-reveal>
      <p class="label">{cta.label}</p>
      <h2 id="close-title" class="display close-title">{cta.title} <span class="quiet">{cta.quiet}</span></h2>
      <p class="lede close-sub">{cta.sub}</p>
      <div class="actions">
        <a href={cta.primary.href} class="btn btn-primary btn-lg">
          {cta.primary.label}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href={cta.secondary.href} class="btn btn-ghost btn-lg">{cta.secondary.label}</a>
      </div>
      <a class="mono-link email" href={`mailto:${cta.email}`}>{cta.email}</a>
    </div>
    <ol class="promises" data-reveal style="--d:60ms">
      {cta.promises.map((p, i) => (
        <li><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{p}</li>
      ))}
    </ol>
  </div>
</section>

<style>
  .close {
    padding-block: clamp(88px, 11vw, 160px);
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .close-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(48px, 6vw, 96px);
  }
  .close-title { margin-top: 24px; max-width: 18ch; font-size: clamp(38px, 4.6vw, 68px); }
  .close-sub { margin-top: 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }
  .email { margin-top: 24px; min-height: 44px; font-size: 14px; }
  .promises { border-top: 1px solid var(--border-strong); }
  .promises li {
    display: flex;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .n { padding-top: 3px; color: var(--signal); font-family: var(--font-mono); font-size: 12px; }
  @media (max-width: 900px) {
    .close-inner { grid-template-columns: 1fr; align-items: start; }
  }
</style>
