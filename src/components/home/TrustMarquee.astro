---
interface Props { label: string; items: string[] }
const { label, items } = Astro.props;
---
<section class="trust wrap" aria-label={label}>
  <p class="eyebrow">{label}</p>
  <ul>{items.map((item) => <li>{item}</li>)}</ul>
</section>
<style>
  .trust { text-align: center; }
  .trust ul { display: flex; justify-content: center; flex-wrap: wrap; gap: 18px 36px; margin-top: 24px; }
  .trust li { color: var(--fg-muted); font-size: clamp(14px, 1.4vw, 18px); font-weight: 500; letter-spacing: -0.02em; }
  @media (max-width: 600px) { .trust { text-align: left; } .trust ul { justify-content: flex-start; gap: 14px 24px; } }
</style>
