---
import type { Lang } from '../lib/i18n';
import { DISCOVERY_CHANNELS } from '../lib/lead-source';
interface Props { lang: Lang; source?: string; messageHelp?: string }
const {
  source = '/kontakt',
  messageHelp = 'Hilfreich sind Ihre Branche, die Website-Adresse und die wichtigste gewünschte Änderung.',
} = Astro.props;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const placeholders = { name: 'Name', email: 'E-Mail', company: 'Firma', budget: 'Budget', message: 'Nachricht' };
---
<form method="POST" action="/api/contact" class="space-y-4 max-w-xl">
  <input type="hidden" name="source" value={source} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <label class="block">
    <span class="text-sm text-black/60 dark:text-white/60">{placeholders.name}</span>
    <input required name="name" autocomplete="name" class="mt-1 w-full h-12 px-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 focus:border-black dark:focus:border-white focus:outline-none" />
  </label>
  <label class="block">
    <span class="text-sm text-black/60 dark:text-white/60">{placeholders.email}</span>
    <input required type="email" name="email" autocomplete="email" class="mt-1 w-full h-12 px-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 focus:border-black dark:focus:border-white focus:outline-none" />
  </label>
  <label class="block">
    <span class="text-sm text-black/60 dark:text-white/60">{placeholders.company}</span>
    <input name="company" autocomplete="organization" class="mt-1 w-full h-12 px-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 focus:border-black dark:focus:border-white focus:outline-none" />
  </label>
  <label class="block">
    <span id="budget-label" class="text-sm text-black/60 dark:text-white/60">{placeholders.budget}</span>
    <select name="budget" aria-labelledby="budget-label" class="mt-1 w-full h-12 px-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 focus:border-black dark:focus:border-white focus:outline-none">
      <option value="" disabled selected>{'— Budget wählen —'}</option>
      <option value="< 5k">&lt; 5k</option>
      <option value="5–15k">5–15k</option>
      <option value="15–30k">15–30k</option>
      <option value="30k+">30k+</option>
      <option value="unklar">{'unklar'}</option>
    </select>
  </label>
  <label class="block">
    <span class="text-sm text-black/60 dark:text-white/60">{placeholders.message}</span>
    <textarea required name="message" rows="5" aria-describedby="message-help" class="mt-1 w-full p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10"></textarea>
  </label>
  <p id="message-help" class="text-sm text-black/60 dark:text-white/60">{messageHelp}</p>
  <label class="block">
    <span class="text-sm text-black/60 dark:text-white/60">Wie haben Sie uns gefunden? (optional)</span>
    <select name="discovery" class="mt-1 w-full h-12 px-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
      {Object.entries(DISCOVERY_CHANNELS).map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
  </label>
  {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}
  <p id="contact-error" role="alert" tabindex="-1" class="rounded-xl border border-red-500/40 bg-red-500/10 p-4 text-sm" hidden></p>
  <button id="contact-submit" class="btn btn-primary mt-2 min-h-12 disabled:opacity-50">Projektanfrage senden</button>
</form>
{turnstileKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import { leadSource } from '../lib/lead-source';
  const source = document.querySelector<HTMLInputElement>('input[name="source"]');
  if (source?.value === '/kontakt' && document.referrer) {
    try {
      const referrer = new URL(document.referrer);
      if (referrer.origin === location.origin) source.value = leadSource(referrer.pathname);
    } catch { /* No usable referrer means a direct inquiry. */ }
  }
  // Ohne JS sendet das Formular normal; mit JS bleiben die Eingaben bei einem Fehler erhalten.
  type State = { phase: 'idle' } | { phase: 'sending' } | { phase: 'error'; text: string };
  const LABEL = 'Projektanfrage senden';
  const KONTAKT = 'Ihre Eingaben bleiben erhalten. Sie erreichen mich auch direkt unter lucas@lkmedia.net.';
  const form = document.querySelector<HTMLFormElement>('form[action="/api/contact"]');
  const btn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const error = document.getElementById('contact-error');
  let state: State = { phase: 'idle' };

  function render(next: State) {
    state = next;
    if (btn) {
      btn.disabled = state.phase === 'sending';
      btn.textContent = state.phase === 'sending' ? 'Anfrage wird gesendet …' : LABEL;
      btn.toggleAttribute('aria-busy', state.phase === 'sending');
    }
    if (error) {
      error.hidden = state.phase !== 'error';
      error.textContent = state.phase === 'error' ? `${state.text} ${KONTAKT}` : '';
      if (state.phase === 'error') error.focus();
    }
  }

  // Zurück-Taste (bfcache): nicht im Sende-Zustand hängen bleiben.
  window.addEventListener('pageshow', () => render({ phase: 'idle' }));
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (state.phase === 'sending') return;
    render({ phase: 'sending' });
    try {
      // urlencoded wie der native POST ohne JS.
      const body = new URLSearchParams([...new FormData(form)].map(([k, v]) => [k, String(v)]));
      const res = await fetch(form.action, { method: 'POST', body, signal: AbortSignal.timeout(20_000) });
      if (res.redirected) return location.assign(res.url);
      // Nur eigene Klartext-Meldungen zeigen, keine HTML-Fehlerseiten.
      const text = res.headers.get('content-type')?.startsWith('text/plain') ? await res.text() : '';
      render({ phase: 'error', text: text || 'Das Absenden hat nicht geklappt. Bitte versuchen Sie es noch einmal.' });
    } catch {
      render({ phase: 'error', text: 'Keine Antwort vom Server. Bitte prüfen Sie Ihre Verbindung und senden Sie noch einmal.' });
    }
    // Turnstile-Token gilt nur einmal: für den nächsten Versuch neu ausstellen.
    (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
  });
</script>
