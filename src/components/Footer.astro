---
import { routeFor, useTranslations, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const en = lang === 'en';
const serviceLinks = [
  { href: routeFor('wordpress', lang), label: t('nav.wordpress') },
  { href: routeFor('ai', lang), label: t('nav.ai') },
  { href: routeFor('development', lang), label: t('nav.development') },
];
const columns = en
  ? [
      { title: 'Services', links: [...serviceLinks, { href: routeFor('grokBot', lang), label: 'Grok Bot for WordPress' }] },
      {
        title: 'In German',
        links: [
          { href: routeFor('cases', lang), label: 'Work' },
          { href: routeFor('blog', lang), label: 'Insights' },
          { href: routeFor('about', lang), label: 'About' },
        ],
      },
    ]
  : [
      {
        title: 'Leistungen',
        links: [
          ...serviceLinks,
          { href: routeFor('services', lang), label: 'Website-Pakete' },
          { href: routeFor('seo', lang), label: 'SEO in Rastatt' },
        ],
      },
      {
        title: 'Studio',
        links: [
          { href: routeFor('cases', lang), label: t('nav.cases') },
          { href: routeFor('blog', lang), label: t('nav.blog') },
          { href: routeFor('about', lang), label: t('nav.about') },
          { href: routeFor('grokBot', lang), label: 'Grok Bot für WordPress' },
        ],
      },
      {
        title: 'Branchen',
        links: [
          { href: routeFor('lawFirms', lang), label: 'Kanzleien' },
          { href: routeFor('realEstate', lang), label: 'Luxus-Immobilien' },
          { href: routeFor('clinics', lang), label: 'Privatkliniken' },
          { href: routeFor('doctors', lang), label: 'Arztpraxen (docweb)' },
          { href: routeFor('craftsmen', lang), label: 'Handwerk (handwerkweb)' },
          { href: routeFor('drivingSchools', lang), label: 'Fahrschulen' },
        ],
      },
    ];
const copy = en
  ? { home: 'lk media – home', tag: 'Websites, WordPress and AI systems. Built in Rastatt, Germany.', contact: 'Talk about your project', more: 'More pages', legal: 'Legal and contact', imprint: 'Imprint (German)', privacy: 'Privacy (German)' }
  : { home: 'lk media – Startseite', tag: 'Websites, WordPress und KI-Systeme. Gebaut in Rastatt.', contact: 'Über Ihr Projekt sprechen', more: 'Weiterführende Seiten', legal: 'Rechtliches und Kontakt', imprint: 'Impressum', privacy: 'Datenschutz' };
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-inner">
      <div class="footer-brand">
        <a class="footer-name" href={routeFor('home', lang)} aria-label={copy.home}>lk media<span aria-hidden="true">↗</span></a>
        <p class="footer-tag">{copy.tag}</p>
        <a class="footer-contact" href={routeFor('contact', lang)}>{copy.contact} <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="footer-cols" aria-label={copy.more}>
        {columns.map((col) => (
          <div>
            <h2 class="footer-title">{col.title}</h2>
            <ul>
              {col.links.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} lkmedia · Lucas Kleipoedszus</p>
      <nav class="footer-legal" aria-label={copy.legal}>
        <a href={routeFor('imprint', lang)}>{copy.imprint}</a>
        <a href={routeFor('privacy', lang)}>{copy.privacy}</a>
        <a href={routeFor('contact', lang)}>{t('nav.contact')}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
    font-size: 14px;
  }
  .footer-inner {
    display: grid;
    gap: 48px;
    padding-block: clamp(56px, 7vw, 88px);
  }
  .footer-name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 32px;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 450;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .footer-tag {
    max-width: 30ch;
    margin-top: 18px;
    font-size: 18px;
    letter-spacing: -0.02em;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .footer-contact {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 44px;
    margin-top: 24px;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 6px;
    transition: text-decoration-color 180ms;
  }
  .footer-contact:hover { text-decoration-color: currentColor; }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 24px;
  }
  .footer-title {
    min-height: 44px;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 8px;
    line-height: 1.5;
    color: var(--fg-muted);
    transition: color 180ms;
  }
  .footer-link:hover,
  .footer-legal a:hover { color: var(--fg); }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--fg-muted);
  }
  .footer-bottom > p { padding-block: 12px; }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color 180ms;
  }
  @media (min-width: 768px) {
    .footer-inner { grid-template-columns: 1fr 1.4fr; gap: 64px; }
    .footer-cols { gap: 40px; }
  }
</style>
