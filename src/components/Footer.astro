---
import { routeFor, useTranslations, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Agentur',
    links: [
      { href: routeFor('services', lang), label: t('nav.services') },
      { href: routeFor('seo', lang), label: 'SEO in Rastatt' },
      { href: routeFor('cases', lang), label: t('nav.cases') },
      { href: routeFor('about', lang), label: t('nav.about') },
      { href: routeFor('blog', lang), label: t('nav.blog') },
    ],
  },
  {
    title: 'Branchen',
    links: [
      { href: routeFor('lawFirms', lang), label: 'Kanzleien' },
      { href: routeFor('realEstate', lang), label: 'Luxus-Immobilien' },
      { href: routeFor('clinics', lang), label: 'Privatkliniken' },
      { href: routeFor('doctors', lang), label: 'Arztpraxen (docweb)' },
      { href: routeFor('craftsmen', lang), label: 'Handwerk (handwerkweb)' },
      { href: routeFor('drivingSchools', lang), label: 'Fahrschulen' },
    ],
  },
  {
    title: 'Rechtliches',
    links: [
      { href: routeFor('imprint', lang), label: 'Impressum' },
      { href: routeFor('privacy', lang), label: 'Datenschutz' },
      { href: routeFor('contact', lang), label: t('nav.contact') },
    ],
  },
];
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <div class="footer-name">lkmedia</div>
      <p class="footer-tag">
        {'Webdesign & SEO aus Rastatt.'}
      </p>
      <p class="footer-meta">© {year} lkmedia · Lucas Kleipoedszus</p>
    </div>
    <div class="footer-cols">
      {columns.map((col) => (
        <div>
          <h2 class="footer-title">{col.title}</h2>
          <ul class="space-y-2.5">
            {col.links.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-elev);
    font-size: 15px;
  }
  .footer-title {
    margin-bottom: 16px;
    font-weight: 600;
    color: var(--fg);
  }
  .footer-inner {
    display: grid;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1.4fr;
    }
  }
  .footer-name {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .footer-tag {
    margin-top: 8px;
    color: var(--fg-muted);
  }
  .footer-meta {
    margin-top: 24px;
    font-size: 14px;
    color: var(--fg-muted);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  @media (min-width: 640px) {
    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .footer-link {
    color: var(--fg-muted);
    transition: color 0.18s;
  }
  .footer-link:hover {
    color: var(--fg);
  }
</style>
