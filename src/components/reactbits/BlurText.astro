---
/**
 * BlurText (react-bits "BlurText"): Wort für Wort mit Unschärfe einblenden.
 * Die Enthüllung hängt an data-reveal, das die Base-Layout beim Scrollen setzt.
 * Ohne JavaScript bleibt der Text vollständig sichtbar.
 */
interface Props {
  text: string;
  /** Verzögerung je Wort in Millisekunden. */
  delay?: number;
  class?: string;
}

const { text, delay = 55, class: className = '' } = Astro.props;
const words = text.split(' ').filter(Boolean);
---

<span class:list={['blur-text', className]} data-reveal="blur">
  {
    words.map((word, i) => (
      <>
        <span class="blur-text__word" style={`--d:${i * delay}ms`}>{word}</span>{' '}
      </>
    ))
  }
</span>
