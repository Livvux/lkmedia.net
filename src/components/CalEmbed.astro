---
interface Props { calLink: string; label?: string }
const { calLink, label = 'Terminkalender laden' } = Astro.props;
const [, eventSlug] = calLink.split('/');
const elId = `cal-inline-${eventSlug}`;
---
<p class="mt-4 text-sm text-black/60 dark:text-white/60">Zum Buchen laden Sie den Kalender von Cal.com. Dabei wird eine Verbindung zu diesem externen Dienst hergestellt.</p>
<button type="button" id={`${elId}-load`} data-contact-calendar aria-controls={elId}
  class="mt-6 min-h-12 px-6 py-3 rounded-full border border-black/30 dark:border-white/30">{label}</button>
<p class="mt-4 text-sm"><a href={`https://cal.com/${calLink}`} target="_blank" rel="noopener noreferrer" class="underline">Kalender auf Cal.com öffnen ↗</a></p>
<div id={elId} hidden tabindex="-1" style="width:100%;overflow:auto;min-height:600px" role="region" aria-label="Terminkalender"></div>
<script type="text/javascript" define:vars={{ calLink, elId, eventSlug }}>
  document.getElementById(elId + '-load')?.addEventListener('click', function () {
    this.hidden = true;
    document.getElementById(elId).hidden = false;
    document.getElementById(elId).focus();
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", eventSlug, { origin: "https://app.cal.com" });
  Cal.ns[eventSlug]("inline", {
    elementOrSelector: "#" + elId,
    config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
    calLink,
  });
  Cal.ns[eventSlug]("ui", { hideEventTypeDetails: false, layout: "month_view" });
  }, { once: true });
</script>
