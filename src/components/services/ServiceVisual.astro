---
import { routeFor } from '../../lib/i18n';

interface Props {
  kind: 'websites' | 'seo' | 'conversion';
  lang: 'de' | 'en';
}

const { kind, lang } = Astro.props;
const de = lang === 'de';
const journey = [
  {
    title: de ? 'Angebot verstehen' : 'Understand the offer',
    detail: de ? 'Was Sie tun. Für wen. Und warum es passt.' : 'What you do. Who it is for. Why it fits.',
    icon: 'M5 3.5h10L19.5 8v12.5H5V3.5Zm10 0V8h4.5M9 12h6M9 16h4',
  },
  {
    title: de ? 'Vertrauen aufbauen' : 'Build confidence',
    detail: de ? 'Echte Projekte. Klare Antworten. Ein Gesicht.' : 'Real projects. Clear answers. A person to trust.',
    icon: 'm12 3 8 3v5c0 5-4.5 8-8 10-3.5-2-8-5-8-10V6l8-3Zm-4 9 3 3 5-6',
  },
  {
    title: de ? 'Kontakt aufnehmen' : 'Get in touch',
    detail: de ? 'Ein sichtbarer, einfacher nächster Schritt.' : 'One visible, straightforward next step.',
    icon: 'M4.5 4.5h15v12h-4l-3.5 4-3.5-4h-4v-12Zm4 5h7m-7 3h4',
  },
];
---

{kind === 'websites' && (
  <figure class="visual website-visual">
    <div class="browser-bar" aria-hidden="true">
      <span class="window-dots"><i></i><i></i><i></i></span>
      <span class="browser-address">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="10" width="12" height="10" rx="2"/><path d="M8.5 10V7a3.5 3.5 0 0 1 7 0v3"/></svg>
        klavierbau-milde.de
      </span>
    </div>
    <img
      class="website-shot"
      src="/landing/shots/klavierbau-milde-1440.webp"
      width="1440"
      height="900"
      alt={de ? 'Website von Klavierbau Hans Milde mit Termin-Anfrage und Kontaktmöglichkeiten' : 'Klavierbau Hans Milde website with appointment requests and contact options'}
      loading="lazy"
      decoding="async"
    />
    <figcaption class="website-caption">
      <div>
        <span class="visual-label">{de ? 'Kundenprojekt' : 'Client project'}</span>
        <p class="client-name">Klavierbau Hans Milde</p>
        <p class="scope">{de ? 'Design, Entwicklung, Local SEO' : 'Design, development, local SEO'}</p>
      </div>
      <svg class="caption-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
    </figcaption>
  </figure>
)}

{kind === 'seo' && (
  <figure class="visual search-visual">
    <div class="search-content">
      <div class="visual-heading">
        <span class="visual-label">{de ? 'Lokale Suche' : 'Local search'}</span>
        <svg class="muted-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8V4h4m8 0h4v4M4 16v4h4m8 0h4v-4"/></svg>
      </div>
      <div class="search-query">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
        <span lang="de">Klavierstimmer Karlsruhe</span>
      </div>
      <div class="search-result">
        <div class="result-source">
          <span class="source-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="8"/><ellipse cx="12" cy="12" rx="3.5" ry="8"/><path d="M4 12h16"/></svg>
          </span>
          <div><p class="source-name">Klavierbau Hans Milde</p><p class="source-domain">klavierbau-milde.de</p></div>
        </div>
        <p class="result-title">{de ? 'Klavierstimmung & Reparatur in Karlsruhe' : 'Piano tuning & repairs in Karlsruhe'}</p>
        <p class="result-snippet">{de ? 'Für Klaviere und Flügel. Besprechen Sie Ihr Instrument und einen passenden Termin direkt mit Hans Milde.' : 'For upright and grand pianos. Discuss your instrument and a suitable appointment directly with Hans Milde.'}</p>
      </div>
      <div class="search-signals">
        <div class="signal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4v12a3 3 0 0 0 3 3h3M5 9h6"/><rect x="12" y="6" width="7" height="6" rx="1.5"/><rect x="12" y="16" width="7" height="6" rx="1.5"/></svg>
          <div><p class="signal-label">{de ? 'Klare Inhalte' : 'Clear content'}</p><p class="signal-detail">{de ? 'Leistung, Details, Kontakt' : 'Service, details, contact'}</p></div>
        </div>
        <div class="signal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <div><p class="signal-label">{de ? 'Lokaler Bezug' : 'Local relevance'}</p><p class="signal-detail">Karlsruhe</p></div>
        </div>
      </div>
    </div>
    <figcaption class="example-note">{de ? 'Beispiel · keine Live-Suchergebnisse' : 'Example · not live search results'}</figcaption>
  </figure>
)}

{kind === 'conversion' && (
  <figure class="visual journey-visual">
    <figcaption class="journey-caption visual-label">{de ? 'Vom ersten Eindruck zur Anfrage' : 'From first impression to enquiry'}</figcaption>
    <ol class="journey">
      {journey.map((step) => (
        <li class="journey-step">
          <span class="step-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={step.icon}/></svg>
          </span>
          <div><p class="step-title">{step.title}</p><p class="step-detail">{step.detail}</p></div>
        </li>
      ))}
    </ol>
    <div class="journey-action">
      <a class="contact-link" href={routeFor('contact', lang)}>
        {de ? 'Projekt anfragen' : 'Discuss your project'}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
      <p>{de ? 'Direkt mit Lucas. Ohne Umwege.' : 'Talk directly to Lucas.'}</p>
    </div>
  </figure>
)}

<style>
  .visual {
    width: 100%;
    max-width: 560px;
    min-width: 0;
    margin: 0 auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .visual p { margin: 0; }
  .visual svg { flex-shrink: 0; }
  .visual-label { color: var(--fg-muted); font-size: 11px; font-weight: 500; letter-spacing: .05em; }
  .website-visual { overflow: hidden; }
  .browser-bar { position: relative; display: flex; align-items: center; justify-content: center; gap: 14px; height: 42px; padding: 0 18px; border-bottom: 1px solid var(--border); }
  .window-dots { position: absolute; left: 18px; display: flex; gap: 5px; }
  .window-dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--fg-faint); }
  .browser-address { display: inline-flex; align-items: center; gap: 7px; color: var(--fg-muted); font-size: 11px; }
  .browser-address svg { color: var(--fg-dim); }
  .website-shot { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; }
  .website-caption { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; border-top: 1px solid var(--border); }
  .website-caption .client-name { margin-top: 5px; font-size: 16px; font-weight: 500; letter-spacing: -.025em; }
  .website-caption .scope { margin-top: 4px; color: var(--fg-muted); font-size: 12px; line-height: 1.5; }
  .caption-icon { color: var(--fg-dim); }
  .search-content { padding: 28px; }
  .visual-heading { display: flex; align-items: center; justify-content: space-between; }
  .muted-icon { color: var(--fg-dim); }
  .search-query { display: flex; align-items: center; gap: 12px; min-height: 50px; margin-top: 22px; padding: 12px 17px; border: 1px solid var(--border-strong); border-radius: 999px; background: var(--bg-card); font-size: 14px; line-height: 1.4; }
  .search-query svg { color: var(--fg-muted); }
  .search-result { padding: 29px 2px 26px; }
  .result-source { display: flex; align-items: center; gap: 11px; }
  .source-icon { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 50%; color: var(--fg-muted); }
  .source-name { font-size: 12px; line-height: 1.5; }
  .source-domain { color: var(--fg-muted); font-size: 11px; line-height: 1.5; }
  .search-result .result-title { margin-top: 15px; color: var(--accent); font-size: clamp(19px, 2vw, 22px); font-weight: 500; line-height: 1.25; letter-spacing: -.025em; text-wrap: balance; }
  .search-result .result-snippet { margin-top: 9px; color: var(--fg-muted); font-size: 13px; line-height: 1.7; }
  .search-signals { display: grid; grid-template-columns: 1.15fr 1fr; gap: 16px; padding-top: 22px; border-top: 1px solid var(--border); }
  .signal { display: flex; align-items: flex-start; gap: 10px; }
  .signal svg { margin-top: 1px; color: var(--fg-muted); }
  .signal-label { font-size: 12px; line-height: 1.5; }
  .signal .signal-detail { margin-top: 4px; color: var(--fg-muted); font-size: 11px; line-height: 1.5; }
  .example-note { padding: 14px 28px; border-top: 1px solid var(--border); color: var(--fg-muted); font-size: 11px; line-height: 1.5; }
  .journey-visual { padding: 30px; }
  .journey-caption { display: block; }
  .journey { display: grid; gap: 0; margin: 28px 0 0; padding: 0; list-style: none; }
  .journey-step { position: relative; display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 18px; padding: 0 0 28px; }
  .journey-step:not(:last-child)::after { position: absolute; top: 48px; bottom: 5px; left: 21.5px; width: 1px; background: var(--border-strong); content: ''; }
  .step-icon { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--border-strong); border-radius: 50%; color: var(--fg-muted); }
  .journey-step:last-child .step-icon { border-color: color-mix(in oklch, var(--accent) 45%, transparent); background: var(--accent-dim); color: var(--accent); }
  .step-title { padding-top: 1px; font-size: 17px; font-weight: 500; letter-spacing: -.025em; line-height: 1.5; }
  .journey-step .step-detail { margin-top: 4px; color: var(--fg-muted); font-size: 13px; line-height: 1.6; }
  .journey-action { padding-top: 22px; border-top: 1px solid var(--border); }
  .contact-link { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; padding: 12px 20px; border-radius: 999px; background: var(--fg); color: var(--bg); font-size: 14px; font-weight: 500; line-height: 1.5; }
  .contact-link:hover { background: #e4e4e7; }
  .journey-action p { margin-top: 12px; color: var(--fg-muted); font-size: 11px; text-align: center; }
  @media (max-width: 480px) {
    .visual { border-radius: 14px; }
    .website-caption { padding: 18px 20px; }
    .search-content { padding: 22px 20px; }
    .search-query { gap: 10px; padding-inline: 14px; font-size: 13px; }
    .search-signals { grid-template-columns: 1fr; gap: 18px; }
    .example-note { padding-inline: 20px; }
    .journey-visual { padding: 24px 20px; }
    .journey-step { gap: 14px; }
    .step-title { font-size: 16px; }
    .window-dots { left: 12px; gap: 4px; }
    .window-dots i { width: 4px; height: 4px; }
  }
</style>
