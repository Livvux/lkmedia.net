---
import { homeContent } from '../../lib/home-content';
import { routeFor, type Lang } from '../../lib/i18n';
import type { ServicesContent } from '../../lib/services-content';
interface Props { proof: ServicesContent['proof']; lang: Lang }
const { proof, lang } = Astro.props;
const projects = homeContent[lang].proof.shots.filter((shot) => shot.slug !== 'lorenz-logistik');
const scopes = lang === 'de'
  ? ['Webdesign & Local SEO', 'Local SEO & Mehrsprachigkeit', 'SEO & Workshop-Landingpage']
  : ['Web design & local SEO', 'Local SEO & multilingual content', 'SEO & workshop landing page'];
---
<section class="services-proof" aria-labelledby="services-proof-heading">
  <div class="wrap">
    <div class="proof-head">
      <div>
        <h2 class="section-title" id="services-proof-heading">{proof.title}</h2>
        <p class="section-sub">{proof.body}</p>
      </div>
      <a class="proof-all" href={routeFor('cases', lang)}>
        {proof.linkLabel}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
    <ul class="proof-projects">
      {projects.map((project, index) => (
        <li>
          <a class="proof-project" href={`${routeFor('cases', lang)}/${project.slug}`}>
            <div class="project-image">
              <img src={`/landing/shots/${project.slug}-1440.webp`} width="1440" height="900" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="project-title">
              <h3>{project.client}</h3>
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12l8-8M4 4h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <p>{scopes[index]}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services-proof { padding: 112px 0; }
  .proof-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; }
  .proof-head > div { max-width: 720px; }
  .proof-head .section-title { max-width: 19ch; }
  .proof-head .section-sub { margin-top: 22px; max-width: 640px; }
  .proof-all { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; flex-shrink: 0; font-size: 14px; text-underline-offset: 5px; }
  .proof-all:hover { text-decoration: underline; }
  .proof-projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 48px; }
  .proof-project { display: block; }
  .project-image { overflow: hidden; border: 1px solid var(--border-strong); border-radius: 12px; aspect-ratio: 1.6; background: var(--bg-elev); }
  .project-image img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 400ms var(--ease-out); }
  .project-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
  .project-title h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
  .project-title svg { flex-shrink: 0; color: var(--fg-muted); }
  .proof-project p { font-size: 13px; line-height: 1.6; color: var(--fg-muted); margin-top: 6px; }
  .proof-project:hover img { transform: scale(1.025); }
  .proof-project:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 959px) { .proof-head { display: block; } .proof-all { margin-top: 22px; } .proof-projects { gap: 20px; } }
  @media (max-width: 640px) { .services-proof { padding: 64px 0; } .proof-projects { grid-template-columns: 1fr; gap: 36px; margin-top: 30px; } }
  @media (prefers-reduced-motion: reduce) { .project-image img { transition: none; } .proof-project:hover img { transform: none; } }
</style>
