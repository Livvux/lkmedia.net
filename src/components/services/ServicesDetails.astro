---
import type { ServicesContent } from '../../lib/services-content';
import { faqPage } from '../../lib/schema';
interface Props { investment: ServicesContent['investment']; faq: ServicesContent['faq'] }
const { investment, faq } = Astro.props;
---
<section class="investment" aria-labelledby="investment-heading">
  <div class="wrap investment-layout">
    <div>
      <h2 id="investment-heading" class="section-title">{investment.title}</h2>
      <p class="section-sub">{investment.body}</p>
    </div>
    <div class="investment-price">
      <p>{investment.price}</p>
      <span>{investment.note}</span>
    </div>
  </div>
</section>

<section class="services-faq" aria-labelledby="services-faq-heading">
  <div class="wrap faq-layout">
    <h2 id="services-faq-heading" class="section-title">{faq.title}</h2>
    <div class="faq-items">
      {faq.items.map((item) => (
        <details class="faq-item" name="services-faq">
          <summary>
            <span>{item.q}</span>
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage(faq.items))} />

<style>
  .investment { padding: 80px 0; background: var(--bg-elev); border-block: 1px solid var(--border); }
  .investment-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; align-items: center; }
  .investment .section-title { max-width: 12ch; font-size: clamp(32px, 3.3vw, 44px); }
  .investment .section-sub { max-width: 440px; margin-top: 20px; }
  .investment-price p { font-size: clamp(28px, 3.3vw, 44px); font-weight: 500; letter-spacing: -0.035em; line-height: 1.15; text-wrap: balance; }
  .investment-price span { display: block; margin-top: 16px; font-size: 14px; color: var(--fg-muted); }
  .services-faq { padding: 112px 0; }
  .faq-layout { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: 96px; }
  .faq-layout h2 { max-width: 14ch; }
  .faq-item { border-bottom: 1px solid var(--border-strong); }
  .faq-item:first-child { border-top: 1px solid var(--border-strong); }
  .faq-item summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 80px; padding-block: 22px; font-size: 17px; line-height: 1.5; font-weight: 500; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--fg-muted); }
  .faq-item summary svg { flex-shrink: 0; transition: transform 180ms var(--ease-out); }
  .faq-item[open] summary svg { transform: rotate(45deg); }
  .faq-item p { padding-bottom: 26px; padding-right: 34px; font-size: 15px; line-height: 1.75; color: var(--fg-muted); }
  @media (max-width: 959px) { .investment-layout, .faq-layout { gap: 40px; } }
  @media (max-width: 767px) { .investment-layout, .faq-layout { grid-template-columns: minmax(0, 1fr); } .faq-layout h2 { max-width: 20ch; } }
  @media (max-width: 640px) { .investment, .services-faq { padding: 64px 0; } .investment-price p { font-size: 30px; } .faq-item summary { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .faq-item summary svg { transition: none; } }
</style>
