---
import { homeContent } from '../../lib/home-content';
import { routeFor, type Lang } from '../../lib/i18n';
import type { ServicesContent } from '../../lib/services-content';

interface Props { hero: ServicesContent['hero']; lang: Lang }
const { hero, lang } = Astro.props;
const shots = homeContent[lang].proof.shots;
const projects = [
  { shot: shots[3], position: 'left' },
  { shot: shots[0], position: 'lead' },
  { shot: shots[1], position: 'right' },
];
---
<section class="services-hero" aria-labelledby="services-heading">
  <div class="wrap">
    <div class="hero-copy">
      <h1 id="services-heading" class="display services-title">
        <span>{hero.lines[0]}</span>
        <span class="hero-muted">{hero.lines[1]}</span>
      </h1>
      <p class="hero-sub">{hero.sub}</p>
      <div class="hero-actions">
        <a href={hero.primary.href} class="btn btn-primary btn-lg">
          {hero.primary.label}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href={hero.secondary.href} class="hero-call">
          <span class="availability-dot" aria-hidden="true"></span>
          {hero.secondary.label}
        </a>
      </div>
      <p class="hero-note">{hero.note}</p>
    </div>

    <div class="project-stage" role="group" aria-label={hero.workLabel}>
      {projects.map(({ shot, position }) => (
        <a
          class={`project-preview project-preview--${position}`}
          href={`${routeFor('cases', lang)}/${shot.slug}`}
          aria-label={`${homeContent[lang].proof.caseLabel}: ${shot.client}`}
        >
          <figure>
            <div class="preview-bar" aria-hidden="true">
              <span class="preview-dots"><i></i><i></i><i></i></span>
              <span class="preview-domain">{shot.domain}</span>
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 12l8-8M4 4h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <img
              src={`/landing/shots/${shot.slug}-1440.webp`}
              width="1440"
              height="900"
              alt={lang === 'de' ? `Website von ${shot.client}` : `${shot.client} website`}
              loading={position === 'lead' ? 'eager' : 'lazy'}
              fetchpriority={position === 'lead' ? 'high' : 'auto'}
              decoding="async"
            />
            <figcaption class="sr-only">{shot.client}</figcaption>
          </figure>
        </a>
      ))}
    </div>
    <div class="work-caption">
      <span>{hero.workLabel}</span>
      <a href={routeFor('cases', lang)}>
        {lang === 'de' ? 'Projekte entdecken' : 'Explore our work'}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services-hero { overflow: clip; padding: 88px 0 48px; }
  .hero-copy { position: relative; z-index: 2; text-align: center; }
  .services-title { margin: 0 auto; font-size: clamp(42px, 5.85vw, 84px); letter-spacing: -0.04em; line-height: 1.04; }
  .services-title span { display: block; }
  .hero-muted { color: var(--fg-muted); }
  .hero-sub { max-width: 640px; margin: 28px auto 30px; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.65; color: var(--fg-muted); text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 18px 28px; }
  .hero-call { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 14px; color: var(--fg-muted); text-underline-offset: 5px; }
  .hero-call:hover { color: var(--fg); text-decoration: underline; }
  .availability-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); }
  .hero-note { margin-top: 18px; font-size: 13px; line-height: 1.6; color: var(--fg-muted); }
  .project-stage { position: relative; max-width: 1176px; height: 506px; margin: 64px auto 0; perspective: 1600px; isolation: isolate; }
  .project-preview { position: absolute; display: block; overflow: hidden; border: 1px solid var(--border-strong); border-radius: 12px; background: var(--bg-elev); transform-origin: center; }
  .project-preview--lead { z-index: 2; top: 0; left: 17%; width: 66%; transform: rotateX(5deg); }
  .project-preview--left { z-index: 1; top: 84px; left: -6%; width: 43%; transform: rotate(-6deg); }
  .project-preview--right { z-index: 1; top: 84px; right: -6%; width: 43%; transform: rotate(6deg); }
  .project-preview:focus-visible { z-index: 3; outline-offset: 5px; }
  .preview-bar { display: flex; align-items: center; justify-content: space-between; height: 34px; gap: 12px; padding: 0 12px; color: var(--fg-muted); background: #141416; }
  .preview-dots { display: inline-flex; gap: 4px; }
  .preview-dots i { width: 6px; height: 6px; border-radius: 50%; background: #64646e; }
  .preview-domain { font-family: var(--font-mono); font-size: 10px; }
  .project-preview img { display: block; width: 100%; height: auto; }
  .work-caption { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 776px; margin: 18px auto 0; font-size: 12px; line-height: 1.6; color: var(--fg-muted); }
  .work-caption a { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; color: var(--fg); text-underline-offset: 4px; }
  .work-caption a:hover { text-decoration: underline; }

  @supports (animation-timeline: view()) {
    @media (min-width: 821px) and (prefers-reduced-motion: no-preference) {
      .project-stage { view-timeline-name: --service-projects; view-timeline-axis: block; }
      .project-preview { animation-duration: 1ms; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --service-projects; animation-range: entry 0% exit 20%; }
      .project-preview--lead { animation-name: project-focus; }
      .project-preview--left { animation-name: project-left; }
      .project-preview--right { animation-name: project-right; }
      @keyframes project-focus { from { transform: translateY(18px) rotateX(7deg); } to { transform: translateY(-12px) rotateX(0deg); } }
      @keyframes project-left { from { transform: translate(20px, 32px) rotate(-7deg); } to { transform: translate(-14px, -16px) rotate(-3deg); } }
      @keyframes project-right { from { transform: translate(-20px, 32px) rotate(7deg); } to { transform: translate(14px, -16px) rotate(3deg); } }
    }
  }
  @media (max-width: 1240px) { .project-stage { height: calc((100vw - 64px) * 0.4125 + 34px); } }
  @media (max-width: 820px) {
    .services-hero { padding-top: 56px; }
    .project-stage { height: auto; margin-top: 44px; perspective: none; }
    .project-preview--lead { position: relative; width: 100%; left: auto; transform: none; }
    .project-preview--left, .project-preview--right { display: none; }
    .work-caption { margin-top: 8px; }
  }
  @media (max-width: 480px) {
    .services-hero { padding: 44px 0 28px; }
    .services-title { font-size: clamp(36px, 9.6vw, 46px); line-height: 1.08; }
    .hero-sub { margin-top: 22px; font-size: 16px; line-height: 1.65; }
    .hero-actions { gap: 8px 18px; }
    .hero-note { font-size: 12px; max-width: 32ch; margin-inline: auto; }
    .work-caption { gap: 12px; font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .project-preview { transform: none; } }
</style>
