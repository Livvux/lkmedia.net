---
import Base from '../../layouts/Base.astro';
import WorkflowDiagram from './WorkflowDiagram.astro';
import ContactForm from '../ContactForm.astro';
import { routeFor, type Lang } from '../../lib/i18n';
import { breadcrumbs, faqPage, service } from '../../lib/schema';
import type { ServicePage } from '../../lib/service-pages/types';

interface Props { page: ServicePage; lang: Lang }
const { page: p, lang } = Astro.props;
const path = routeFor(p.route, lang);
const seo = { ...p.seo, canonical: path, lang };
const home = { name: lang === 'en' ? 'Home' : 'Startseite', url: routeFor('home', lang) };
const name = p.hero.title.join(' ');
const jsonLd = [
  service({ name, description: p.seo.description, url: path, lang }),
  breadcrumbs([home, { name: p.hero.label, url: path }]),
  faqPage(p.faq.items),
];
const two = (n: number) => String(n + 1).padStart(2, '0');
const t = lang === 'en'
  ? { crumbs: 'Breadcrumb', case: 'Read the case study', german: 'in German', problem: 'The problem', solution: 'Our approach', deliverables: 'What you get', useCases: 'Use cases', process: 'Process', pricing: 'Pricing', proof: 'Proof', faq: 'Questions', next: 'What happens next' }
  : { crumbs: 'Brotkrumen', case: 'Zum Projekt', german: '', problem: 'Das Problem', solution: 'Der Ansatz', deliverables: 'Was Sie bekommen', useCases: 'Anwendungsfälle', process: 'Ablauf', pricing: 'Preis', proof: 'Belege', faq: 'Fragen', next: 'So geht es weiter' };
---
<Base seo={seo} jsonLd={jsonLd}>
  <div class="sd">
    <header class="sd-hero wrap">
      <nav aria-label={t.crumbs} class="crumbs">
        <a href={home.url}>{home.name}</a><span aria-hidden="true">/</span><span aria-current="page">{p.hero.label}</span>
      </nav>
      <div class="sd-hero-grid">
        <div>
          <p class="label">{p.hero.label}</p>
          <h1 class="display">{p.hero.title[0]} <span class="quiet">{p.hero.title[1]}</span></h1>
          <p class="lede">{p.hero.lede}</p>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href="#anfrage">{p.hero.primary}</a>
            <a class="btn btn-ghost btn-lg" href={p.hero.secondary.href}>{p.hero.secondary.label}</a>
          </div>
        </div>
        <div class="specimen">
          {p.route === 'ai' ? <div class="workflow"><WorkflowDiagram lang={lang} /></div> : (
            <a class="sample" href={p.route === 'wordpress' ? '/cases/streamerloft' : '/cases/eichhoernchenberger'} hreflang="de">
              <img src={p.route === 'wordpress' ? '/cases/streamerloft.webp' : '/cases/eichhoernchenberger/desktop.webp'} width="1200" height="630" alt="" />
              <span>{p.route === 'wordpress' ? 'StreamerLoft' : 'Eichhörnchen Berger'} · {lang === 'en' ? 'Case study (DE)' : 'Projekt ansehen'} ↗</span>
            </a>
          )}
          <dl class="sheet">
          {p.hero.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>
        </div>
      </div>
      <slot name="visual" />
    </header>

    <section class="paper section" aria-labelledby="sd-problem">
      <div class="wrap split">
        <p class="label">{t.problem}</p>
        <div>
          <h2 id="sd-problem" class="section-title">{p.problem.title}</h2>
          <p class="lede">{p.problem.intro}</p>
          <ul class="rows">
            {p.problem.points.map((x) => <li><h3>{x.title}</h3><p>{x.body}</p></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="sd-solution">
      <div class="wrap split">
        <p class="label">{t.solution}</p>
        <div>
          <h2 id="sd-solution" class="section-title">{p.solution.title}</h2>
          <p class="lede">{p.solution.intro}</p>
        </div>
      </div>
      <div class="wrap split deliver">
        <p class="label">{t.deliverables}</p>
        <div>
          <h2 class="sub-title">{p.deliverables.title}</h2>
          <ol class="numbered">
            {p.deliverables.items.map((x, i) => <li><span class="n" aria-hidden="true">{two(i)}</span><h3>{x.title}</h3><p>{x.body}</p></li>)}
          </ol>
        </div>
      </div>
      <slot />
    </section>

    <section class="paper section" aria-labelledby="sd-cases">
      <div class="wrap split">
        <p class="label">{t.useCases}</p>
        <div>
          <h2 id="sd-cases" class="section-title">{p.useCases.title}</h2>
          <p class="lede">{p.useCases.intro}</p>
          <ul class="tiles">
            {p.useCases.items.map((x) => <li><h3>{x.title}</h3><p>{x.body}</p></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="sd-process">
      <div class="wrap split">
        <p class="label">{t.process}</p>
        <div>
          <h2 id="sd-process" class="section-title">{p.process.title}</h2>
          <ol class="steps">
            {p.process.steps.map((x, i) => <li><span class="n" aria-hidden="true">{two(i)}</span><h3>{x.title}</h3><p>{x.body}</p></li>)}
          </ol>
        </div>
      </div>
      <div class="wrap split pricing">
        <p class="label">{t.pricing}</p>
        <div class="price-box">
          <h2 class="sub-title">{p.pricing.title}</h2>
          <p>{p.pricing.body}</p>
          <ul>{p.pricing.points.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="paper section" aria-labelledby="sd-proof">
      <div class="wrap split">
        <p class="label">{t.proof}</p>
        <div>
          <h2 id="sd-proof" class="section-title">{p.proof.title}</h2>
          <p class="lede">{p.proof.intro}</p>
          <ul class="proof">
            {p.proof.items.map((x) => (
              <li>
                <h3>{x.client}</h3>
                <p>{x.body}</p>
                <a class="mono-link" href={x.href} hreflang={x.hrefLang}>{x.linkLabel ?? t.case}<span class="sr-only">: {x.client}</span>{x.hrefLang && x.hrefLang !== lang && t.german ? ` (${t.german})` : ''} <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="sd-faq">
      <div class="wrap split">
        <p class="label">{t.faq}</p>
        <div>
          <h2 id="sd-faq" class="section-title">{p.faq.title}</h2>
          <div class="faq">
            {p.faq.items.map((x) => <details><summary>{x.q}</summary><p>{x.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>

    <section id="anfrage" class="section sd-cta" aria-labelledby="sd-cta">
      <div class="wrap cta-grid">
        <div>
          <h2 id="sd-cta" class="section-title">{p.cta.title}</h2>
          <p class="lede">{p.cta.body}</p>
          <p class="label next-label">{t.next}</p>
          <ol class="next">{p.cta.next.map((x, i) => <li><span class="n" aria-hidden="true">{two(i)}</span>{x}</li>)}</ol>
        </div>
        <div class="form-card">
          <h3>{p.cta.formTitle}</h3>
          <ContactForm lang={lang} source={path} service={p.service} />
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sd h3 { font-size: 19px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
  .sd li p, .price-box p, .faq p { color: var(--fg-muted); font-size: 16px; line-height: 1.6; }
  .n { font-family: var(--font-mono); font-size: 12px; color: var(--signal); letter-spacing: .06em; }
  .crumbs { display: flex; gap: 10px; font-family: var(--font-mono); font-size: 12px; color: var(--fg-dim); }
  .crumbs a { color: var(--fg-muted); } .crumbs a:hover { color: var(--fg); }
  .sd-hero { padding-block: 28px clamp(64px, 8vw, 112px); }
  .sd-hero-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr); gap: 56px; align-items: end; margin-top: clamp(40px, 6vw, 80px); }
  .sd-hero .display { margin-top: 22px; font-size: clamp(40px, 5.6vw, 76px); }
  .sd-hero .lede { margin-top: 26px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .sd-hero .display .quiet { font-style:normal; font-weight:inherit; color:var(--fg-muted); }
  .sample, .workflow { display:block; }
  .sample img { display:block; width:100%; height:auto; aspect-ratio:2/1; object-fit:cover; object-position:top; }
  .sample span { display:block; padding:10px 14px; color:var(--fg); background:var(--bg-card); font:12px/1.5 var(--font-mono); }
  .sheet { border-top: 1px solid var(--border-strong); }
  .sheet div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding-block: 14px; border-bottom: 1px solid var(--border); font-size: 14px; }
  .sheet dt { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-dim); padding-top: 2px; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 32px; }
  .split > .label { align-self: start; padding-top: 14px; }
  .split .lede { margin-top: 22px; }
  .deliver, .pricing { margin-top: clamp(64px, 8vw, 104px); }
  .sub-title { font-size: clamp(24px, 2.4vw, 32px); font-weight: 500; letter-spacing: -.03em; line-height: 1.15; }
  .rows { margin-top: 44px; border-top: 1px solid var(--border-strong); }
  .rows li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 24px; padding-block: 22px; border-bottom: 1px solid var(--border); }
  .numbered { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; margin-top: 32px; border-top: 1px solid var(--border-strong); }
  .numbered li { display: grid; gap: 8px; padding-block: 24px; border-bottom: 1px solid var(--border); align-content: start; }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 44px; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--border); }
  .tiles li { display: grid; gap: 10px; align-content: start; padding: 28px; background: var(--bg); }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; margin-top: 44px; }
  .steps li { display: grid; gap: 10px; align-content: start; padding-top: 18px; border-top: 1px solid var(--border-strong); }
  .price-box { padding: clamp(24px, 3vw, 40px); border: 1px solid var(--border-strong); border-radius: 20px; background: var(--bg-elev); }
  .price-box p { max-width: 62ch; margin-top: 14px; }
  .price-box ul { display: grid; gap: 10px; margin-top: 22px; font-size: 15px; }
  .price-box li { display: grid; grid-template-columns: 22px 1fr; }
  .price-box li::before { content: "→"; color: var(--signal); }
  .proof { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; margin-top: 44px; }
  .proof li { display: grid; gap: 10px; align-content: start; padding-top: 18px; border-top: 1px solid var(--border-strong); }
  .proof .mono-link { margin-top: 6px; min-height: 44px; color: var(--signal); }
  .faq { margin-top: 36px; border-top: 1px solid var(--border-strong); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary { display: flex; justify-content: space-between; gap: 24px; padding-block: 20px; font-size: 18px; font-weight: 500; letter-spacing: -.015em; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-family: var(--font-mono); color: var(--signal); transition: transform 180ms var(--ease-out); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { max-width: 68ch; padding-bottom: 22px; }
  .sd-cta { border-top: 1px solid var(--border); background: var(--bg-elev); scroll-margin-top: 72px; }
  .cta-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; align-items: start; }
  .cta-grid .lede { margin-top: 20px; }
  .next-label { margin-top: 40px; }
  .next { display: grid; gap: 12px; margin-top: 16px; color: var(--fg-muted); font-size: 15px; }
  .next li { display: grid; grid-template-columns: 34px 1fr; align-items: baseline; }
  .form-card { padding: clamp(22px, 3vw, 36px); border: 1px solid var(--border); border-radius: 20px; background: var(--bg); }
  .form-card h3 { margin-bottom: 22px; font-size: 22px; }
  @media (max-width: 900px) {
    .sd-hero-grid, .split, .cta-grid { grid-template-columns: 1fr; }
    .split > .label { padding-top: 0; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .rows li, .numbered, .tiles, .steps { grid-template-columns: 1fr; }
    .rows li { gap: 8px; }
    .tiles li { padding: 22px; }
    .form-card { padding: 0; border: 0; background: none; }
  }
</style>
