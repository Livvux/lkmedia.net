---
interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---
<nav aria-label="Abschnitte" class="rounded-xl border border-black/10 dark:border-white/15 p-5">
  <p class="text-sm text-black/60 dark:text-white/60">
    {sections.length} Abschnitte · Dauer ca. 15 Minuten · Ihre Eingaben bleiben auf diesem Gerät gespeichert.
  </p>
  <ol class="mt-3 grid sm:grid-cols-2 gap-x-6">
    {sections.map((s, i) => (
      <li>
        <a href={`#${s.id}`} class="flex min-h-11 items-center gap-3 underline-offset-4 hover:underline">
          <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-black/30 dark:border-white/30 text-sm" aria-hidden="true">{i + 1}</span>
          {s.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
