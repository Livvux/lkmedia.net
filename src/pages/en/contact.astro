---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import CalEmbed from '../../components/CalEmbed.astro';
import '../../styles/contact.css';
const seo = {
  title: 'Contact',
  description: 'Tell us about your WordPress, AI or web development project. Send a short inquiry or book a free 15-minute call with Lucas.',
  canonical: '/en/contact',
  lang: 'en' as const,
};
const calLink = import.meta.env.PUBLIC_CAL_LINK ?? 'lucas-lkmedia/15min';
---
<Base seo={seo}>
  <header class="contact-cover paper">
    <div class="wrap">
      <p class="label">Contact · lk media</p>
      <h1>What would you like to <em>build?</em></h1>
      <p class="contact-intro">Tell me about your website or a task you would like to automate. A few sentences are enough to start.</p>
    </div>
  </header>
  <section class="contact-page wrap">
    <div class="contact-options">
      <div class="contact-form" id="anfrage">
        <h2>Project inquiry</h2>
        <ContactForm lang="en" />
      </div>
      <aside id="termin" class="contact-calendar">
        <h2>15-minute call</h2>
        <p>The first call is free. We clarify your goal and whether working together makes sense.</p>
        <CalEmbed calLink={calLink} label="Book a call" />
        <ol class="next">
          <li>You send a short inquiry or book a call.</li>
          <li>We agree on scope and you receive a fixed-price quote.</li>
          <li>Work starts only after you approve it in writing.</li>
        </ol>
      </aside>
    </div>
  </section>
</Base>
