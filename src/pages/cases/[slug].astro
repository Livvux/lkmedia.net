---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const nicheLabel: Record<string, string> = {
  anwaelte: 'Kanzlei',
  'luxus-immobilien': 'Luxus-Immobilien',
  privatkliniken: 'Privatklinik',
  fintech: 'Fintech',
  other: 'Premium',
  tierschutz: 'Tierschutz',
  gaming: 'Gaming',
  creator: 'Creator',
};
const seo = {
  title: entry.data.title,
  description: entry.data.summary,
  canonical: `/cases/${entry.id}`,
  lang: 'de' as const,
  ogImage: entry.data.heroImage,
  alternateUrls: {
    de: `https://lkmedia.net/cases/${entry.id}`,
    en: `https://lkmedia.net/en/cases/${entry.id}`,
  },
};
const bc = breadcrumbs([
  { name: 'Home', url: 'https://lkmedia.net/' },
  { name: 'Cases', url: 'https://lkmedia.net/cases' },
  { name: entry.data.title, url: `https://lkmedia.net/cases/${entry.id}` },
]);
---
<Base seo={seo} jsonLd={[bc]}>
  <article class="max-w-3xl mx-auto px-6 py-32">
    <nav class="text-sm text-black/50 dark:text-white/50 mb-8"><a href="/cases">← Cases</a></nav>
    <div class="text-sm uppercase tracking-wider text-black/50 dark:text-white/50">{nicheLabel[entry.data.niche] ?? entry.data.niche} · {entry.data.client}</div>
    <h1 class="text-4xl md:text-6xl font-semibold tracking-tight mt-3">{entry.data.title}</h1>
    <p class="text-xl text-black/70 dark:text-white/70 mt-6">{entry.data.summary}</p>
    {entry.data.website && (
      <a href={entry.data.website} target="_blank" rel="noopener noreferrer" class="inline-flex mt-6 text-sm font-medium underline underline-offset-4">Projektwebsite ansehen (neuer Tab) ↗</a>
    )}
    <img src={entry.data.heroImage} alt={entry.data.title} class="mt-10 w-full aspect-[16/9] object-cover rounded-2xl bg-black/5 dark:bg-white/5" />
    <div class="mt-12 prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</Base>
