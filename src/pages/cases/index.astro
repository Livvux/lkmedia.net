---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const all = await getCollection('cases');
const cases = all.sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const nicheLabel: Record<string, string> = {
  anwaelte: 'Kanzlei',
  'luxus-immobilien': 'Luxus-Immobilien',
  privatkliniken: 'Privatklinik',
  fintech: 'Fintech',
  other: 'Premium',
  tierschutz: 'Tierschutz',
  gaming: 'Gaming',
  creator: 'Creator',
};
const seo = {
  title: 'Webdesign-Referenzen & SEO-Ergebnisse',
  description: 'Cases: Websites, SEO-Projekte und digitale Plattformen für Unternehmen, Tierschutz und Creator.',
  canonical: '/cases',
  lang: 'de' as const,
};
---
<Base seo={seo}>
  <section class="case-index wrap">
    <p class="eyebrow">Ausgewählte Arbeiten</p>
    <h1 class="case-title">Webdesign-Referenzen & SEO-Ergebnisse.</h1>
    <p class="case-intro">Websites, Plattformen und SEO-Projekte. Ein Einblick in die Aufgaben, die Umsetzung und die Menschen dahinter.</p>
    <ul class="case-grid">
      {cases.map((c) => (
        <li><a href={`/cases/${c.id}`} class="group block">
          <div class="aspect-[16/9] rounded-3xl overflow-hidden bg-black/5 dark:bg-white/5">
            <img src={c.data.heroImage} alt={c.data.title} width="1440" height="810" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300 motion-reduce:transform-none" loading="lazy" decoding="async" />
          </div>
          <div class="mt-4 text-sm uppercase tracking-wider text-black/50 dark:text-white/50">{nicheLabel[c.data.niche] ?? c.data.niche}</div>
          <h2 class="text-2xl font-medium mt-2 tracking-tight">{c.data.title}</h2>
          <div class="text-black/60 dark:text-white/60 mt-1">{c.data.summary}</div>
        </a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .case-index { padding-block: clamp(64px, 8vw, 112px) 112px; }
  .case-title { max-width: 18ch; margin-top: 22px; font-size: clamp(40px, 5.8vw, 76px); line-height: 1.08; font-weight: 600; letter-spacing: -0.05em; }
  .case-intro { max-width: 56ch; margin-top: 24px; color: var(--fg-muted); font-size: 19px; line-height: 1.7; }
  .case-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 32px; margin-top: 56px; }
  @media (max-width: 640px) { .case-grid { grid-template-columns: 1fr; gap: 40px; } }
</style>
