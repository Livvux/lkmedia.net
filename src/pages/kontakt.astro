---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import CalEmbed from '../components/CalEmbed.astro';
const seo = {
  title: 'Kontakt',
  description: 'Website-Projekt oder SEO für Ihre bestehende Website besprechen. Kurze Anfrage oder kostenloser 15-Minuten-Call mit Lucas aus Rastatt.',
  canonical: '/kontakt',
  lang: 'de' as const,
};
const calLink = import.meta.env.PUBLIC_CAL_LINK ?? 'lucas-lkmedia/15min';
---
<Base seo={seo}>
  <section class="py-32 px-6 max-w-3xl mx-auto">
    <h1 class="text-5xl md:text-7xl font-semibold tracking-tight">Kontakt.</h1>
    <p class="mt-6 text-xl text-black/70 dark:text-white/70">Erzählen Sie kurz, was Ihre Website leisten soll. Wir besprechen eine neue Website oder die SEO-Optimierung Ihres bestehenden Auftritts, auch wenn ihn ein anderer Anbieter erstellt hat.</p>
    <p class="mt-4 text-black/70 dark:text-white/70">Die <a href="/leistungen" class="underline underline-offset-4">Branchenpakete mit Leistungen und Gesamtkosten</a> können Sie vorab vergleichen. Individuelle Website-Projekte beginnen bei 25.000 €. Für <a href="/seo-rastatt" class="underline underline-offset-4">SEO-Analysen und Optimierungen bestehender Websites</a> vereinbaren wir Umfang und Preis separat. Die Website-Preisuntergrenze gilt dafür nicht.</p>
    <div class="mt-16 grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-medium">Projektanfrage</h2>
        <div class="mt-6"><ContactForm lang="de" /></div>
      </div>
      <div id="termin">
        <h2 class="text-2xl font-medium">15-Minuten-Call</h2>
        <p class="mt-3 text-sm text-black/60 dark:text-white/60">Das Erstgespräch ist kostenlos. Darin klären wir Ihr Anliegen und ob eine Zusammenarbeit passt.</p>
        <CalEmbed calLink={calLink} label="Call buchen" />
      </div>
    </div>
  </section>
</Base>
