---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import CalEmbed from '../components/CalEmbed.astro';
import '../styles/contact.css';
const seo = {
  title: 'Kontakt',
  description: 'Website, WordPress-Projekt oder KI-Integration besprechen. Kurze Anfrage oder kostenloser 15-Minuten-Call mit Lucas aus Rastatt.',
  canonical: '/kontakt',
  lang: 'de' as const,
};
const calLink = import.meta.env.PUBLIC_CAL_LINK ?? 'lucas-lkmedia/15min';
---
<Base seo={seo}>
  <header class="contact-cover paper">
    <div class="wrap">
      <p class="label">Kontakt · lk media</p>
      <h1>Was haben Sie <em>vor?</em></h1>
      <p class="contact-intro">Erzählen Sie mir von Ihrer Website oder einem Ablauf, den Sie automatisieren möchten. Für den Anfang reichen ein paar Sätze.</p>
    </div>
  </header>
  <section class="contact-page wrap">
    <div class="contact-options">
      <div class="contact-form" id="anfrage">
        <h2 class="text-2xl font-medium">Projektanfrage</h2>
        <div class="mt-6"><ContactForm lang="de" /></div>
      </div>
      <aside id="termin" class="contact-calendar">
        <h2 class="text-2xl font-medium">15-Minuten-Call</h2>
        <p class="mt-3 text-sm" style="color:var(--fg-muted)">Das Erstgespräch ist kostenlos. Darin klären wir Ihr Anliegen und ob eine Zusammenarbeit passt.</p>
        <CalEmbed calLink={calLink} label="Call buchen" />
      </aside>
    </div>
    <p class="contact-context">Für <a href="/wordpress" class="underline underline-offset-4">WordPress</a>, <a href="/ki-automatisierung" class="underline underline-offset-4">KI & Automation</a> und <a href="/webentwicklung" class="underline underline-offset-4">Webentwicklung</a> erhalten Sie nach dem Erstgespräch ein Festpreisangebot. Die <a href="/leistungen" class="underline underline-offset-4">Branchenpakete mit Leistungen und Gesamtkosten</a> können Sie vorab vergleichen. Individuelle Website-Projekte beginnen bei 25.000 €. Für <a href="/seo-rastatt" class="underline underline-offset-4">SEO-Analysen und Optimierungen bestehender Websites</a> vereinbaren wir Umfang und Preis separat. Die Website-Preisuntergrenze gilt dafür nicht.</p>
  </section>
</Base>
