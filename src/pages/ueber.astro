---
import Base from '../layouts/Base.astro';
import { routeFor } from '../lib/i18n';

const seo = {
  title: 'Über Lucas',
  description: 'Lucas Kleipoedszus, Gründer von lkmedia in Rastatt: Websites, WordPress-Lösungen und KI-Systeme, die Unternehmen im Alltag weiterbringen.',
  canonical: '/ueber',
  lang: 'de' as const,
};

const credentials = [
  '10+ Jahre Webentwicklung',
  'Websites, WordPress und KI-Systeme aus einer Hand',
  'Werkzeug nach Aufgabe: WordPress, Astro, TypeScript',
  'SEO-Projekte mit Organic-Traffic-Wachstum',
  'Core Web Vitals und Barrierefreiheit im Blick',
  'Code und Texte selbst geschrieben',
];

const services = [
  { label: 'WordPress-Entwicklung', href: routeFor('wordpress', 'de') },
  { label: 'KI & Automatisierung', href: routeFor('ai', 'de') },
  { label: 'Webentwicklung', href: routeFor('development', 'de') },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lucas Kleipoedszus',
  jobTitle: 'Gründer & Entwickler',
  url: 'https://lkmedia.net/ueber',
  email: 'lucas@lkmedia.net',
  image: 'https://lkmedia.net/ueber/portrait.webp',
  worksFor: { '@type': 'Organization', name: 'lkmedia' },
  knowsAbout: ['Webentwicklung', 'WordPress', 'KI-Automatisierung', 'SEO', 'Core Web Vitals', 'TypeScript'],
  sameAs: ['https://github.com/livvux'],
};
---
<Base seo={seo} jsonLd={[person]}>
  <section class="pt-20 md:pt-28 pb-12 px-6 max-w-4xl mx-auto">
    <p class="eyebrow mb-6">Entwicklung aus Rastatt</p>
    <h1 class="text-5xl md:text-7xl font-semibold tracking-tight mb-6">Ich bin Lucas.</h1>
    <p class="text-xl md:text-2xl text-black/70 dark:text-white/70 leading-relaxed max-w-2xl">
      Ich baue Websites, WordPress-Lösungen und praktische KI-Systeme, die Unternehmen im Alltag weiterbringen.
    </p>
  </section>

  <section class="py-12 px-6 max-w-4xl mx-auto">
    <div class="aspect-[4/3] w-full max-w-2xl rounded-3xl overflow-hidden bg-black/5 dark:bg-white/5">
      <img src="/ueber/portrait.webp" alt="Portrait Lucas Kleipoedszus" width="600" height="600" class="w-full h-full object-cover" decoding="async" />
    </div>
  </section>

  <section class="py-16 px-6 max-w-4xl mx-auto space-y-6 text-lg md:text-xl text-black/80 dark:text-white/80 leading-relaxed">
    <p>
      Mein Name ist Lucas Kleipoedszus. Ich bin Full-Stack-Entwickler mit einem Hintergrund in SEO und Marketing und baue seit 2015 Websites. Mich interessiert, ob eine Website ihre Aufgabe im Geschäft erfüllt: Anfragen bringen, Abläufe vereinfachen, schnell laden.
    </p>
    <p>
      Ich arbeite mit Kanzleien, Immobilienmaklern und Kliniken ebenso wie mit Handwerksbetrieben, Fahrschulen und Vereinen. Das Werkzeug richtet sich nach der Aufgabe: WordPress, wenn Ihr Team Inhalte selbst pflegt. Astro und eigener Code, wenn es auf Ladezeit oder besondere Abläufe ankommt. KI und Automatisierung, wo sich wiederkehrende Arbeit abnehmen lässt, mit einem Menschen, der freigibt.
    </p>
    <p>
      Ich schreibe den Code und die Texte selbst. Kein Outsourcing, kein Whitelabel-Team im Hintergrund: Vom ersten Gespräch bis zum Launch sprechen Sie mit dem Menschen, der Ihr Projekt baut.
    </p>
  </section>

  <section class="py-16 px-6 max-w-4xl mx-auto border-t border-black/10 dark:border-white/10">
    <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-10">Erfahrung & Arbeitsweise</h2>
    <ul class="space-y-4">
      {credentials.map((c) => (
        <li class="flex items-start gap-4 text-lg md:text-xl text-black/80 dark:text-white/80">
          <span class="text-black/60 dark:text-white/60 mt-1">—</span>
          <span>{c}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="py-16 px-6 max-w-4xl mx-auto border-t border-black/10 dark:border-white/10" aria-labelledby="ueber-leistungen">
    <h2 id="ueber-leistungen" class="text-3xl md:text-4xl font-semibold tracking-tight mb-10">Leistungen</h2>
    <ul class="space-y-2">
      {services.map((s) => (
        <li>
          <a href={s.href} class="inline-flex min-h-11 items-center gap-3 text-lg md:text-xl underline underline-offset-4">
            {s.label} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="py-24 px-6 max-w-4xl mx-auto border-t border-black/10 dark:border-white/10">
    <div class="text-black/60 dark:text-white/60 text-sm tracking-widest mb-6">KONTAKT</div>
    <a href="mailto:lucas@lkmedia.net" class="block break-words text-2xl md:text-4xl font-semibold tracking-tight hover:text-black/70 dark:text-white/70 transition-colors">
      Direkte Anfrage: lucas@lkmedia.net
    </a>
  </section>
</Base>
