---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { blogPostUrl, blogTopicIds, blogTopics } from '../../lib/blog-topics';

const posts = (await getCollection('posts', (p) => p.data.lang === 'de' && !p.data.draft && !p.data.noindex))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);

const groups = blogTopicIds
  .map((id) => ({ id, ...blogTopics[id], posts: posts.filter((post) => post.data.topic === id) }))
  .filter((group) => group.posts.length > 0);
const otherPosts = posts.filter((post) => !post.data.topic);

const seo = {
  title: 'SEO, Webdesign & Marketing: Ratgeber',
  description: 'Praxiswissen zu Webdesign, lokalem SEO und Marketing: Kosten, Funktionen und Strategien für Kanzleien, Praxen, Handwerker und Fahrschulen.',
  canonical: '/blog',
  lang: 'de' as const,
};
---
<Base seo={seo}>
  <div class="wrap pb-24 pt-28 md:pt-36">
    <header class="max-w-4xl">
      <p class="eyebrow">Blog / Praxiswissen</p>
      <h1 class="mt-5 text-5xl font-semibold leading-[1.05] tracking-tight md:text-7xl">
        SEO, Webdesign & Marketing.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/65">
        Wissen, nach Themen geordnet: Entscheidungen rund um Websites, SEO und Marketing. Konkrete Fragen, reale
        Projektkontexte und transparente Grenzen statt austauschbarer SEO-Texte.
      </p>
    </header>

    <nav aria-label="Themen im Blog" class="mt-12 flex flex-wrap gap-2">
      {groups.map((group) => (
        <a href={`#${group.id}`} class="rounded-full border border-white/15 px-4 py-2 text-sm text-white/75 transition-colors hover:border-white/40 hover:text-white">
          {group.title}
        </a>
      ))}
    </nav>

    <div class="mt-16">
      {groups.map((group) => (
        <section id={group.id} class="scroll-mt-24 border-t border-white/15 py-12 md:py-16" aria-labelledby={`heading-${group.id}`}>
          <div class="grid gap-9 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-4">
              <h2 id={`heading-${group.id}`} class="text-3xl font-semibold tracking-tight">{group.title}</h2>
              <p class="mt-3 max-w-md leading-relaxed text-white/60">{group.description}</p>
              {group.offer && (
                <a href={group.offer.href} class="mt-5 inline-block text-sm font-medium text-white underline underline-offset-4 decoration-white/40 hover:decoration-white">
                  {group.offer.label} →
                </a>
              )}
            </div>
            <ul class="divide-y divide-white/10 lg:col-span-8">
              {group.posts.map((post) => (
                <li class="py-5 first:pt-0">
                  <a href={blogPostUrl(post)} class="group block">
                    <time datetime={(post.data.updatedDate ?? post.data.pubDate).toISOString()} class="text-xs text-white/45">
                      {post.data.updatedDate ? 'Aktualisiert' : 'Veröffentlicht'}: {(post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)}
                    </time>
                    <h3 class="mt-2 text-xl font-medium leading-snug group-hover:underline md:text-2xl">{post.data.title}</h3>
                    <p class="mt-2 max-w-2xl leading-relaxed text-white/60">{post.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}

      {otherPosts.length > 0 && (
        <section class="border-t border-white/15 py-12 md:py-16" aria-labelledby="weitere-beitraege">
          <div class="grid gap-9 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-4">
              <h2 id="weitere-beitraege" class="text-3xl font-semibold tracking-tight">Weitere Einblicke</h2>
              <p class="mt-3 max-w-md leading-relaxed text-white/60">
                Einzelne technische und persönliche Beiträge, die keine eigene Themenreihe benötigen.
              </p>
            </div>
            <ul class="divide-y divide-white/10 lg:col-span-8">
              {otherPosts.map((post) => (
                <li class="py-5 first:pt-0">
                  <a href={blogPostUrl(post)} class="group block">
                    <time datetime={(post.data.updatedDate ?? post.data.pubDate).toISOString()} class="text-xs text-white/45">
                      {post.data.updatedDate ? 'Aktualisiert' : 'Veröffentlicht'}: {(post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)}
                    </time>
                    <h3 class="mt-2 text-xl font-medium leading-snug group-hover:underline md:text-2xl">{post.data.title}</h3>
                    <p class="mt-2 max-w-2xl leading-relaxed text-white/60">{post.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
