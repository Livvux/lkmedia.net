---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/landing/Hero.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { DOCWEB } from '../../lib/docweb';

const seo = {
  title: 'docweb — Website für Arztpraxen zum Festpreis',
  description: `Website für Arztpraxen, Psychotherapie und Zahnärzte: ohne Datensammeln, Server in der EU, mit Terminkalender. ${DOCWEB.setupPrice} Einrichtung + ${DOCWEB.monthlyPrice}/Monat inkl. USt.`,
  canonical: '/docweb',
  lang: 'de' as const,
  alternateUrls: { de: 'https://lkmedia.net/docweb' },
};

const features = [
  { title: 'Terminkalender Ihrer Praxis', body: 'Der Knopf „Termin buchen“ steht auf jeder Seite und öffnet den Kalender Ihrer Praxis bei Ihrem Kalender-Dienst, zum Beispiel Doctolib oder samedi. Dort wählen Patienten einen freien Termin. Wir verbinden den Kalender und prüfen vor dem Start, dass er sich öffnet und freie Termine zeigt. Telefon und E-Mail bleiben immer sichtbar.' },
  { title: 'Für alle verständlich', body: 'Kurze Sätze und Alltagswörter; Fachbegriffe erklären wir direkt im Text. Die Gestaltung richtet sich nach dem Standard für barrierefreie Websites (WCAG 2.2 AA): gut lesbare Schrift, starke Kontraste, Bedienung auch ohne Maus. Ob die fertige Seite den Standard ganz erfüllt, lässt sich erst an der fertigen Praxiswebsite prüfen.' },
  { title: 'Keine Datensammler', body: 'Keine eingebetteten Statistik- oder Kartendienste, Schriften liegen auf unserem Server und es gibt standardmäßig kein Kontaktformular. Der Terminkalender öffnet sich bei Ihrem Kalender-Dienst, sobald Patienten auf „Termin buchen“ klicken.' },
  { title: 'Immer aktuell', body: 'Die Anzeige „Jetzt geöffnet“ kennt die Feiertage Ihres Bundeslands und Ihren eingetragenen Urlaub und zeigt dann „Heute geschlossen“. Alle 3 Monate prüfen wir Ihre Seite von uns aus auf veraltete Angaben und schicken Ihnen eine kurze Nachricht.' },
  { title: 'Gut gefunden werden', body: 'Praxisdaten, Arztprofile, Leistungen und Öffnungszeiten stellen wir klar dar. Zusätzlich hinterlegen wir sie so, dass Suchmaschinen sie leichter einordnen können.' },
  { title: 'Rechtstexte für Heilberufe', body: 'Impressum mit den Angaben zu Beruf und Kammer, Datenschutzerklärung und Erklärung zur Barrierefreiheit bereiten wir als Entwurf vor. Sie prüfen die Angaben und geben sie vor der Veröffentlichung frei.' },
];

const audiences = [
  { title: 'Arztpraxen', body: 'Hausärzte, Fachärzte und MVZ. Bei mehreren Standorten klären wir den Umfang vor der Bestellung gemeinsam.' },
  { title: 'Psychotherapie', body: 'Psychologische und ärztliche Psychotherapeuten, Kinder- und Jugendlichentherapie.' },
  { title: 'Zahnarztpraxen', body: 'Zahnärzte und Kieferorthopäden.' },
];

const steps = [
  { n: '01', title: 'Paket bestellen', body: `Bei der Bestellung zahlen Sie ${DOCWEB.initialPrice} für die Einrichtung und den ersten Monat. Die Mindestlaufzeit beginnt mit der Bestellung.` },
  { n: '02', title: 'Praxisdaten eintragen', body: 'Praxis, Team, Leistungen, Öffnungszeiten, Urlaub und Link zu Ihrem Terminkalender. Logo und Fotos laden Sie direkt im Formular hoch.' },
  { n: '03', title: 'Vorschau ansehen', body: `${DOCWEB.deliveryPromise} Eine Korrekturschleife ist enthalten.` },
  { n: '04', title: 'Website geht online', body: 'Wir prüfen, dass Ihr Terminkalender freie Termine zeigt, und schalten Ihre Internetadresse (Domain) auf. Betrieb und Updates übernehmen wir, kleine Änderungen stellen Sie über Ihren Änderungs-Link ein.' },
];

const included = [
  'Website mit Ihren Inhalten, Ihrem Logo und Ihrer Farbe',
  'Seiten: Start, Leistungen, Team, Praxis, Kontakt, Häufige Fragen, Ratgeber',
  'Terminknopf mit Anbindung an den Kalender Ihrer Praxis – von uns eingerichtet und getestet',
  'Öffnungszeiten mit Feiertagen und Urlaub, Prüfung auf veraltete Angaben alle 3 Monate',
  'Impressum, Datenschutz und Erklärung zur Barrierefreiheit (als Entwurf zur Freigabe)',
  'Eine Korrekturschleife nach der Vorschau',
  'Betrieb auf Servern in der EU, verschlüsselte Verbindung, Sicherungen und technische Updates',
  'Bis zu 30 Minuten kleine Änderungen pro Monat, nicht übertragbar',
  'Hilfe per E-Mail an Werktagen',
  'Einrichtung auf Ihrer Internetadresse (Domain); Domainkosten extra',
];

const preparation = [
  { title: 'Praxis und Kontakt', body: 'Praxisname, Fachrichtung, Anschrift, Telefon, E-Mail, Öffnungs- und Sprechzeiten und geplanter Urlaub. Dazu der Link zum Kalender Ihrer Praxis bei Ihrem Kalender-Dienst (nicht dessen Startseite) und Hinweise zur Anfahrt.' },
  { title: 'Team und Leistungen', body: 'Namen, Titel und Schwerpunkte Ihres Teams, eine Liste Ihrer Leistungen mit kurzen Erklärungen und häufige Patientenfragen. Wir bereiten Ihre Angaben für die Website auf.' },
  { title: 'Logo, Fotos und Domain', body: 'Ihr Logo sowie vorhandene Fotos von Team und Praxis, für die Sie die Nutzungsrechte besitzen. Dazu Ihre Wunsch-Internetadresse (Domain) oder die bestehende und den bisherigen Anbieter. Bilder laden Sie nach dem Kauf direkt im Formular hoch.' },
  { title: 'Berufsrechtliche Angaben', body: 'Zuständige Kammer, gegebenenfalls Kassenärztliche oder Kassenzahnärztliche Vereinigung, Berufsbezeichnung mit dem Staat, der sie verliehen hat, und Angaben zur Berufshaftpflicht.' },
];

const faqs = [
  { q: 'Was kostet docweb?', a: `${DOCWEB.setupPrice} für die Einrichtung und ${DOCWEB.monthlyPrice} pro Monat. Bei Bestellung werden ${DOCWEB.initialPrice} fällig, danach ${DOCWEB.monthlyPrice} monatlich im Voraus. Der Vertrag läuft ab der Bestellung mindestens ${DOCWEB.minimumTermMonths} Monate. Einrichtung und ${DOCWEB.minimumTermMonths} Monatsbeiträge kosten zusammen ${DOCWEB.minimumTotalPrice}, jeweils inklusive Umsatzsteuer und zuzüglich Domainkosten.` },
  { q: 'Wie schnell ist meine Website online?', a: DOCWEB.deliveryPromise },
  { q: 'Wie funktioniert die Terminbuchung?', a: 'Auf jeder Seite steht der Knopf „Termin buchen“. Er führt zum Kalender Ihrer Praxis bei Ihrem Kalender-Dienst, zum Beispiel Doctolib oder samedi. Dort wählen Patienten einen freien Termin und schließen die Buchung ab. Wir richten den Link ein und prüfen vor dem Start, dass er zu Ihrem Kalender führt und freie Termine zeigt. Telefon und E-Mail bleiben zusätzlich sichtbar. Die Demo führt nur zur Startseite von Doctolib, weil sie keine echte Praxis ist.' },
  { q: 'Was kostet der Terminkalender?', a: 'Den Kalender buchen Sie direkt bei Ihrem Kalender-Dienst. Dessen Preise legt der Dienst fest, sie hängen vom Tarif ab und sind nicht im docweb-Preis enthalten. Wir verbinden Ihre Website mit dem Kalender, schließen aber keinen Vertrag für Sie ab. Haben Sie noch keinen Kalender, beraten wir Sie kurz bei der Auswahl. Ohne Online-Kalender nehmen wir Telefon oder E-Mail als Weg zum Termin.' },
  { q: 'Wie steht es um den Datenschutz (DSGVO)?', a: 'Ihre Website nutzt Schriften von unserem eigenen Server und keine eingebetteten Statistik- oder Kartendienste. Das Hosting erfolgt in der EU. Wenn Patienten auf „Termin buchen“ klicken, gelten die Datenschutzbedingungen Ihres Kalender-Dienstes. Den nötigen Vertrag zur Auftragsverarbeitung für das Hosting stellen wir bereit.' },
  { q: 'Gibt es ein Kontaktformular?', a: 'Ein Kontaktformular ist im Paket nicht enthalten. Patienten erreichen Sie telefonisch, per E-Mail oder über Ihren Terminlink. Gesundheitsdaten sollten Patienten nicht per einfacher E-Mail schicken, weil diese unterwegs mitgelesen werden kann.' },
  { q: 'Bleibt meine Website aktuell?', a: 'Ja, dafür gibt es zwei Dinge. Erstens kennt die Anzeige „Jetzt geöffnet“ die gesetzlichen Feiertage Ihres Bundeslands und Ihren eingetragenen Urlaub. Zweitens prüfen wir alle 3 Monate von uns aus Terminlink, Öffnungszeiten, Telefon, E-Mail, Team und Leistungen und schicken Ihnen danach eine kurze Nachricht. Urlaub und geänderte Sprechzeiten müssen Sie uns mitteilen – wir können sie nicht erraten.' },
  { q: 'Kann ich Inhalte später ändern lassen?', a: 'Ja. Für kleine Änderungen an Öffnungszeiten, Urlaub, Team oder Texten sind bis zu 30 Minuten pro Monat enthalten. Ungenutzte Zeit wird nicht übertragen. Dafür erhalten Sie nach dem Kauf einen persönlichen Änderungs-Link: Dort sehen Sie den Status Ihrer Aufträge, laden Bilder hoch und beantworten Rückfragen – ohne Passwort. Wir melden uns in der Regel innerhalb von 2 Werktagen. Link verloren? Unter lkmedia.net/aenderung/link lassen Sie ihn sich per E-Mail erneut zusenden. Zusätzlichen Aufwand stimmen wir vor der Umsetzung mit Ihnen ab. Die Prüfung alle 3 Monate kommt zusätzlich dazu.' },
  { q: 'Was ist zusätzlich zu bezahlen?', a: 'Domainkosten und die Gebühren Ihres Kalender-Dienstes (zum Beispiel Doctolib oder samedi) sind nicht enthalten. Diese zahlen Sie direkt an den Dienst. Fotografie, neue Texte über die Aufbereitung Ihrer Angaben hinaus und Rechtsberatung gehören ebenfalls nicht zum Paket. Mehrere Standorte, zusätzliche Detailseiten, weitere Sprachen oder weitere Funktionen besprechen wir vor der Bestellung und vereinbaren den Umfang sowie mögliche Zusatzkosten.' },
  { q: 'Kann meine bestehende Website umziehen?', a: 'Die Einrichtung auf Ihrer Domain ist enthalten. Wenn bestehende Inhalte oder Seitenadressen übernommen werden sollen, klären wir den Umzugsumfang vor der Bestellung. Dazu gehören die Internetadresse (Domain), vorhandene E-Mail-Postfächer und Weiterleitungen von alten Adressen. Bitte sprechen Sie uns dazu vor dem Kauf an.' },
  { q: 'Sind die Rechtstexte rechtssicher?', a: 'Wir bereiten Impressum und Datenschutzerklärung mit den berufsrechtlichen Pflichtangaben vor. Eine Rechtsberatung ersetzt das nicht – bitte prüfen Sie die Texte, bevor Ihre Website online geht, oder lassen Sie sie prüfen.' },
  { q: `Was passiert nach ${DOCWEB.minimumTermMonths} Monaten?`, a: 'Der Vertrag verlängert sich jeweils um einen Monat. Sie können dann mit einem Monat Frist zum Monatsende per E-Mail kündigen. Nach der Mindestlaufzeit und vollständiger Zahlung erhalten Sie auf Wunsch den Quellcode (den Programmtext Ihrer Website), um sie bei einem anderen Anbieter weiterzubetreiben.' },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'docweb – Website für Arztpraxen',
  description: seo.description,
  brand: { '@type': 'Organization', name: 'lkmedia' },
  url: 'https://lkmedia.net/docweb',
  offers: {
    '@type': 'Offer',
    name: 'Einrichtung und erster Betriebsmonat',
    description: `Erste Zahlung ${DOCWEB.initialPrice}, danach ${DOCWEB.monthlyPrice} pro Monat. ${DOCWEB.minimumTermMonths} Monate Mindestlaufzeit ab Bestellung; insgesamt ${DOCWEB.minimumTotalPrice} inkl. USt., zuzüglich Domainkosten.`,
    price: DOCWEB.initialAmount.toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: 'https://lkmedia.net/docweb',
  },
};
---
<Base seo={seo} jsonLd={[productSchema]}>
  <Hero
    headline="Die Website für Ihre Praxis. Zum Festpreis."
    sub={`Für Arztpraxen, Psychotherapie und Zahnärzte – verständlich, mit Terminkalender, ohne Datensammeln. ${DOCWEB.deliveryPromise}`}
    metrics={[
      { value: DOCWEB.setupPrice, label: 'Einrichtung inkl. USt.' },
      { value: DOCWEB.monthlyPrice, label: 'pro Monat inkl. USt.' },
      { value: `${DOCWEB.minimumTermMonths} Monate`, label: 'Mindestlaufzeit ab Bestellung' },
    ]}
    ctaHref="#preis" ctaLabel="Paket ansehen"
    secondaryHref={DOCWEB.demoUrl} secondaryLabel="Demo ansehen"
    deviceImage="/images/docweb-demo.webp" deviceAlt="Startseite der docweb-Demo: Hausarztpraxis mit Öffnungszeiten und Terminbuchung"
    deviceHref={DOCWEB.demoUrl} />

  <section class="py-24 px-6 max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-semibold tracking-tight mb-12">Für wen docweb gemacht ist.</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {audiences.map((a) => (
        <div class="rounded-2xl border border-black/10 dark:border-white/10 p-8">
          <h3 class="text-xl font-semibold mb-3">{a.title}</h3>
          <p class="text-black/70 dark:text-white/70 leading-relaxed">{a.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-24 px-6 max-w-6xl mx-auto border-t border-black/10 dark:border-white/10">
    <h2 class="text-3xl md:text-5xl font-semibold tracking-tight mb-12">Was Ihre Website kann.</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
      {features.map((f) => (
        <div>
          <h3 class="text-xl font-semibold mb-3">{f.title}</h3>
          <p class="text-black/70 dark:text-white/70 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
    <a href={DOCWEB.demoUrl} target="_blank" rel="noopener" class="mt-12 inline-flex h-11 px-6 items-center rounded-full border border-black/30 dark:border-white/30 text-sm font-medium">
      Live-Demo öffnen →
    </a>
    <p class="mt-4 text-sm text-black/70 dark:text-white/70">Die Demo zeigt eine erfundene Praxis. Ihr Terminknopf führt dort nur zur Startseite von Doctolib – bei Ihnen direkt zu Ihrem eigenen Kalender.</p>
  </section>

  <section class="py-24 px-6 max-w-6xl mx-auto border-t border-black/10 dark:border-white/10">
    <h2 class="text-3xl md:text-5xl font-semibold tracking-tight mb-12">So läuft es ab.</h2>
    <ol class="grid md:grid-cols-4 gap-8">
      {steps.map((s) => (
        <li>
          <div class="text-sm tracking-widest text-black/70 dark:text-white/70 mb-3">{s.n}</div>
          <h3 class="text-xl font-semibold mb-2">{s.title}</h3>
          <p class="text-black/70 dark:text-white/70 leading-relaxed">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="vorbereitung" aria-labelledby="vorbereitung-title" class="py-24 px-6 max-w-6xl mx-auto border-t border-black/10 dark:border-white/10 scroll-mt-20">
    <h2 id="vorbereitung-title" class="text-3xl md:text-5xl font-semibold tracking-tight">Das benötigen wir von Ihnen.</h2>
    <p class="mt-5 max-w-3xl text-lg text-black/70 dark:text-white/70 leading-relaxed">
      Diese Checkliste können Sie schon vor der Bestellung durchgehen. Nach dem Kauf tragen Sie Ihre Angaben in einem kurzen Formular ein.
      Der Zeitraum bis zur Vorschau beginnt, sobald alle benötigten Inhalte vorliegen.
    </p>
    <div class="mt-10 grid md:grid-cols-2 gap-8">
      {preparation.map((item) => (
        <div class="rounded-2xl border border-black/10 dark:border-white/10 p-6 md:p-8">
          <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
          <p class="text-black/70 dark:text-white/70 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-black/70 dark:text-white/70 leading-relaxed">
      Mehrere Standorte, zusätzliche Seiten, weitere Sprachen oder ein Umzug Ihrer bestehenden Website?
      {' '}<a href="/kontakt#termin" class="underline underline-offset-4">Lassen Sie uns den Umfang vor der Bestellung klären.</a>
    </p>
  </section>

  <section id="preis" class="py-24 px-6 max-w-6xl mx-auto border-t border-black/10 dark:border-white/10 scroll-mt-20">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight">Ein Paket. Ein Preis.</h2>
        <p class="mt-5 text-lg text-black/70 dark:text-white/70 leading-relaxed">
          Sie bestellen das Praxis-Paket online. Wir bereiten Ihre Inhalte auf, erstellen die Website und übernehmen den laufenden Betrieb.
        </p>
        <p class="mt-5 text-black/70 dark:text-white/70 leading-relaxed">
          Nicht enthalten: Domainkosten, Gebühren Ihres Kalender-Dienstes (zum Beispiel Doctolib oder samedi), Fotografie, weitergehende Texterstellung und Rechtsberatung.
          Erweiterungen und zusätzlichen Aufwand vereinbaren wir vorab.
        </p>
        <a href="#vorbereitung" class="mt-6 inline-flex min-h-11 items-center underline underline-offset-4">Checkliste für Ihre Bestellung ansehen →</a>
      </div>
      <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-black/[0.02] dark:bg-white/[0.03] p-8 md:p-10">
        <div class="text-sm tracking-widest text-black/70 dark:text-white/70">DOCWEB KOMPLETTPAKET</div>
        <div class="mt-4 flex flex-wrap items-baseline gap-x-3">
          <span class="text-5xl font-semibold tracking-tight">{DOCWEB.setupPrice}</span>
          <span class="text-black/60 dark:text-white/60">einmalig</span>
        </div>
        <div class="mt-1 text-xl"><span class="font-semibold">+ {DOCWEB.monthlyPrice}</span> <span class="text-black/60 dark:text-white/60">/ Monat</span></div>
        <p class="mt-2 text-sm text-black/70 dark:text-white/70">inkl. USt. · {DOCWEB.minimumTermMonths} Monate Mindestlaufzeit ab Bestellung</p>
        <div class="mt-6 border-y border-black/10 dark:border-white/15 py-5 text-sm leading-relaxed">
          <p><strong>Bei Bestellung: {DOCWEB.initialPrice}</strong> für Einrichtung und ersten Monat.</p>
          <p class="mt-2 text-black/70 dark:text-white/70">Danach {DOCWEB.monthlyPrice} monatlich im Voraus. Einrichtung + {DOCWEB.minimumTermMonths} Monatsbeiträge: <strong class="text-black dark:text-white">{DOCWEB.minimumTotalPrice} inkl. USt.</strong>, zuzüglich Domainkosten.</p>
          <p class="mt-2 text-black/70 dark:text-white/70">Nach der Mindestlaufzeit monatliche Verlängerung; Kündigungsfrist: ein Monat zum Monatsende.</p>
        </div>
        <ul class="mt-8 space-y-3">
          {included.map((i) => (
            <li class="flex gap-3"><span aria-hidden="true" class="text-black/70 dark:text-white/70">✓</span><span>{i}</span></li>
          ))}
        </ul>
        <a href={DOCWEB.paymentLink} class="mt-10 flex h-12 w-full items-center justify-center rounded-full bg-black text-white dark:bg-white dark:text-black font-medium hover:bg-black/90 dark:hover:bg-white/90 transition">
          Jetzt starten →
        </a>
        <p class="mt-3 text-center text-sm text-black/70 dark:text-white/70">
          Sichere Zahlung über Stripe · Es gelten die <a href="/docweb/agb" class="underline">AGB für docweb</a>
        </p>
      </div>
    </div>
  </section>

  <FaqBlock items={faqs} />

  <section class="py-24 px-6 text-center border-t border-black/10 dark:border-white/10">
    <h2 class="text-3xl md:text-5xl font-semibold tracking-tight">Lieber erst sprechen?</h2>
    <p class="mt-4 text-black/70 dark:text-white/70">15 Minuten, unverbindlich – wir klären, ob docweb zu Ihrer Praxis passt.</p>
    <a href="/kontakt#termin" class="mt-8 inline-flex h-12 px-6 items-center rounded-full border border-black/30 dark:border-white/30 font-medium">Kurzes Gespräch buchen</a>
  </section>
</Base>
