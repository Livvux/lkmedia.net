---
import Base from '../../layouts/Base.astro';
import ProductShell from '../../components/product/ProductShell.astro';
import ProductFaq from '../../components/product/ProductFaq.astro';
import Process from '../../components/product/Process.astro';
import InboxDemo from '../../components/product/InboxDemo';
import MailPreview from '../../components/product/MailPreview';
import BeamFrame from '../../components/product/BeamFrame';
import { Marquee } from '../../components/ui/marquee';
import { buttonVariants } from '../../components/ui/button';
import { Wrench, Zap, Layers, Check, ArrowRight, ArrowUpRight, MapPin, Briefcase, ImageIcon, ShieldCheck } from 'lucide-react';
import { HANDWERKWEB } from '../../lib/handwerkweb';

const seo = {
  title: 'Website für Handwerker erstellen lassen | handwerkweb',
  description: `Website für SHK- und Elektrobetriebe: Leistungen, Referenzen, Einsatzgebiet, Projektanfrage mit Fotos und Bewerbung. ${HANDWERKWEB.setupPrice} + ${HANDWERKWEB.monthlyPrice}/Monat.`,
  canonical: '/handwerk',
  lang: 'de' as const,
  alternateUrls: { de: 'https://lkmedia.net/handwerk' },
};

const TONE = 'oklch(0.78 0.165 55)';
const ctaHref = HANDWERKWEB.paymentLink || '/kontakt#termin';
const ctaLabel = HANDWERKWEB.paymentLink ? 'Jetzt starten' : 'Gespräch vereinbaren';

const primary = buttonVariants({ size: 'lg', className: 'h-12 rounded-full bg-tone px-7 text-base text-tone-foreground hover:bg-tone/90' });
const ghost = buttonVariants({ variant: 'outline', size: 'lg', className: 'h-12 rounded-full px-7 text-base' });

const audiences = [
  { icon: Wrench, title: 'Sanitär, Heizung, Klima', body: 'SHK-Betriebe, Heizungsbauer, Badsanierer, Wärmepumpen-Fachbetriebe.' },
  { icon: Zap, title: 'Elektro', body: 'Elektroinstallateure, E-Check, Wallbox und Photovoltaik.' },
  { icon: Layers, title: 'Beides unter einem Dach', body: 'Haustechnik-Betriebe mit mehreren Gewerken – eine Website für alles.' },
];

const services = ['Heizung', 'Wärmepumpe', 'Bad', 'Elektro', 'Wallbox', 'Photovoltaik'];
const region = ['Rastatt', 'Baden-Baden', 'Gaggenau', 'Gernsbach', 'Bühl', 'Kuppenheim'];
const privacy = ['Kein Cookie-Banner', 'Keine Google Fonts', 'Hosting in der EU', 'Barrierefrei nach WCAG 2.2 AA'];

const steps = [
  { n: '01', title: 'Online buchen', body: `Bei Bestellung zahlen Sie ${HANDWERKWEB.initialPrice} für Einrichtung und ersten Monat. Die Mindestlaufzeit beginnt mit der Bestellung. Die Zahlung erfolgt über Stripe.` },
  { n: '02', title: 'Onboarding ausfüllen', body: 'Betriebsdaten, Leistungen, Einsatzgebiet, offene Stellen. Logo und Projektfotos laden Sie direkt im Formular hoch.' },
  { n: '03', title: 'Vorschau prüfen', body: 'Sie erhalten einen Vorschau-Link und geben Texte und Rechtsangaben frei.' },
  { n: '04', title: 'Live gehen', body: 'Wir schalten Ihre Domain auf. Hosting, Updates und kleine Änderungen übernehmen wir – über Ihren Änderungs-Link.' },
];

const included = [
  'Individuelle Website mit Ihren Inhalten, Ihrem Logo und Ihrer Farbe',
  'Seiten: Start, Leistungen, Referenzen, Einsatzgebiet, Über uns, Karriere, Anfrage',
  'Projektanfrage mit Foto-Upload und Kurzbewerbung – direkt in Ihr Postfach',
  'Stellenanzeigen mit Google-for-Jobs-Auszeichnung',
  'Impressum, Datenschutz und Barrierefreiheitserklärung (Entwurf)',
  'Hosting in der EU, SSL, Backups, Updates',
  'Kleine Inhaltsänderungen (bis 30 Min./Monat), z. B. neue Referenz oder Stelle',
];

const faqs = [
  { q: 'Was kostet handwerkweb?', a: `${HANDWERKWEB.setupPrice} einmalig für die Einrichtung und ${HANDWERKWEB.monthlyPrice} pro Monat für Hosting, Wartung, Formularversand und kleine Änderungen. Bei Bestellung werden ${HANDWERKWEB.initialPrice} fällig, danach ${HANDWERKWEB.monthlyPrice} monatlich im Voraus. Die Mindestlaufzeit beträgt ${HANDWERKWEB.minimumTermMonths} Monate ab Bestellung. Einrichtung und Monatsbeiträge dieser Laufzeit kosten zusammen ${HANDWERKWEB.minimumTotalPrice} inklusive Umsatzsteuer, zuzüglich Domainkosten.` },
  { q: 'Wie schnell ist meine Website online?', a: 'Sobald das Onboarding vollständig ist und wir Logo und Fotos haben, erhalten Sie in der Regel innerhalb von 7 Werktagen eine Vorschau. Live geht die Seite nach Ihrer Freigabe.' },
  { q: 'Wo landen Anfragen und Bewerbungen?', a: 'Per E-Mail in Ihrem Postfach, inklusive Fotos bzw. Lebenslauf als Anhang. Sie können direkt auf die Mail antworten. Wir speichern die Einsendungen nicht.' },
  { q: 'Kann ich Inhalte später ändern lassen?', a: 'Ja. Nach dem Kauf erhalten Sie einen persönlichen Änderungs-Link. Dort sehen Sie den Status Ihrer Aufträge, stellen neue Änderungen ein, laden Bilder hoch und beantworten Rückfragen – ohne Passwort. Wir melden uns in der Regel innerhalb von 2 Werktagen. Link verloren? Unter lkmedia.net/aenderung/link lassen Sie ihn sich per E-Mail erneut zusenden. Bis zu 30 Minuten Änderungen pro Monat sind enthalten; größeren Aufwand stimmen wir vorher mit Ihnen ab.' },
  { q: 'Ich habe kaum Fotos von Projekten.', a: 'Handyfotos reichen. Wir wählen aus und optimieren sie. Neue Referenzen ergänzen wir laufend im Rahmen der monatlichen Änderungen.' },
  { q: 'Ist die Website DSGVO-konform?', a: 'Die Website lädt keine externen Dienste: keine Cookies, kein Tracking, keine Google Fonts, keine Karten-Embeds. Formulare werden über unseren Server in der EU an Sie weitergeleitet; dafür schließen wir einen Auftragsverarbeitungsvertrag.' },
  { q: 'Sind die Rechtstexte rechtssicher?', a: 'Wir bereiten Impressum (inkl. Handwerkskammer) und Datenschutzerklärung vor. Eine Rechtsberatung ersetzt das nicht – bitte prüfen Sie die Texte vor dem Go-live bzw. lassen Sie sie prüfen.' },
  { q: 'Was ist nicht enthalten?', a: 'Domainkosten, ein CRM zur Speicherung oder Verwaltung von Anfragen und Bewerbungen, Stellenportale Dritter und Rechtsberatung sind nicht enthalten. Besondere Schnittstellen, zusätzliche Funktionen und die Erstellung neuer Fotos oder umfangreicher Texte klären wir vor der Bestellung.' },
  { q: 'Was passiert nach 12 Monaten?', a: 'Der Vertrag verlängert sich jeweils um einen Monat. Sie können dann mit einem Monat Frist zum Monatsende per E-Mail kündigen. Nach Ablauf der Mindestlaufzeit und Zahlung aller fälligen Beträge erhalten Sie auf Wunsch den Quellcode mit einem zeitlich unbegrenzten Nutzungsrecht zum Betrieb Ihrer Website.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Erstellung und Betrieb einer Handwerkerwebsite',
  name: 'handwerkweb – Website für Handwerksbetriebe',
  description: seo.description,
  provider: { '@id': 'https://lkmedia.net/#organization' },
  image: 'https://lkmedia.net/images/handwerkweb-demo.webp',
  url: 'https://lkmedia.net/handwerk',
  offers: {
    '@type': 'Offer',
    name: 'Einrichtung und erster Betriebsmonat',
    description: `Erste Zahlung ${HANDWERKWEB.initialPrice}, danach ${HANDWERKWEB.monthlyPrice} pro Monat. ${HANDWERKWEB.minimumTermMonths} Monate Mindestlaufzeit ab Bestellung; insgesamt ${HANDWERKWEB.minimumTotalPrice} inkl. USt., zuzüglich Domainkosten.`,
    price: HANDWERKWEB.initialAmount.toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: 'https://lkmedia.net/handwerk',
  },
};
---
<Base seo={seo} jsonLd={[serviceSchema]}>
  <ProductShell tone={TONE} priceText={`${HANDWERKWEB.setupPrice} + ${HANDWERKWEB.monthlyPrice}/Monat`}>

    <!-- Hero -->
    <section data-hero class="relative isolate pb-20 pt-14 md:pb-32 md:pt-24">
      <div class="dot-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="absolute -right-40 -top-40 -z-10 size-[620px] rounded-full bg-tone/15 blur-[120px]" aria-hidden="true"></div>

      <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
        <div>
          <p data-rise class="inline-flex items-center gap-2.5 rounded-full border border-border bg-secondary py-1.5 pl-3 pr-4 text-[13px] text-muted-foreground">
            <span class="pulse-dot size-1.5 rounded-full bg-tone" aria-hidden="true"></span>
            handwerkweb · für SHK- und Elektrobetriebe
          </p>
          <h1 data-rise style="--d:80ms" class="display mt-7 text-[clamp(2.6rem,6.2vw,5rem)]">
            Website für <span class="text-tone">Handwerker</span> erstellen lassen.
          </h1>
          <p data-rise style="--d:160ms" class="section-sub mt-6 max-w-[52ch]">
            Die Website, die Ihre Arbeit zeigt und dafür sorgt, dass Anfragen mit den richtigen Angaben ankommen. Festpreis, ohne Agentur-Stundensätze.
          </p>

          <p data-rise style="--d:220ms" class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-4xl font-semibold tracking-tight">{HANDWERKWEB.setupPrice}</span>
            <span class="text-muted-foreground">einmalig</span>
            <span class="text-xl font-medium">+ {HANDWERKWEB.monthlyPrice}<span class="text-muted-foreground"> / Monat</span></span>
          </p>

          <div data-rise style="--d:280ms" class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#preis" class={primary}>Paket ansehen <ArrowRight className="size-4" aria-hidden="true" /></a>
            <a href={HANDWERKWEB.demoUrl} target="_blank" rel="noopener noreferrer" class={ghost}>Demo ansehen<ArrowUpRight className="size-4" aria-hidden="true" /></a>
          </div>

          <ul data-rise style="--d:340ms" class="mt-10 grid gap-2.5 text-[15px] text-muted-foreground sm:grid-cols-2">
            {['Kein Cookie-Banner, kein Tracking', 'Hosting in der EU', 'Vorschau meist in 7 Werktagen', 'Kleine Änderungen sind inklusive'].map((t) => (
              <li class="flex items-center gap-2.5"><Check className="size-4 shrink-0 text-tone" aria-hidden="true" />{t}</li>
            ))}
          </ul>
        </div>

        <div data-rise style="--d:200ms" class="relative">
          <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-[0_40px_120px_-30px_rgba(0,0,0,0.9)]">
            <div class="flex items-center gap-2 border-b border-border bg-secondary px-4 py-3" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
              <span class="ml-3 flex-1 truncate rounded-md bg-black/40 px-3 py-1 font-mono text-[11px] text-muted-foreground">handwerk.lkmedia.net</span>
            </div>
            <a href={HANDWERKWEB.demoUrl} target="_blank" rel="noopener noreferrer" class="group relative block">
              <img src="/images/handwerkweb-demo.webp" alt="Startseite der handwerkweb-Demo: Haustechnik-Betrieb mit Leistungen, Einsatzgebiet und Anfrage-Button" width="1440" height="900" class="aspect-[16/10] w-full object-cover object-top" loading="eager" decoding="async" />
              <span class="absolute inset-0 grid place-items-center bg-black/55 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-medium text-black">Website ansehen <ArrowUpRight className="size-4" aria-hidden="true" /></span>
              </span>
            </a>
          </div>
          <div class="relative z-10 mx-auto -mt-16 px-3 sm:px-0 md:-mt-24 md:-ml-6 lg:-ml-14">
            <InboxDemo client:visible />
          </div>
        </div>
      </div>
    </section>

    <!-- Für wen -->
    <section class="border-t border-border py-20 md:py-24">
      <div class="wrap">
        <h2 class="section-title max-w-2xl">Für wen handwerkweb gemacht ist.</h2>
        <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-3">
          {audiences.map((a) => (
            <li class="bg-background p-7 md:p-9">
              <a.icon className="size-6 text-tone" aria-hidden="true" />
              <h3 class="mt-6 text-xl font-semibold tracking-tight">{a.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{a.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Anfragen & Bewerbungen -->
    <section class="border-t border-border py-24 md:py-32">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20">
        <div>
          <h2 class="section-title">Anfragen, die schon alles enthalten.</h2>
          <div class="mt-10 space-y-8">
            <div>
              <h3 class="text-xl font-semibold tracking-tight">Anfragen mit allen Angaben</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground md:text-base">Anliegen, PLZ, Objektart, Zeitrahmen, Beschreibung und bis zu 5 Fotos – strukturiert per Mail. Kein Hinterhertelefonieren für die Basics.</p>
            </div>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">Bewerbung in 60 Sekunden</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground md:text-base">Kurzbewerbung ohne Pflicht-Lebenslauf: Stelle, Name, Telefon, Erfahrung. Ihre Stellen erscheinen zusätzlich in Google for Jobs.</p>
            </div>
          </div>
          <a href={HANDWERKWEB.demoUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex min-h-11 items-center gap-2 text-[15px] underline decoration-border underline-offset-4 hover:decoration-tone">Live-Demo öffnen <ArrowUpRight className="size-4" aria-hidden="true" /></a>
        </div>
        <MailPreview client:visible />
      </div>
    </section>

    <!-- Bento -->
    <section class="border-t border-border py-24 md:py-32">
      <div class="wrap">
        <h2 class="section-title max-w-3xl">Alles, was ein Betrieb online braucht.</h2>
        <div class="mt-14 grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-6">
          <article class="bento lg:col-span-3">
            <h3 class="text-xl font-semibold tracking-tight">Leistungsseiten</h3>
            <p class="mt-2 max-w-[44ch] text-[15px] leading-relaxed text-muted-foreground">Heizung, Wärmepumpe, Bad, Elektro, Wallbox, PV: je Leistung eine Seite mit klaren Infos und Anfrage-Button.</p>
            <Marquee className="-mx-8 mt-8 [--duration:28s] [--gap:0.75rem] [mask-image:linear-gradient(90deg,transparent,#000_15%,#000_85%,transparent)]" pauseOnHover repeat={3}>
              {services.map((s) => <span class="shrink-0 rounded-full border border-border bg-secondary px-4 py-2 text-sm">{s}</span>)}
            </Marquee>
          </article>

          <article class="bento lg:col-span-3">
            <h3 class="text-xl font-semibold tracking-tight">Ihr Einsatzgebiet</h3>
            <p class="mt-2 max-w-[44ch] text-[15px] leading-relaxed text-muted-foreground">Orte und PLZ-Gebiete auf einer eigenen Seite – lokal gefunden werden. Anfragen von außerhalb werden markiert.</p>
            <ul class="mt-8 flex flex-wrap gap-2">
              {region.map((r) => <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-secondary px-3.5 py-1.5 text-sm"><MapPin className="size-3.5 text-tone" aria-hidden="true" />{r}</li>)}
              <li class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-tone/50 px-3.5 py-1.5 text-sm text-tone">Außerhalb? Wird markiert</li>
            </ul>
          </article>

          <article class="bento lg:col-span-2">
            <h3 class="text-xl font-semibold tracking-tight">Referenzen, die überzeugen</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Projekte mit Ort, Jahr und Fotos. Zeigt, was Sie können – und wo Sie schon gearbeitet haben.</p>
            <div class="mt-8 grid grid-cols-3 gap-2" aria-hidden="true">
              {[0, 1, 2].map(() => (
                <div>
                  <div class="grid aspect-[4/3] place-items-center rounded-lg bg-secondary text-white/30"><ImageIcon className="size-5" /></div>
                  <div class="mt-2 h-1.5 w-3/4 rounded bg-white/15"></div>
                  <div class="mt-1.5 h-1.5 w-1/2 rounded bg-white/10"></div>
                </div>
              ))}
            </div>
          </article>

          <article class="bento lg:col-span-2">
            <h3 class="text-xl font-semibold tracking-tight">Stellen in Google for Jobs</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Ihre offenen Stellen werden zusätzlich so ausgezeichnet, dass Google sie als Stellenanzeige darstellen kann.</p>
            <div class="mt-8 flex items-center gap-3 rounded-xl border border-border bg-secondary p-3.5" aria-hidden="true">
              <span class="grid size-9 place-items-center rounded-lg bg-tone/15 text-tone"><Briefcase className="size-4" /></span>
              <span class="text-sm"><span class="block font-medium">Anlagenmechaniker SHK (m/w/d)</span><span class="text-xs text-muted-foreground">Rastatt · Vollzeit · Beispiel</span></span>
            </div>
          </article>

          <article class="bento lg:col-span-2">
            <h3 class="text-xl font-semibold tracking-tight">Schnell, sicher, ohne Tracking</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Statische Website: schnell geladen und ohne Datensammler.</p>
            <ul class="mt-6 space-y-2.5 text-[15px]">
              {privacy.map((p) => <li class="flex items-center gap-2.5"><ShieldCheck className="size-4 shrink-0 text-tone" aria-hidden="true" />{p}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <Process title="So läuft es ab." steps={steps} note={{ after: 2, text: 'in der Regel 7 Werktage' }} />

    <!-- Preis -->
    <section id="preis" class="scroll-mt-20 border-t border-border py-24 md:py-32">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] items-start gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.1fr)] lg:gap-20">
        <div class="lg:sticky lg:top-28">
          <h2 class="section-title">Ein Paket. Ein Preis.</h2>
          <p class="section-sub mt-5 max-w-[44ch]">
            Kein Angebot, kein Baukasten, keine Agentur-Stundensätze. Wir bauen und betreuen Ihre Website, zeigen Ihre Arbeit und sorgen dafür, dass Anfragen mit den richtigen Angaben ankommen.
          </p>
          <a href="/kontakt#termin" class="mt-6 inline-flex min-h-11 items-center gap-2 text-[15px] underline decoration-border underline-offset-4 hover:decoration-tone">Erst kurz sprechen? 15 Minuten, unverbindlich →</a>
        </div>

        <div class="relative rounded-3xl border border-border bg-card p-7 md:p-10">
          <BeamFrame client:visible />
          <p class="font-mono text-xs text-muted-foreground">handwerkweb Komplettpaket</p>
          <div class="mt-5 flex flex-wrap items-baseline gap-x-3">
            <span class="text-6xl font-semibold tracking-tight">{HANDWERKWEB.setupPrice}</span>
            <span class="text-muted-foreground">einmalig</span>
          </div>
          <p class="mt-1 text-2xl"><span class="font-semibold">+ {HANDWERKWEB.monthlyPrice}</span> <span class="text-muted-foreground">/ Monat</span></p>
          <p class="mt-2 text-sm text-muted-foreground">inkl. USt. · {HANDWERKWEB.minimumTermMonths} Monate Mindestlaufzeit ab Bestellung</p>
          <div class="mt-4 space-y-2 text-sm leading-relaxed text-muted-foreground">
            <p>Erste Zahlung: <strong class="text-foreground">{HANDWERKWEB.initialPrice}</strong> für Einrichtung und ersten Monat. Danach {HANDWERKWEB.monthlyPrice} monatlich im Voraus.</p>
            <p>Einrichtung + {HANDWERKWEB.minimumTermMonths} Monate: <strong class="text-foreground">{HANDWERKWEB.minimumTotalPrice}</strong> inkl. USt., zuzüglich Domainkosten.</p>
            <p>Danach Verlängerung um jeweils einen Monat, kündbar mit einem Monat Frist zum Monatsende per E-Mail.</p>
            <p>Nicht enthalten: Domainkosten, CRM, Stellenportale Dritter und Rechtsberatung. Zusätzliche Funktionen sowie neue Fotos oder umfangreiche Texte klären wir vor der Bestellung.</p>
          </div>
          <ul class="mt-8 space-y-3.5 border-t border-border pt-8">
            {included.map((i) => (
              <li class="flex gap-3 text-[15px] leading-snug"><Check className="mt-0.5 size-4 shrink-0 text-tone" aria-hidden="true" /><span>{i}</span></li>
            ))}
          </ul>
          <a href={ctaHref} class={`${primary} mt-10 h-14 w-full text-base`}>{ctaLabel} <ArrowRight className="size-4" aria-hidden="true" /></a>
          <p class="mt-4 text-center text-sm text-muted-foreground">
            Sichere Zahlung über Stripe · Es gelten die <a href="/handwerk/agb" class="underline underline-offset-2">AGB für handwerkweb</a>
          </p>
        </div>
      </div>
    </section>

  <section class="wrap py-16" aria-labelledby="guide-title">
    <h2 id="guide-title" class="text-3xl font-semibold tracking-tight">Webdesign für Handwerker planen</h2>
    <p class="mt-4 max-w-3xl">Einsatzgebiet, Projektanfragen und Bewerbungen: So bereiten Sie Ihre Website vor.</p>
    <a class="inline-block mt-4 underline underline-offset-4" href="/blog/webdesign-fuer-handwerker/">Ratgeber lesen →</a>
  </section>

    <ProductFaq items={faqs} intro="Preis, Ablauf, Datenschutz: die Antworten, die Betriebe vor dem Kauf wissen wollen." />

    <!-- Abschluss -->
    <section class="pb-28 pt-8 md:pb-36">
      <div class="wrap">
        <div class="rounded-[28px] bg-tone px-7 py-16 text-center text-tone-foreground md:px-16 md:py-24">
          <h2 class="display mx-auto max-w-3xl text-[clamp(2rem,5vw,3.75rem)]">Lieber erst sprechen?</h2>
          <p class="mx-auto mt-5 max-w-[48ch] text-lg opacity-80">15 Minuten, unverbindlich – wir klären, ob handwerkweb zu Ihrem Betrieb passt.</p>
          <a href="/kontakt#termin" class="mt-10 inline-flex h-14 items-center gap-2 rounded-full bg-black px-8 text-base font-medium text-white transition-transform hover:scale-[1.02]">Kurzes Gespräch buchen <ArrowRight className="size-4" aria-hidden="true" /></a>
        </div>
      </div>
    </section>
  </ProductShell>
</Base>
