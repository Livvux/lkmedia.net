---
import Base from '../../layouts/Base.astro';
import { FAHRSCHULWEB, KLASSEN, checkSession } from '../../lib/fahrschulweb';

export const prerender = false;

const sessionId = Astro.url.searchParams.get('session_id') ?? '';
const fehler = Astro.url.searchParams.get('fehler');
const stripeKey = process.env.STRIPE_SECRET_KEY ?? import.meta.env.STRIPE_SECRET_KEY;
// Ohne Key nur im Dev-Server Formular zeigen; in Produktion nur nach bezahlter Bestellung.
const { paid } = stripeKey ? await checkSession(sessionId, stripeKey) : { paid: import.meta.env.DEV };

const seo = {
  title: 'Fahrschul-Website Onboarding',
  description: 'Angaben für Ihre Fahrschul-Website übermitteln oder ändern.',
  canonical: '/fahrschule-webdesign/onboarding',
  lang: 'de' as const,
  noindex: true,
};

const preselected = ['B', 'BE', 'B196', 'A1', 'A2', 'A', 'AM'];
const input = 'mt-1 w-full h-12 px-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 focus:border-black dark:focus:border-white focus:outline-none';
const area = 'mt-1 w-full p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 focus:border-black dark:focus:border-white focus:outline-none';
const label = 'text-sm text-black/60 dark:text-white/60';
const hint = 'text-sm text-black/50 dark:text-white/50';
const legend = 'text-xl font-semibold mb-4';
---
<Base seo={seo}>
  <section class="py-24 px-6 max-w-3xl mx-auto">
    {!paid ? (
      <>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Bestellung nicht gefunden.</h1>
        <p class="mt-6 text-lg text-black/70 dark:text-white/70">
          Das Onboarding ist nach dem Kauf über Stripe erreichbar. Falls Sie bereits bezahlt haben, nutzen Sie bitte den Link aus Ihrer Bestätigungsmail
          oder schreiben Sie an <a class="underline" href="mailto:lucas@lkmedia.net">lucas@lkmedia.net</a>.
        </p>
        <a href="/fahrschule-webdesign" class="inline-flex mt-10 h-12 px-6 items-center rounded-full border border-black/30 dark:border-white/30">Zum Fahrschul-Paket</a>
      </>
    ) : (
      <>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Ihre Fahrschul-Website einrichten.</h1>
        <p class="mt-6 text-lg text-black/70 dark:text-white/70">
          Damit wir Ihre Website bauen können, brauchen wir ein paar Angaben. Das dauert etwa 15 Minuten.
          Felder mit * sind Pflicht. Logo und Fotos schicken Sie bitte als Antwort auf unsere Bestätigungsmail.
        </p>
        <p class="mt-4 text-black/70 dark:text-white/70">{FAHRSCHULWEB.deliveryPromise}</p>
        <div class="mt-6 rounded-xl border border-black/10 dark:border-white/15 p-5 text-sm leading-relaxed">
          <strong>Später etwas ändern?</strong> Dieser Link bleibt gültig – auch nach dem Start Ihrer Website.
          Öffnen Sie ihn erneut (er steht in Ihrer Bestätigungsmail), passen Sie die Angaben an und senden Sie sie ab.
          Wir pflegen die Änderung ein. Auf diesem Gerät sind Ihre zuletzt gesendeten Angaben bereits eingetragen.
        </div>

        {fehler && (
          <div role="alert" class="mt-8 rounded-xl border border-red-500/40 bg-red-500/10 p-5">
            <p class="font-semibold">Bitte prüfen Sie Ihre Angaben:</p>
            <p class="mt-2 text-sm">{fehler}</p>
          </div>
        )}

        <form id="onboarding" data-session={sessionId} method="POST" action="/api/fahrschule-onboarding" class="mt-12 space-y-12">
          <input type="hidden" name="session_id" value={sessionId} />
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <fieldset class="space-y-4">
            <legend class={legend}>Fahrschule</legend>
            <label class="block"><span class={label}>Name der Fahrschule *</span><input required name="fahrschule_name" maxlength="200" class={input} placeholder="Fahrschule Muster" /></label>
            <label class="block"><span class={label}>Kurzbeschreibung (2–3 Sätze: Was macht Sie aus?)</span><textarea name="beschreibung" rows="3" maxlength="1000" class={area}></textarea></label>
            <div class="grid md:grid-cols-2 gap-4">
              <label class="block"><span class={label}>Telefon *</span><input required type="tel" name="telefon" maxlength="40" class={input} /></label>
              <label class="block"><span class={label}>WhatsApp (falls gewünscht)</span><input type="tel" name="whatsapp" maxlength="40" class={input} /></label>
            </div>
            <label class="block"><span class={label}>E-Mail (hier kommen Online-Anmeldungen an) *</span><input required type="email" name="email" maxlength="120" class={input} /></label>
            <label class="block"><span class={label}>Anmelde-Link Ihrer Fahrschulsoftware (falls vorhanden)</span><input type="url" name="anmelde_link" maxlength="500" pattern="https://.*" class={input} placeholder="https://…" /></label>
            <p class={hint}>Ohne Link bauen wir die Online-Anmeldung als Formular, das Anmeldungen per E-Mail an Sie schickt.</p>
            <div class="grid md:grid-cols-2 gap-4">
              <label class="block"><span class={label}>Wunsch-Internetadresse (Domain)</span><input name="wunschdomain" maxlength="120" class={input} placeholder="fahrschule-muster.de" /></label>
              <label class="block"><span class={label}>Wunschfarbe</span><input type="color" name="wunschfarbe" value="#1d4ed8" class={`${input} p-1`} /></label>
            </div>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class={legend}>Führerscheinklassen *</legend>
            <div class="flex flex-wrap gap-x-6 gap-y-3">
              {KLASSEN.map((k) => (
                <label class="flex items-center gap-2"><input type="checkbox" name="klassen" value={k} checked={preselected.includes(k)} /> {k}</label>
              ))}
            </div>
            <label class="block"><span class={label}>Preise (je Klasse: Grundbetrag, Fahrstunde, Sonderfahrten, Prüfungen)</span><textarea name="preise" rows="6" maxlength="5000" class={area} placeholder={'B: Grundbetrag 450 €, Fahrstunde 65 €, Sonderfahrt 80 €, Vorstellung Prüfung 180 €'}></textarea></label>
            <p class={hint}>Leer lassen, wenn Sie keine Preise zeigen möchten.</p>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class={legend}>Hauptstandort</legend>
            <label class="block"><span class={label}>Straße und Hausnummer *</span><input required name="strasse" maxlength="200" class={input} /></label>
            <div class="grid md:grid-cols-[10rem_1fr] gap-4">
              <label class="block"><span class={label}>PLZ *</span><input required name="plz" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" class={input} /></label>
              <label class="block"><span class={label}>Ort *</span><input required name="ort" maxlength="200" class={input} /></label>
            </div>
            <label class="block"><span class={label}>Bürozeiten *</span><textarea required name="buerozeiten" rows="3" maxlength="2000" class={area} placeholder="Mo und Mi 17–19 Uhr"></textarea></label>
            <label class="block"><span class={label}>Weitere Filialen (je Filiale: Adresse und Bürozeiten)</span><textarea name="weitere_standorte" rows="4" maxlength="3000" class={area}></textarea></label>
            <p class={hint}>Bis zu {FAHRSCHULWEB.includedLocations} Standorte sind enthalten – jeder bekommt eine eigene Seite.</p>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class={legend}>Unterricht</legend>
            <label class="block"><span class={label}>Theoriezeiten (je Standort) *</span><textarea required name="theorie" rows="3" maxlength="2000" class={area} placeholder="Rastatt: Di und Do 18:30–20:00 Uhr"></textarea></label>
            <label class="block"><span class={label}>Ferien- und Intensivkurse mit Terminen</span><textarea name="kurse" rows="3" maxlength="3000" class={area} placeholder="Ferienkurs Herbst: 26.–30.10.2026, täglich 9–12 Uhr"></textarea></label>
            <label class="block"><span class={label}>Unterrichtssprachen außer Deutsch</span><input name="sprachen" maxlength="300" class={input} placeholder="Englisch, Türkisch" /></label>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class={legend}>Team und Fahrzeuge</legend>
            <label class="block"><span class={label}>Fahrlehrerinnen und Fahrlehrer (eine Person pro Zeile: Name, Klassen, gern ein Satz)</span><textarea name="team" rows="4" maxlength="3000" class={area}></textarea></label>
            <label class="block"><span class={label}>Fahrzeuge (Modell, Schaltung/Automatik)</span><textarea name="fahrzeuge" rows="3" maxlength="2000" class={area} placeholder="VW Golf 8, Automatik&#10;Yamaha MT-07 (A2/A)"></textarea></label>
            <label class="block"><span class={label}>Links: Google-Unternehmensprofil, Instagram, Facebook …</span><textarea name="links" rows="3" maxlength="2000" class={area}></textarea></label>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class={legend}>Angaben für das Impressum</legend>
            <label class="block"><span class={label}>Inhaber / Geschäftsführung *</span><input required name="inhaber" maxlength="200" class={input} /></label>
            <label class="block"><span class={label}>Rechtsform</span><input name="rechtsform" maxlength="100" class={input} placeholder="Einzelunternehmen, GmbH …" /></label>
            <label class="block"><span class={label}>Erlaubnisbehörde (wer hat die Fahrschulerlaubnis erteilt?) *</span><input required name="erlaubnisbehoerde" maxlength="200" class={input} placeholder="Landratsamt Rastatt, Straßenverkehrsamt" /></label>
            <label class="block"><span class={label}>Handelsregister (Gericht und Nummer)</span><input name="register" maxlength="200" class={input} /></label>
            <label class="block"><span class={label}>USt-IdNr.</span><input name="ust_id" maxlength="40" class={input} /></label>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class={legend}>Hinweise</legend>
            <label class="block"><span class={label}>Alles, was wir sonst wissen sollten – oder was sich geändert hat</span><textarea name="hinweise" rows="4" maxlength="3000" class={area}></textarea></label>
          </fieldset>

          <button type="submit" class="inline-flex h-12 px-8 items-center rounded-full bg-black text-white dark:bg-white dark:text-black font-medium">Angaben absenden</button>
        </form>
      </>
    )}
  </section>
</Base>

<script>
  // Letzte Angaben im Browser merken: füllt das Formular bei Änderungen und nach Fehlermeldungen wieder aus.
  // ponytail: nur dieses Gerät; serverseitig speichern, falls Kunden oft von anderen Geräten ändern.
  const form = document.querySelector<HTMLFormElement>('#onboarding');
  if (form) {
    const key = `fahrschulweb:${form.dataset.session}`;
    const skip = ['session_id', 'website'];
    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? 'null') as Record<string, string[]> | null;
      if (saved) {
        for (const el of form.querySelectorAll<HTMLInputElement>('input[name], textarea[name]')) {
          const values = saved[el.name];
          if (!values || skip.includes(el.name)) continue;
          if (el.type === 'checkbox') el.checked = values.includes(el.value);
          else el.value = values[0] ?? '';
        }
      }
    } catch {
      localStorage.removeItem(key);
    }
    form.addEventListener('submit', () => {
      const fd = new FormData(form);
      const data: Record<string, string[]> = {};
      for (const name of new Set(fd.keys())) {
        if (!skip.includes(name)) data[name] = fd.getAll(name).map(String);
      }
      // Ohne angehakte Klassen fehlt der Schlüssel – leere Liste speichern, sonst kommen Vorauswahlen zurück.
      data.klassen ??= [];
      try {
        localStorage.setItem(key, JSON.stringify(data));
      } catch {
        // Speicher voll oder gesperrt: Absenden geht trotzdem.
      }
    });
  }
</script>
