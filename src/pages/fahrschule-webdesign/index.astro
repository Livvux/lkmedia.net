---
import Base from '../../layouts/Base.astro';
import FeatureSplit from '../../components/home/FeatureSplit.astro';
import LighthousePanel from '../../components/home/LighthousePanel.astro';
import ProcessSteps from '../../components/home/ProcessSteps.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { breadcrumbs } from '../../lib/schema';
import { routeFor } from '../../lib/i18n';
import { FAHRSCHULWEB } from '../../lib/fahrschulweb';

const url = 'https://lkmedia.net/fahrschule-webdesign';
const contact = routeFor('contact', 'de');
const caseStudy = '/case-study-patricks-fahrschule-local-seo';
const checkoutHref = FAHRSCHULWEB.paymentLink || `${contact}#termin`;
const checkoutLabel = FAHRSCHULWEB.paymentLink ? 'Jetzt starten' : 'Gespräch vereinbaren';

const seo = {
  title: 'Fahrschule Webdesign – Websites, die Fahrschüler bringen',
  description:
    `Website für Fahrschulen zum Festpreis: Online-Anmeldung, Standortseiten, Local SEO. ${FAHRSCHULWEB.setupPrice} + ${FAHRSCHULWEB.monthlyPrice}/Monat – direkt online bestellen.`,
  canonical: '/fahrschule-webdesign',
  lang: 'de' as const,
  alternateUrls: { de: url },
};

const stats = [
  { value: '#1', label: 'in 5 Städten gleichzeitig' },
  { value: '671', label: 'Klicks auf den Namen in 90 Tagen' },
  { value: '2', label: 'Sprachen, eine Zielgruppe mehr' },
];

const pains = [
  {
    n: '01',
    title: 'Seite 2 bei Google',
    body: 'Wer „Fahrschule + Ort“ sucht, ruft die ersten drei Treffer an. Steht Ihre Fahrschule nicht dort, existiert sie für diese Fahrschüler nicht.',
  },
  {
    n: '02',
    title: 'Gebaut für Desktop, besucht am Handy',
    body: 'Ihre Zielgruppe ist 17 und hat kein Notebook. Lädt die Seite zäh oder ist das Formular fummelig, ist der Tab zu – und die Konkurrenz einen Wisch entfernt.',
  },
  {
    n: '03',
    title: 'Anfragen per Telefon-Pingpong',
    body: 'Rückrufe, verpasste Anrufe, fehlende Unterlagen. Ohne strukturierte Online-Anmeldung kostet jeder neue Fahrschüler Sie unnötig Zeit im Büro.',
  },
];

const features = [
  {
    title: 'Online-Anmeldung',
    body: 'Klasse wählen, Standort wählen, Daten eingeben – fertig. Die Anfrage landet vollständig in Ihrem Postfach, ohne Rückfragen.',
  },
  {
    title: 'Eine Seite pro Standort',
    body: 'Eigene, inhaltlich eigenständige Seiten für jeden Ort, den Sie abdecken. Genau so rankt Patricks Fahrschule in fünf Städten auf Platz 1.',
  },
  {
    title: 'Führerscheinklassen klar erklärt',
    body: 'B, BE, B196, A1, A2, A, AM, Mofa – jede Klasse mit Ablauf, Voraussetzungen und Kosten. Beantwortet Fragen, bevor das Telefon klingelt.',
  },
  {
    title: 'Transparente Preise',
    body: 'Grundbetrag, Fahrstunden, Sonderfahrten, Prüfungsgebühren: übersichtlich dargestellt. Das schafft Vertrauen und filtert unpassende Anfragen.',
  },
  {
    title: 'Google-Unternehmensprofil',
    body: 'Einrichtung und Optimierung für jeden Standort – damit Sie im Maps-Pack erscheinen, wo die meisten Klicks passieren.',
  },
  {
    title: 'Theorie- & Ferienkurse',
    body: 'Termine für Theorieunterricht, Intensiv- und Ferienkurse immer aktuell. Neue Termine schicken Sie über Ihren Änderungs-Link – wir pflegen sie ein.',
  },
  {
    title: 'Mehrsprachig',
    body: 'Fahrschüler, die auf Englisch, Rumänisch, Türkisch oder Arabisch suchen, finden fast nie ein Angebot. Ihre Website ist auf Deutsch; diese Sprachen ergänzen wir als Extra nach Absprache.',
  },
  {
    title: 'Bewertungen sichtbar',
    body: 'Echte Google-Bewertungen prominent eingebunden – denn Eltern zahlen mit und lesen genau, was andere über Sie sagen.',
  },
  {
    title: 'DSGVO ohne Banner-Hölle',
    body: 'Datensparsame Analytics, lokal eingebundene Schriften, sauberes Impressum. Rechtssicher, ohne Ihre Besucher mit Pop-ups zu vergraulen.',
  },
];

const serp = [
  {
    domain: 'patricks-fahrschule.de',
    path: '› fahrschule-durmersheim',
    title: 'Fahrschule Durmersheim – Führerschein B, A & BE | Patricks Fahrschule',
    desc: 'Deine Fahrschule in Durmersheim: Theorie, Fahrstunden und Prüfung aus einer Hand. Jetzt online anmelden …',
    primary: true,
  },
  {
    domain: 'fahrschule-beispiel.de',
    path: '',
    title: 'Fahrschule Beispiel – Startseite',
    desc: 'Herzlich willkommen auf unserer Homepage. Hier finden Sie Informationen über unsere …',
    primary: false,
  },
];

const process = {
  title: 'Online bestellen. In wenigen Tagen Vorschau.',
  sub: 'Kein Angebots-Pingpong: Sie bestellen das Paket direkt, tragen Ihre Daten ein, wir bauen den Rest.',
  steps: [
    { n: '01', title: 'Paket bestellen', body: `Sichere Zahlung über Stripe: ${FAHRSCHULWEB.initialPrice} für Einrichtung und ersten Monat. Rechnung kommt automatisch.` },
    { n: '02', title: 'Daten eintragen', body: 'Klassen, Preise, Standorte, Theoriezeiten, Team – in ca. 15 Minuten. Logo und Fotos laden Sie direkt im Formular hoch.' },
    { n: '03', title: 'Vorschau prüfen', body: `${FAHRSCHULWEB.deliveryPromise} Eine Korrekturschleife ist enthalten.` },
    { n: '04', title: 'Online & aktuell', body: 'Wir schalten Ihre Domain auf und richten Google-Profile ein. Änderungen stellen Sie jederzeit über Ihren Änderungs-Link ein und sehen dort auch den Status.' },
  ],
};

const included = [
  'Website mit Ihren Inhalten, Ihrem Logo und Ihrer Farbe',
  'Seiten für Führerscheinklassen, Preise, Theorie & Kurse, Team & Fahrzeuge, Kontakt',
  `Eigene Standortseite für bis zu ${FAHRSCHULWEB.includedLocations} Standorte`,
  'Online-Anmeldung per E-Mail oder Link zu Ihrer Fahrschulsoftware',
  'Google-Unternehmensprofil je Standort eingerichtet bzw. optimiert',
  'Impressum und Datenschutzerklärung (als Entwurf zur Freigabe)',
  'Eine Korrekturschleife nach der Vorschau',
  'Hosting in der EU, SSL, Sicherungen und technische Updates',
  'Persönlicher Änderungs-Link mit Status und Bilder-Upload, ohne Passwort: bis zu 30 Minuten Änderungen pro Monat',
  'Einrichtung auf Ihrer Domain; Domainkosten extra',
];

const preparation = [
  { title: 'Fahrschule und Kontakt', body: 'Name, Telefon, E-Mail für Anmeldungen, Adressen und Bürozeiten aller Standorte. Falls vorhanden: Anmelde-Link Ihrer Fahrschulsoftware.' },
  { title: 'Klassen, Preise, Kurse', body: 'Welche Führerscheinklassen Sie ausbilden, Ihre Preise je Klasse, Theoriezeiten sowie Ferien- und Intensivkurse mit Terminen.' },
  { title: 'Team, Fahrzeuge, Fotos', body: 'Fahrlehrerinnen und Fahrlehrer, Ihre Fahrzeuge, Logo und Fotos, für die Sie die Nutzungsrechte besitzen. Bilder laden Sie nach dem Kauf direkt im Formular hoch.' },
  { title: 'Impressum', body: 'Inhaber oder Geschäftsführung, Rechtsform, die Behörde, die Ihre Fahrschulerlaubnis erteilt hat, und gegebenenfalls Handelsregister und USt-IdNr.' },
];

const faqs = [
  {
    q: 'Was kostet eine Website für eine Fahrschule?',
    a: `${FAHRSCHULWEB.setupPrice} für die Einrichtung und ${FAHRSCHULWEB.monthlyPrice} pro Monat für Hosting, Updates und Änderungen. Bei Bestellung werden ${FAHRSCHULWEB.initialPrice} fällig. Mindestlaufzeit ${FAHRSCHULWEB.minimumTermMonths} Monate ab Bestellung; insgesamt ${FAHRSCHULWEB.minimumTotalPrice}, jeweils inkl. USt. und zuzüglich Domainkosten. Mehr als ${FAHRSCHULWEB.includedLocations} Standorte besprechen wir vor der Bestellung. Die Website ist auf Deutsch; weitere Sprachen sind zusätzlich möglich, gegen Aufpreis nach Absprache.`,
  },
  {
    q: 'Wie schnell rankt meine Fahrschule bei Google?',
    a: 'Für den eigenen Fahrschulnamen meist innerhalb weniger Tage nach dem Launch. Für „Fahrschule + Ort“ hängt es von Wettbewerb und Ausgangslage ab – in kleineren Städten sind erste Top-Platzierungen oft nach wenigen Wochen bis Monaten möglich. Ein sauber gepflegtes Google-Unternehmensprofil beschleunigt das deutlich.',
  },
  {
    q: 'Wir haben mehrere Filialen. Brauchen wir mehrere Websites?',
    a: 'Nein. Eine Website mit einer eigenständigen Unterseite pro Standort ist die stärkere Lösung: Die Domain bündelt die Autorität, und jede Standortseite rankt für ihren eigenen Ort. Dazu kommt ein eigenes Google-Unternehmensprofil pro Filiale.',
  },
  {
    q: 'Kann ich Kurstermine, Preise und Angaben später ändern?',
    a: 'Ja, alles. Nach der Bestellung erhalten Sie einen persönlichen Änderungs-Link. Darüber sehen Sie den Status aller Aufträge, stellen neue Änderungen ein, laden Bilder hoch und beantworten Rückfragen – ohne Passwort. Wir melden uns in der Regel innerhalb von 2 Werktagen. Bis zu 30 Minuten Änderungen pro Monat sind enthalten; größeren Aufwand stimmen wir vorher mit Ihnen ab. Link verloren? Unter lkmedia.net/aenderung/link lassen Sie ihn sich per E-Mail erneut zusenden.',
  },
  {
    q: 'Funktioniert die Online-Anmeldung mit meiner Fahrschulsoftware?',
    a: 'Die Anmeldung kommt standardmäßig als strukturierte E-Mail mit allen Angaben bei Ihnen an. Nutzen Sie Software mit Online-Schnittstelle oder Anmelde-Link, binden wir diese direkt ein.',
  },
  {
    q: 'Lohnt sich eine neue Website, wenn wir sowieso ausgebucht sind?',
    a: 'Gerade dann. Eine gute Website sorgt dafür, dass die richtigen Fahrschüler kommen: die Klassen, die Sie füllen wollen, aus den Orten, die Sie bedienen – und mit vollständigen Unterlagen. Außerdem gewinnen Sie Fahrlehrer: Viele Bewerber prüfen Ihre Website, bevor sie sich melden.',
  },
];

const cta = {
  lines: ['Mehr Fahrschüler.', 'Weniger Telefon-Pingpong.'] as [string, string],
  sub: 'Lassen Sie uns in 15 Minuten prüfen, wo Ihre Fahrschule bei Google steht – und was nötig ist, um nach oben zu kommen.',
  primary: { label: 'Paket ansehen', href: '#preis' },
  secondary: { label: '15-min-Call buchen', href: `${contact}#termin` },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Fahrschule Webdesign',
  serviceType: 'Webdesign und Local SEO für Fahrschulen',
  description: seo.description,
  provider: { '@type': 'Organization', name: 'lkmedia', url: 'https://lkmedia.net' },
  areaServed: { '@type': 'Country', name: 'Deutschland' },
  audience: { '@type': 'BusinessAudience', audienceType: 'Fahrschulen' },
  url,
  offers: {
    '@type': 'Offer',
    name: 'Einrichtung und erster Betriebsmonat',
    description: `Erste Zahlung ${FAHRSCHULWEB.initialPrice}, danach ${FAHRSCHULWEB.monthlyPrice} pro Monat. ${FAHRSCHULWEB.minimumTermMonths} Monate Mindestlaufzeit; insgesamt ${FAHRSCHULWEB.minimumTotalPrice} inkl. USt., zuzüglich Domainkosten.`,
    price: FAHRSCHULWEB.initialAmount.toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url,
  },
};
const crumbs = breadcrumbs([
  { name: 'Start', url: 'https://lkmedia.net/' },
  { name: 'Leistungen', url: 'https://lkmedia.net/leistungen' },
  { name: 'Fahrschule Webdesign', url },
]);
---
<Base seo={seo} jsonLd={[serviceSchema, crumbs]}>
  <!-- Hero -->
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="eyebrow" data-rise>Fahrschule Webdesign</div>
      <h1 class="hero-title display">
        <span data-rise style="--d:60ms">Webdesign für Fahrschulen,</span>
        <span data-rise style="--d:150ms" class="hero-muted">das Fahrschüler bringt.</span>
      </h1>
      <p class="hero-sub" data-rise style="--d:260ms">
        Schnelle, mobile Websites mit Online-Anmeldung und eigener Seite für jeden Standort.
        Damit Ihre Fahrschule bei „Fahrschule + Ort“ ganz oben steht – und nicht die Konkurrenz.
      </p>
      <div class="hero-actions" data-rise style="--d:360ms">
        <a href="#preis" class="btn btn-primary btn-lg">
          Paket ansehen · {FAHRSCHULWEB.setupPrice}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href={`${contact}#termin`} class="mono-link">Erst sprechen? 15-min-Call</a>
        <a href={caseStudy} class="mono-link"><span class="dot" aria-hidden="true"></span>Case: #1 in 5 Städten</a>
      </div>

      <dl class="stats" data-rise style="--d:460ms">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-value">{s.value}</dd>
          </div>
        ))}
      </dl>

      <div class="hero-preview" data-rise style="--d:560ms">
        <figure class="browser">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dots"><i></i><i></i><i></i></span>
            <span class="browser-url">patricks-fahrschule.de</span>
            <span class="browser-dots invisible"><i></i><i></i><i></i></span>
          </div>
          <img
            src="/landing/shots/patricks-fahrschule-1440.webp"
            srcset="/landing/shots/patricks-fahrschule-1440.webp 1440w, /landing/shots/patricks-fahrschule-2880.webp 2880w"
            sizes="(max-width: 1240px) calc(100vw - 40px), 1080px"
            width="1440"
            height="900"
            alt="Fahrschul-Website von Patricks Fahrschule, gestaltet von lkmedia"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Pains -->
  <section class="block">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <div class="eyebrow">Das Problem</div>
        <h2 class="section-title mt-4">Warum die meisten Fahrschul-Websites keine Fahrschüler bringen.</h2>
      </div>
      <ul class="pain-grid">
        {pains.map((p, i) => (
          <li class="card pain" data-reveal style={`--d:${i * 80}ms`}>
            <span class="pain-n">{p.n}</span>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Local SEO -->
  <FeatureSplit
    eyebrow="Local SEO"
    title="Platz 1 für „Fahrschule + Ihr Ort“."
    sub="Fahrschüler suchen lokal. Darum bekommt jeder Ihrer Standorte eine eigene, eigenständige Seite, ein eigenes Google-Unternehmensprofil und strukturierte Daten, die Google und KI-Assistenten verstehen."
    points={[
      'Eigene Standortseite pro Ort, keine Copy-Paste-Texte',
      'Google-Unternehmensprofil für jede Filiale eingerichtet',
      'Schema-Markup für Fahrschule, Kurse und Bewertungen',
    ]}
  >
    <div class="serp card" aria-hidden="true">
      <div class="serp-bar">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <span>fahrschule durmersheim</span>
      </div>
      <ol class="serp-list">
        {serp.map((r, i) => (
          <li class={`serp-item ${r.primary ? 'is-primary' : ''}`}>
            <span class="serp-pos">#{i + 1}</span>
            <div class="min-w-0">
              <div class="serp-url">{r.domain} <span class="text-[var(--fg-faint)]">{r.path}</span></div>
              <div class="serp-title">{r.title}</div>
              <p class="serp-desc">{r.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </FeatureSplit>

  <!-- Features -->
  <section class="block">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <div class="eyebrow">Leistungsumfang</div>
        <h2 class="section-title mt-4">Was eine Fahrschul-Website heute können muss.</h2>
        <p class="section-sub mt-5">Kein Baukasten-Template mit Stockfoto vom Lenkrad. Sondern eine Website, die die Fragen Ihrer Fahrschüler beantwortet und Anmeldungen einsammelt.</p>
      </div>
      <ul class="feature-grid">
        {features.map((f, i) => (
          <li class="feature" data-reveal style={`--d:${(i % 3) * 70}ms`}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <h3 class="card-title">{f.title}</h3>
            <p class="card-body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Speed -->
  <FeatureSplit
    eyebrow="Mobile Performance"
    title="Schneller da als der Daumen weg ist."
    sub="Fast alle Ihre Besucher kommen vom Smartphone – oft im Bus, mit wackeligem Netz. Wir bauen statisch und schlank, ohne WordPress-Plugins. Das mögen Fahrschüler und Google gleichermaßen."
    points={[
      'Core Web Vitals im grünen Bereich als Abnahmekriterium',
      'Anmeldeformular in unter einer Minute ausgefüllt',
      'Keine Plugin-Updates, keine Sicherheitslücken',
    ]}
    reverse
  >
    <LighthousePanel
      scores={[
        { label: 'Performance', value: 100 },
        { label: 'Barrierefreiheit', value: 100 },
        { label: 'Best Practices', value: 100 },
        { label: 'SEO', value: 100 },
      ]}
      vitals={[
        { label: 'LCP', value: '0.8 s' },
        { label: 'INP', value: '52 ms' },
        { label: 'CLS', value: '0.00' },
      ]}
      url="fahrschul-website"
    />
  </FeatureSplit>

  <!-- Case -->
  <section class="block">
    <div class="wrap">
      <a href={caseStudy} class="case card" data-reveal>
        <div class="case-img">
          <img src="/cases/patricks-fahrschule.webp" alt="Website von Patricks Fahrschule im Raum Rastatt" loading="lazy" decoding="async" />
        </div>
        <div class="case-copy">
          <div class="eyebrow">Case Study · Patricks Fahrschule</div>
          <h2 class="case-title">Position 1 in Rastatt, Durmersheim, Sinzheim, Iffezheim und Kuppenheim.</h2>
          <p class="card-body mt-4">
            Fünf Standorte, fünf eigene Seiten, fünf Google-Profile – plus rumänischsprachige Inhalte
            für eine Zielgruppe, die keine andere Fahrschule in der Region anspricht.
          </p>
          <blockquote class="quote">
            „Klasse Typ, fachlich Top! Wünsche, Änderungen und Fragen werden immer sofort bearbeitet und beantwortet.“
            <footer>Patrick Janiak, Inhaber</footer>
          </blockquote>
          <span class="mono-link mt-6">Ganze Case Study lesen →</span>
        </div>
      </a>
    </div>
  </section>

  <ProcessSteps process={process} />

  <!-- Vorbereitung -->
  <section id="vorbereitung" aria-labelledby="vorbereitung-title" class="block scroll-mt-20">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <div class="eyebrow">Checkliste</div>
        <h2 id="vorbereitung-title" class="section-title mt-4">Das brauchen wir von Ihnen.</h2>
        <p class="section-sub mt-5">Nach dem Kauf tragen Sie alles in ein kurzes Formular ein. Der Zeitraum bis zur Vorschau beginnt, sobald alle Inhalte vorliegen.</p>
      </div>
      <ul class="pain-grid prep-grid">
        {preparation.map((p, i) => (
          <li class="card pain" data-reveal style={`--d:${i * 70}ms`}>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Preis -->
  <section id="preis" aria-labelledby="preis-title" class="block scroll-mt-20">
    <div class="wrap price-grid">
      <div data-reveal>
        <div class="eyebrow">Fahrschul-Paket</div>
        <h2 id="preis-title" class="section-title mt-4">Ein Paket. Ein Preis. Direkt online bestellen.</h2>
        <p class="section-sub mt-5">
          Sie bestellen online, tragen Ihre Daten ein, wir bauen und betreiben Ihre Website. Ändern können Sie danach
          alles – über Ihren persönlichen Änderungs-Link.
        </p>
        <p class="card-body mt-5">
          Nicht enthalten: Domainkosten, Fotografie, Texterstellung über Ihre Angaben hinaus und Rechtsberatung.
          Mehr als {FAHRSCHULWEB.includedLocations} Standorte, weitere Sprachen oder ein Umzug Ihrer bestehenden Website?
          {' '}<a href={`${contact}#termin`} class="underline underline-offset-4">Klären wir vorab im Gespräch.</a>
        </p>
        <a href="#vorbereitung" class="mono-link mt-6">Checkliste für Ihre Bestellung →</a>
      </div>
      <div class="card price" data-reveal style="--d:80ms">
        <div class="stat-label">FAHRSCHUL-KOMPLETTPAKET</div>
        <div class="price-main"><span>{FAHRSCHULWEB.setupPrice}</span> <small>einmalig</small></div>
        <div class="price-monthly"><strong>+ {FAHRSCHULWEB.monthlyPrice}</strong> <small>/ Monat</small></div>
        <p class="card-body">inkl. USt. · {FAHRSCHULWEB.minimumTermMonths} Monate Mindestlaufzeit ab Bestellung</p>
        <div class="price-terms">
          <p><strong>Bei Bestellung: {FAHRSCHULWEB.initialPrice}</strong> für Einrichtung und ersten Monat.</p>
          <p>Danach {FAHRSCHULWEB.monthlyPrice} monatlich im Voraus. Einrichtung + {FAHRSCHULWEB.minimumTermMonths} Monate: <strong>{FAHRSCHULWEB.minimumTotalPrice}</strong> inkl. USt., zzgl. Domain.</p>
          <p>Danach monatlich kündbar, Frist ein Monat zum Monatsende.</p>
        </div>
        <ul class="price-list">
          {included.map((i) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{i}</span>
            </li>
          ))}
        </ul>
