---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { breadcrumbs } from '../lib/schema';

const seo = {
  title: 'SEO Rastatt: Analyse und Umsetzung für Ihre Website',
  description: 'SEO für bestehende Websites aus Rastatt und Umgebung. Lucas prüft Suchdaten, Inhalte und Technik und setzt vereinbarte Verbesserungen direkt um.',
  canonical: '/seo-rastatt',
  lang: 'de' as const,
};

const services = [
  ['Suchdaten und Technik', 'Welche Leistungen werden gesucht? Welche Seiten erscheinen dafür? Ich prüfe verfügbare Search-Console-Daten, Indexierung, Weiterleitungen und technische Hindernisse.'],
  ['Leistungsseiten und Kontaktwege', 'Ich prüfe, ob Ihr Angebot, Ihr Einzugsgebiet und der nächste Schritt verständlich sind. Daraus entstehen Vorschläge für Texte, Seitentitel, interne Links und den Anfrageweg.'],
  ['Lokale Sichtbarkeit', 'Bei lokalem Geschäft beziehe ich Ihr Google-Unternehmensprofil und die veröffentlichten Unternehmensangaben ein. Profiländerungen und Zugänge stimmen wir vorab ab.'],
];
const steps = [
  ['Kostenloses Erstgespräch', 'In 15 Minuten besprechen wir Ihre Website, die wichtigste Leistung und Ihr Einzugsgebiet. Wir klären, ob eine Analyse zu Ihrem Anliegen passt.'],
  ['Bezahlte Analyse zum Festpreis', 'Vor Beginn vereinbaren wir die untersuchte Website, das Einzugsgebiet und die relevanten Leistungsseiten. Sie erhalten eine priorisierte Liste mit Befunden und konkreten nächsten Schritten.'],
  ['Vereinbarte Verbesserungen umsetzen', 'Für die Umsetzung erhalten Sie ein separates Angebot mit Leistungen, Kosten und Abnahme. Vorher prüfen wir Zugänge, technische Änderungsmöglichkeiten und die Abstimmung mit Ihrem bisherigen Anbieter.'],
  ['Entwicklung gemeinsam auswerten', 'Wir vergleichen die verfügbaren Suchdaten und tatsächlich eingegangenen Anfragen. Eine weitere Betreuung ist optional und bekommt einen eigenen Aufgaben- und Kostenrahmen.'],
];
const faqs = [
  { q: 'Optimieren Sie Websites anderer Anbieter?', a: 'Ja. Vor einem Auftrag prüfen wir das verwendete System, verfügbare Zugänge und die möglichen Änderungen. Falls Ihr bisheriger Anbieter eingebunden werden muss, stimmen wir die Zuständigkeiten ab.' },
  { q: 'Brauche ich für SEO eine neue Website?', a: 'Das klären wir anhand Ihrer bestehenden Website. Wenn Inhalte und Technik gezielt verbessert werden können, arbeiten wir am vorhandenen Auftritt. Falls Änderungen technisch nicht möglich sind, besprechen wir die Alternativen vor einer Beauftragung.' },
  { q: 'Was kostet die Zusammenarbeit?', a: 'Das 15-Minuten-Erstgespräch ist kostenlos. Für die Analyse vereinbaren wir einen Festpreis passend zu Website und Umfang. Umsetzung und weitere Betreuung werden separat angeboten. Die auf der Kontaktseite genannte Untergrenze für individuelle Website-Projekte gilt nicht für SEO-Aufträge.' },
  { q: 'Welche Informationen brauchen Sie für den Start?', a: 'Für das Erstgespräch reichen Ihre Website-Adresse, die wichtigste Leistung, Ihr Einzugsgebiet und das aktuelle Problem. Zugang zur Search Console und zum Website-System klären wir bei Bedarf persönlich. Bitte senden Sie keine Passwörter über das Kontaktformular.' },
  { q: 'Wann sehe ich Ergebnisse?', a: 'Das hängt von Ausgangslage, Wettbewerb und den umgesetzten Änderungen ab. Wir vereinbaren einen Auswertungstermin und betrachten Suchanfragen, betroffene Seiten und bearbeitete Anfragen. Eine bestimmte Google-Position, Zahl von Anfragen oder Umsatzhöhe kann ich nicht zusagen.' },
];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Suchmaschinenoptimierung in Rastatt',
  serviceType: 'SEO-Analyse und Optimierung bestehender Websites',
  provider: { '@id': 'https://lkmedia.net/#organization' },
  areaServed: ['Rastatt', 'Baden-Baden', 'Durmersheim', 'Karlsruhe'],
  url: 'https://lkmedia.net/seo-rastatt',
};
---
<Base seo={seo} jsonLd={[serviceSchema, breadcrumbs([
  { name: 'Startseite', url: 'https://lkmedia.net/' },
  { name: 'SEO in Rastatt', url: 'https://lkmedia.net/seo-rastatt' },
])]}>
  <div class="seo-page">
    <section class="wrap seo-hero" aria-labelledby="seo-heading">
      <p class="eyebrow">Rastatt & Umgebung · Direkt mit Lucas</p>
      <h1 id="seo-heading" class="display">Suchmaschinenoptimierung für Unternehmen in Rastatt.</h1>
      <p class="intro">Ihre Website bekommt kaum passende Besucher oder Anfragen? Ich prüfe Suchdaten, Inhalte und technische Hindernisse und setze die vereinbarten Verbesserungen direkt um.</p>
      <p class="detail">Auch für bestehende Websites anderer Anbieter. Analyse, Umsetzung und weitere Betreuung werden passend zu Ihrem Bedarf vereinbart.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/kontakt#termin">SEO-Erstgespräch vereinbaren</a>
        <a class="btn btn-ghost" href="#anfrage">Website und Anliegen senden</a>
      </div>
      <p class="note">15 Minuten kostenlos kennenlernen. Analyse und Umsetzung werden anschließend separat angeboten.</p>
    </section>

    <section class="wrap section" aria-labelledby="scope-heading">
      <p class="eyebrow">Was wir prüfen</p>
      <h2 id="scope-heading">Vom Suchergebnis bis zur Anfrage.</h2>
      <div class="columns">
        {services.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </div>
      <p class="detail">Das Angebot richtet sich an Betriebe und Dienstleister in Rastatt, Baden-Baden, Durmersheim und Karlsruhe. Welche Leistungen und Orte für Ihr Unternehmen relevant sind, klären wir im Gespräch.</p>
    </section>

    <section class="wrap section proof" aria-labelledby="proof-heading">
      <div>
        <p class="eyebrow">Kundenprojekt · CLEO Coaching</p>
        <h2 id="proof-heading">An einer bestehenden Website weiterarbeiten.</h2>
        <p>Für CLEO Coaching habe ich die vorhandene Website analysiert und Struktur, Inhalte, Metadaten und interne Verlinkung überarbeitet. Dazu kam eine eigene Landingpage für Workshops.</p>
        <a class="text-link" href="/cases/cleo-coaching">Projekt und vollständige Kundenstimme ansehen →</a>
      </div>
      <figure>
        <blockquote>„Er hat meine Homepage cleo-coaching so verbessert, dass sie besser gelistet wurde und hat das Feintuning gemacht. Unsere Landing Page für die Workshops hat er erstellt.“</blockquote>
        <figcaption>Beate Caspers · CLEO Coaching</figcaption>
        <p class="note">Die Kundenstimme beschreibt die Erfahrung mit diesem Projekt. Eine datierte quantitative Auswertung liegt hier nicht vor.</p>
      </figure>
    </section>

    <section class="wrap section" aria-labelledby="process-heading">
      <p class="eyebrow">Leistungen und Kosten vorab klären</p>
      <h2 id="process-heading">So läuft die Zusammenarbeit.</h2>
      <ol class="steps">
        {steps.map(([title, body], index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}
      </ol>
    </section>

    <section id="anfrage" class="wrap section enquiry" aria-labelledby="enquiry-heading">
      <div>
        <p class="eyebrow">Ihre bestehende Website</p>
        <h2 id="enquiry-heading">Wo bleiben die Anfragen aus?</h2>
        <p>Schildern Sie kurz Ihr Anliegen. Ich schaue mir Ihre Angaben an und kläre mit Ihnen den passenden nächsten Schritt.</p>
        <p>Hilfreich sind die Website-Adresse, Ihre wichtigste Leistung und die Orte, aus denen Sie Kunden erreichen möchten.</p>
        <p class="note">Bitte senden Sie keine Passwörter oder Zugangsschlüssel. Die Anfrage beauftragt noch keine kostenpflichtige Analyse.</p>
        <a class="text-link" href="/kontakt#termin">Lieber sprechen? Kostenloses Erstgespräch buchen →</a>
      </div>
      <ContactForm lang="de" source="/seo-rastatt" messageHelp="Bitte nennen Sie Ihre Website-Adresse, Ihre wichtigste Leistung, Ihr Einzugsgebiet und die gewünschte Verbesserung." />
    </section>

    <div class="wrap faq-heading"><h2>Fragen vor dem Start.</h2></div>
    <FaqBlock items={faqs} />
  </div>
</Base>

<style>
  .seo-page { padding-bottom: 32px; }
  .seo-hero { padding-block: 72px 80px; }
  h1 { max-width: 1000px; margin-top: 24px; font-size: clamp(38px, 5.2vw, 68px); line-height: 1.08; hyphens: auto; overflow-wrap: anywhere; }
  .intro { max-width: 760px; margin-top: 28px; font-size: clamp(19px, 2vw, 23px); line-height: 1.6; color: var(--fg-muted); }
  .detail { max-width: 850px; margin-top: 24px; line-height: 1.75; color: var(--fg-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .note { margin-top: 16px; font-size: 13px; line-height: 1.7; color: var(--fg-muted); }
  .section { padding-block: 64px; border-top: 1px solid var(--border); }
  h2 { margin-top: 14px; max-width: 840px; font-size: clamp(29px, 3.7vw, 44px); font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; }
  h3 { font-size: 20px; font-weight: 600; line-height: 1.4; }
  .columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; margin-top: 40px; }
  article p, .proof p, .steps p, .enquiry p { margin-top: 14px; line-height: 1.75; color: var(--fg-muted); }
  .proof, .enquiry { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: start; }
  .text-link { display: inline-block; margin-top: 24px; text-decoration: underline; text-underline-offset: 5px; line-height: 1.6; }
  figure { padding: 28px; background: var(--bg-card); border: 1px solid var(--border-strong); border-radius: var(--radius); }
  blockquote { font-size: clamp(20px, 2vw, 25px); line-height: 1.6; }
  figcaption { margin-top: 24px; font-weight: 500; }
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 64px; margin-top: 40px; }
  .steps li { display: flex; gap: 20px; }
  .step-number { color: var(--accent); font-family: var(--font-mono); font-size: 15px; padding-top: 4px; }
  #anfrage { scroll-margin-top: 80px; }
  .faq-heading { padding-top: 40px; }
  @media (max-width: 760px) {
    .seo-hero { padding-block: 48px 56px; }
    .section { padding-block: 48px; }
    .columns, .proof, .enquiry, .steps { grid-template-columns: 1fr; gap: 32px; }
    .actions { align-items: stretch; flex-direction: column; }
    figure { padding: 22px; }
  }
</style>
